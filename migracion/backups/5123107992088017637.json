{
 "id": "5123107992088017637",
 "blogId": "6400647277621096048",
 "url": "https://supermercadoaliazon.blogspot.com/2026/06/soy-oaxaca-es-una-plataforma-de.html",
 "path": "/2026/06/soy-oaxaca-es-una-plataforma-de.html",
 "titulo": "",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://encrypted-tbn2.gstatic.com/images?q=tbn:ANd9GcTXqLFT31wIVF8CU7gXbolInyjkRRmCcrk_T5IOu1A9Oy1QRA\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" height=\"320\" src=\"https://encrypted-tbn2.gstatic.com/images?q=tbn:ANd9GcTXqLFT31wIVF8CU7gXbolInyjkRRmCcrk_T5IOu1A9Oy1QRA\" /></a></div>\n\n<div style=\"text-align: justify;\">Soy Oaxaca es una plataforma de comercio electrónico dedicada a promover y comercializar productos auténticamente oaxaqueños, conectando a artesanos y pequeños productores con mercados nacionales e internacionales. Su propuesta reúne gastronomía, textiles, artesanías y productos tradicionales elaborados en Oaxaca, bajo principios de comercio justo, sostenibilidad y apoyo a la economía local. Con más de dos décadas de experiencia en comercio electrónico, la marca se ha consolidado como un escaparate de la riqueza cultural, artística y gastronómica del estado, contribuyendo a preservar sus tradiciones y generar oportunidades para las comunidades productoras.</div>\n\n<!--more-->\n\n<div id=\"sf-catalog-widget\">\n  <div id=\"sf-grid\" style=\"color:#333;display:grid;font-family:Segoe UI,Roboto,Arial,sans-serif;gap:20px;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));margin:auto;max-width:1200px;\">\n    <p style=\"color:#999;grid-column:1/-1;text-align:center;\">Cargando productos...</p>\n  </div>\n  <div id=\"sf-status\" style=\"color:#999;font-size:13px;margin-top:20px;text-align:center;\"></div>\n</div>\n\n<style>\n#sf-catalog-widget .sf-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;display:flex;flex-direction:column;}\n#sf-catalog-widget .sf-card img{width:100%;height:250px;object-fit:contain;border-radius:8px;margin-bottom:10px;background:#fafafa;}\n#sf-catalog-widget .sf-card-title{font-size:13px;font-weight:400;margin-bottom:5px;color:#333;min-height:40px;text-transform:uppercase;letter-spacing:0.5px;}\n#sf-catalog-widget .sf-card-price{font-size:16px;font-weight:500;color:#111;margin-bottom:8px;}\n#sf-catalog-widget .sf-card a{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:11px;font-weight:500;margin-top:auto;letter-spacing:1px;}\n</style>\n\n<script>\n(function(){\n  var proxy = \"https://script.google.com/macros/s/AKfycbwkl7VrPbeHOwenFdecKv9ZtleVY1VZ6ma3XRjV_5dmZX55jA_laH0tm7qBruq5sT2ISQ/exec\";\n  var SITEMAPS = [\"https://www.soyoaxaca.com/sitemap.xml\", \"https://www.soyoaxaca.com/sitemap_blog.xml\"];\n  var FILTRO = \"/productos/\";\n  var TIENDA_URL = \"https://www.soyoaxaca.com\";\n  var BLOG = \"supermercadoaliazon\";\n  var campana = \"soyoaxaca\";\n  var FORM_URL = \"https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=\";\n  var APPS_SCRIPT_CLICS = \"https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec\";\n  var sitemapActual = 0;\n  var productos = [];\n  var mostrados = 0;\n  var cargando = false;\n  var cargandoSitemap = false;\n  function cargarSitemap(indice){\n    if(cargandoSitemap || indice >= SITEMAPS.length) return;\n    cargandoSitemap = true;\n    sitemapActual = indice;\n    fetch(proxy + \"?url=\" + encodeURIComponent(SITEMAPS[indice]))\n      .then(function(res){ return res.text(); })\n      .then(function(xml){\n        var regex = /<loc>\\s*([^<]+?)\\s*<\\/loc>/g;\n        var match;\n        while((match = regex.exec(xml)) !== null){\n          var url = match[1];\n          if(FILTRO && url.indexOf(FILTRO) === -1) continue;\n          productos.push({title:\"Cargando...\",link:url,img:\"\",price:\"\"});\n        }\n        cargandoSitemap = false;\n        document.getElementById(\"sf-status\").textContent = productos.length + \" productos encontrados\";\n        if(indice === 0) cargarLote();\n      })\n      .catch(function(){ cargandoSitemap = false; });\n  }\n  function cargarLote(){\n    if(cargando) return;\n    if(mostrados >= productos.length){\n      if(sitemapActual < SITEMAPS.length - 1){ cargarSitemap(sitemapActual + 1); return; }\n      document.getElementById(\"sf-status\").textContent = \"✅ \" + productos.length + \" productos\";\n      renderizar(); return;\n    }\n    cargando = true;\n    var lote = productos.slice(mostrados, mostrados + 6);\n    var pendientes = lote.length;\n    lote.forEach(function(p){\n      if(p.img){ pendientes--; if(pendientes===0){ mostrados+=lote.length; renderizar(); cargando=false; } return; }\n      fetch(proxy + \"?url=\" + encodeURIComponent(p.link))\n        .then(function(r){ return r.text(); })\n        .then(function(html){\n          var nameMatch = html.match(/property=\"og:title\" content=\"([^\"]+)\"/) || html.match(/content=\"([^\"]+)\" property=\"og:title\"/) || html.match(/\"name\":\"([^\"]+)\"/);\n          var priceMatch = html.match(/twitter:data1\" content=\"([^\"]+)\"/) || html.match(/\"c_salesPriceFormatted\":\"([^\"]+)\"/) || html.match(/\"price\":(\\d+)/);\n          var imgMatch = html.match(/property=\"og:image:secure_url\" content=\"([^\"]+)\"/) || html.match(/property=\"og:image\" content=\"([^\"]+)\"/) || html.match(/content=\"([^\"]+)\" property=\"og:image\"/);\n          if(nameMatch) p.title = nameMatch[1];\n          if(priceMatch) p.price = priceMatch[1];\n          if(imgMatch) p.img = imgMatch[1].replace(\"%7B:size%7D\", \"640w\").replace(\"{:size}\", \"640w\");\n        })\n        .catch(function(){})\n        .finally(function(){\n          pendientes--;\n          if(pendientes === 0){\n            mostrados += lote.length;\n            renderizar();\n            cargando = false;\n            document.getElementById(\"sf-status\").textContent = \"Mostrando \" + mostrados + \" de \" + productos.length;\n          }\n        });\n    });\n  }\n  function renderizar(){\n    var h = \"\";\n    for(var i = 0; i < mostrados; i++){\n      var p = productos[i];\n      var sep = p.link.indexOf(\"?\") !== -1 ? \"&\" : \"?\";\n      var urlUtm = p.link + sep + \"utm_source=\" + BLOG + \"&utm_medium=tarjeta_producto&utm_campaign=catalogo_\" + campana;\n      var urlClic = APPS_SCRIPT_CLICS + \"?producto=\" + encodeURIComponent(p.title) + \"&url=\" + encodeURIComponent(p.link);\n      var urlForm = FORM_URL + encodeURIComponent(p.title);\n      h += '<div class=\"sf-card\">';\n      h += p.img ? '<img src=\"' + p.img + '\" alt=\"' + p.title + '\" loading=\"lazy\">' : '<div style=\"height:250px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;color:#ccc;font-size:20px;\">SIN IMAGEN</div>';\n      h += '<div class=\"sf-card-title\">' + p.title + '</div>';\n      h += p.price ? '<div class=\"sf-card-price\">' + p.price + '</div>' : \"\";\n      h += '<a href=\"' + urlUtm + '\" rel=\"nofollow\" target=\"_blank\" onclick=\"fetch(\\'' + urlClic + '\\',{mode:\\'no-cors\\'})\">Comprar ahora</a>';\n      h += '<a href=\"' + urlForm + '\" target=\"_blank\" style=\"margin-top:6px;display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:11px;font-weight:500;border:1px solid #1a73e8;\">Unirme al Club de Ahorro</a>';\n      h += '</div>';\n    }\n    document.getElementById(\"sf-grid\").innerHTML = h;\n  }\n  window.addEventListener(\"scroll\", function(){\n    var grid = document.getElementById(\"sf-grid\");\n    if(!grid) return;\n    var rect = grid.getBoundingClientRect();\n    if(rect.bottom < window.innerHeight + 500) cargarLote();\n  });\n  if(document.readyState === \"loading\"){\n    document.addEventListener(\"DOMContentLoaded\", function(){ cargarSitemap(0); });\n  } else { cargarSitemap(0); }\n})();\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-09-26T16:18:08.898Z"
}