 "titulo": "NOVEDADES BASYCO JEREZ",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiS_qzyMjAjCrY4-8L3PkkmlxiK0TNcJMIkNezy7HGFqybz0CeGmw6Wo8oFt-FiQTq7Y09eLgA-GZlnsF-c0np9C0yboHVesjkmmaZjmJx-CI4xvbwfxgpStDspJbzJqYwL7TU1yDxmkuVmRLbru2LsnvapeiwXBxGQ4eSEnMzQmxov9yBOpbR8K1-NVeU/s562/vestido-puglia-cazuela.jpg\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" data-original-height=\"562\" data-original-width=\"450\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiS_qzyMjAjCrY4-8L3PkkmlxiK0TNcJMIkNezy7HGFqybz0CeGmw6Wo8oFt-FiQTq7Y09eLgA-GZlnsF-c0np9C0yboHVesjkmmaZjmJx-CI4xvbwfxgpStDspJbzJqYwL7TU1yDxmkuVmRLbru2LsnvapeiwXBxGQ4eSEnMzQmxov9yBOpbR8K1-NVeU/s320/vestido-puglia-cazuela.jpg\" /></a></div><div style=\"text-align: justify;\">La sección de novedades de Basyco reúne las últimas incorporaciones de esta firma de moda femenina nacida en Jerez de la Frontera. La marca destaca por sus diseños frescos, estampados llamativos y prendas versátiles que combinan un estilo bohemio, elegante y juvenil. En esta colección pueden encontrarse vestidos, conjuntos y accesorios pensados tanto para el día a día como para eventos especiales, siempre manteniendo una buena relación calidad-precio y una estética muy reconocible.</div>\n<div id=\"basyco-nuevo-widget\">\n  <div id=\"basyco-nuevo-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 1000px; margin: auto; color: #333;\">\n    <p style=\"grid-column: 1/-1; text-align: center; color: #999;\">Cargando novedades de Basyco Jerez...</p>\n  </div>\n  <div id=\"basyco-nuevo-status\" style=\"text-align: center; margin-top: 20px; color: #999; font-size: 13px; font-family: 'Segoe UI', Roboto, Arial, sans-serif;\"></div>\n</div>\n\n<style>\n  #basyco-nuevo-widget .basy-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; display: flex; flex-direction: column; }\n  #basyco-nuevo-widget .basy-card img { width: 100%; height: 250px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #fafafa; }\n  #basyco-nuevo-widget .basy-card-title { font-size: 13px; font-weight: 600; margin-bottom: 5px; color: #333; min-height: 40px; }\n  #basyco-nuevo-widget .basy-card a { display: block; background: #8B0000; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; margin-top: auto; }\n  #basyco-nuevo-widget .basy-card a:hover { background: #600000; }\n</style>\n\n<script>\n(function() {\n  // Capa 1: NAS (rapido, cacheado). Capa 2: proxy Apps Script antiguo, solo si el NAS no da nada.\n  var NAS_URL = \"https://carmenprofe.synology.me/generador_htmlrobots/generar_o_servir.php\";\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var SITEMAP_URL = \"https://basycojerez.com/1_es_0_sitemap.xml\";\n  var TIENDA_URL = \"https://basycojerez.com/3-nuevo\";\n  var FILTRO = \"/nuevo/\";\n  var productos = [];\n  var vistos = {};\n  var mostrados = 0;\n  var POR_LOTE = 12;\n  var terminado = false;\n\n  function estado(t) { document.getElementById(\"basyco-nuevo-status\").textContent = t; }\n\n  function limpiarTitulo(t, url) {\n    var base = t;\n    if (!base) {\n      var partes = url.replace(/\\/$/, \"\").split(\"/\");\n      base = partes[partes.length - 1].replace(\".html\", \"\").replace(/-/g, \" \").replace(/\\b\\w/g, function(l) { return l.toUpperCase(); });\n    }\n    return String(base).replace(/^\\d+[\\s-]+/, \"\").replace(/[\\s-]+\\d{8,}$/, \"\").replace(/[\\s-]+$/, \"\").trim();\n  }\n\n  function anadir(url, img, titulo) {\n    if (!url || !img || url.indexOf(FILTRO) === -1 || vistos[url]) return;\n    vistos[url] = true;\n    productos.push({ title: limpiarTitulo(titulo, url), link: url, img: img });\n  }\n\n  function fetchConTiempo(url, ms) {\n    var ctrl = new AbortController();\n    var t = setTimeout(function() { ctrl.abort(); }, ms);\n    return fetch(url, { signal: ctrl.signal }).then(function(r) { clearTimeout(t); if (!r.ok) throw new Error(r.status); return r; });\n  }\n\n  function paginaNas(n) {\n    return fetchConTiempo(NAS_URL + \"?url=\" + encodeURIComponent(SITEMAP_URL) + \"&pagina=\" + n, 15000)\n      .then(function(r) { return r.json(); });\n  }\n\n  function cargarDesdeNas() {\n    estado(\"Cargando novedades...\");\n    return paginaNas(1).then(function(d) {\n      var total = d.totalPaginas || 1;\n      (d.productos || []).forEach(function(p) { anadir(p.url, p.imagen, p.titulo); });\n      if (productos.length) cargarLote();\n      var pendientes = [];\n      for (var i = 2; i <= total; i++) pendientes.push(i);\n      // Resto de paginas de 6 en 6, pintando segun llegan\n      function siguienteTanda() {\n        var tanda = pendientes.splice(0, 6);\n        if (!tanda.length) return Promise.resolve();\n        return Promise.all(tanda.map(function(n) {\n          return paginaNas(n).then(function(dd) {\n            (dd.productos || []).forEach(function(p) { anadir(p.url, p.imagen, p.titulo); });\n          }).catch(function() {});\n        })).then(function() {\n          if (mostrados < POR_LOTE) cargarLote(); else actualizarEstado();\n          return siguienteTanda();\n        });\n      }\n      return siguienteTanda();\n    });\n  }\n\n  function cargarDesdeProxy() {\n    estado(\"Cargando novedades...\");\n    return fetchConTiempo(proxy + \"?url=\" + encodeURIComponent(SITEMAP_URL), 30000)\n      .then(function(res) { return res.text(); })\n      .then(function(xml) {\n        var bloques = xml.split(\"<url>\");\n        bloques.shift();\n        bloques.forEach(function(bloque) {\n          var locMatch = bloque.match(/<loc>\\s*<!\\[CDATA\\[\\s*(https:\\/\\/basycojerez\\.com\\/[^\\]]+)\\s*\\]\\]>\\s*<\\/loc>/);\n          var imgMatch = bloque.match(/<image:loc>\\s*<!\\[CDATA\\[\\s*(https:\\/\\/basycojerez\\.com\\/[^\\]]+)\\s*\\]\\]>\\s*<\\/image:loc>/);\n          if (locMatch && imgMatch) anadir(locMatch[1], imgMatch[1], \"\");\n        });\n      });\n  }\n\n  function finalizar() {\n    terminado = true;\n    if (productos.length === 0) {\n      document.getElementById(\"basyco-nuevo-grid\").innerHTML =\n        \"<div style='grid-column: 1/-1; text-align: center; padding: 20px;'>\" +\n        \"<a href='\" + TIENDA_URL + \"' target='_blank' style='display: inline-block; background: #8B0000; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;'>✨ VER NOVEDADES EN LA TIENDA</a></div>\";\n      estado(\"\");\n      return;\n    }\n    if (mostrados === 0) cargarLote();\n    actualizarEstado();\n    renderizar();\n  }\n\n  function actualizarEstado() {\n    if (!productos.length) return;\n    if (mostrados >= productos.length && terminado) estado(\"✅ \" + productos.length + \" productos\");\n    else estado(\"Mostrando \" + mostrados + \" de \" + productos.length + (terminado ? \"\" : \"…\"));\n  }\n\n  function cargarLote() {\n    if (mostrados >= productos.length) { actualizarEstado(); return; }\n    mostrados = Math.min(mostrados + POR_LOTE, productos.length);\n    renderizar();\n    actualizarEstado();\n  }\n\n  // La tienda bloquea sus fotos si la peticion llega con la referencia del blog (antihotlink).\n  // Se piden sin referencia y, si aun asi fallan, a traves de images.weserv.nl.\n  function activarRespaldoImagenes() {\n    var imgs = document.querySelectorAll(\"#basyco-nuevo-grid img\");\n    for (var k = 0; k < imgs.length; k++) {\n      imgs[k].onerror = function() {\n        this.onerror = null;\n        this.src = \"https://images.weserv.nl/?url=\" + encodeURIComponent(this.src.replace(/^https?:\\/\\//, \"\"));\n      };\n    }\n  }\n\n  function renderizar() {\n    var html = \"\";\n    for (var i = 0; i < mostrados; i++) {\n      var p = productos[i];\n      html +=\n        '<div class=\"basy-card\">' +\n        '<img src=\"' + p.img + '\" alt=\"' + p.title + '\" loading=\"lazy\" referrerpolicy=\"no-referrer\">' +\n        '<div class=\"basy-card-title\">' + p.title + '</div>' +\n        '<a href=\"' + p.link + '\" target=\"_blank\">✨ VER PRODUCTO</a>' +\n        '</div>';\n    }\n    if (terminado && mostrados >= productos.length && productos.length > 0) {\n      html +=\n        '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n        '<a href=\"' + TIENDA_URL + '\" target=\"_blank\" style=\"display: inline-block; background: #8B0000; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;\">✨ VER TODAS LAS NOVEDADES</a>' +\n        '</div>';\n    }\n    document.getElementById(\"basyco-nuevo-grid\").innerHTML = html;\n    activarRespaldoImagenes();\n  }\n\n  window.addEventListener(\"scroll\", function() {\n    var grid = document.getElementById(\"basyco-nuevo-grid\");\n    if (!grid || !productos.length) return;\n    var rect = grid.getBoundingClientRect();\n    if (rect.bottom < window.innerHeight + 500 && mostrados < productos.length) cargarLote();\n  });\n\n  function arrancar() {\n    cargarDesdeNas()\n      .catch(function() {})\n      .then(function() { if (!productos.length) return cargarDesdeProxy().catch(function() {}); })\n      .then(finalizar);\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", arrancar);\n  } else {\n    arrancar();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-30T19:09:43.606Z"
}