 "contenido": "<div id=\"onot1-kurtki-widget\">\n\n  <!--PORTADA CHAQUETAS-->\n  <div id=\"onot1-portada\" style=\"font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; margin-bottom: 30px; margin-left: auto; margin-right: auto; max-width: 800px; text-align: center;\">\n    <div style=\"padding: 1em 0px; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi60BjdPlr0Um292jwnw4P8BP9fuwGH2yPkNIjMLoBa-ofu0Pf7-vTqSiryyLsUxhgEBuR2T4kZps5FZfPRviFAhZiDnTBfCWM87kX58ECkrF8QoqLYH_ih-ivr7JcNQDLtrWjru6JLAbVc5dWo5Oa0BRQHqygz-Id4sErv3N2-FrnCBYB4JXxIORajOPY/s600/otva5qjd0hmf6nz9k4h1rvd3ouo3vw9e.jpg\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"600\" data-original-width=\"450\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi60BjdPlr0Um292jwnw4P8BP9fuwGH2yPkNIjMLoBa-ofu0Pf7-vTqSiryyLsUxhgEBuR2T4kZps5FZfPRviFAhZiDnTBfCWM87kX58ECkrF8QoqLYH_ih-ivr7JcNQDLtrWjru6JLAbVc5dWo5Oa0BRQHqygz-Id4sErv3N2-FrnCBYB4JXxIORajOPY/s320/otva5qjd0hmf6nz9k4h1rvd3ouo3vw9e.jpg\" width=\"240\" /></a></div><br />\n    <h2 style=\"color: #111111; font-size: 28px; font-weight: 800; margin-bottom: 15px;\">Chaquetas 0not1</h2>\n    <p style=\"color: #444444; font-size: 16px; line-height: 1.6; margin: 0px auto 20px; max-width: 650px; text-align: justify;\">\n      Chaquetas y abrigos de diseño premium con materiales de alta calidad. 0not1 ofrece modelos modernos y elegantes para hombre, con tallas desde S hasta XL. Descubre su catálogo con envío rápido y precios competitivos.\n    </p>\n    \n    <!--AVISO DE CARGA-->\n    <div style=\"background: rgb(255, 248, 225); border-left: 4px solid rgb(243, 156, 18); border-radius: 6px; margin-bottom: 10px; padding: 15px 20px; text-align: left;\">\n      <p style=\"color: #8d6e00; font-size: 13px; margin: 0px;\">\n        ⏳ <strong>Paciencia, por favor.</strong> Los artículos cargan poco a poco. En unos segundos empezarás a verlos aparecer.\n      </p>\n    </div>\n  </div>\n\n  <!--GRID DE PRODUCTOS-->\n  <div id=\"onot1-kurtki-grid\" style=\"color: #333333; display: grid; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin: auto; max-width: 1000px;\">\n    <p style=\"color: #999999; grid-column: 1 / -1; text-align: center;\">Cargando artículos...</p>\n  </div>\n  \n  <div id=\"onot1-kurtki-status\" style=\"color: #999999; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; font-size: 13px; margin-top: 20px; text-align: center;\"></div>\n</div>\n\n<style>\n  #onot1-kurtki-widget .onot1-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; display: flex; flex-direction: column; }\n  #onot1-kurtki-widget .onot1-card img { width: 100%; height: 300px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #fafafa; }\n  #onot1-kurtki-widget .onot1-card-title { font-size: 14px; font-weight: 600; margin-bottom: 5px; color: #333; min-height: 40px; }\n  #onot1-kurtki-widget .onot1-card-price { font-size: 16px; font-weight: bold; color: #2c3e50; margin-bottom: 10px; }\n  #onot1-kurtki-widget .onot1-card-btn { display: block; background: #111; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; margin-top: auto; }\n  #onot1-kurtki-widget .onot1-card-btn:hover { background: #333; }\n</style>\n\n<script>\n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var CATALOG_URL = \"https://0not1.ru/catalog/kurtki/\";\n  var articulos = [];\n\n  function cargar() {\n    fetch(proxy + \"?url=\" + encodeURIComponent(CATALOG_URL))\n      .then(function(res) { return res.text(); })\n      .then(function(html) {\n        var bloques = html.split('class=\"product-card__image\"');\n        bloques.shift();\n        \n        bloques.forEach(function(bloque) {\n          var linkMatch = bloque.match(/href=\"(\\/catalog\\/kurtki\\/[^\"]+)\"/);\n          var imgMatch = bloque.match(/src=\"(\\/upload\\/[^\"]+)\"/);\n          \n          if (linkMatch && imgMatch) {\n            articulos.push({\n              loc: \"https://0not1.ru\" + linkMatch[1],\n              img: \"https://0not1.ru\" + imgMatch[1],\n              title: \"\",\n              price: \"\"\n            });\n          }\n        });\n\n        var nombreRegex = /product-card__name[^>]*>\\s*<a[^>]*>([^<]+)<\\/a>/g;\n        var precioRegex = /product-card__price[^>]*>\\s*<div[^>]*class=\"current[^\"]*\"[^>]*>([^<]+)<\\/div>/g;\n        \n        var nombres = [], precios = [], match;\n        while ((match = nombreRegex.exec(html)) !== null) {\n          nombres.push(match[1].trim());\n        }\n        while ((match = precioRegex.exec(html)) !== null) {\n          precios.push(match[1].trim() + \" ₽\");\n        }\n\n        articulos = articulos.slice(0, nombres.length);\n        \n        articulos.forEach(function(articulo, i) {\n          articulo.title = nombres[i] || \"Artículo\";\n          articulo.price = precios[i] || \"\";\n        });\n\n        articulos = articulos.filter(function(a) { return a.title !== \"Artículo\"; });\n\n        document.getElementById(\"onot1-kurtki-status\").textContent =\n          \"✅ \" + articulos.length + \" artículos encontrados\";\n        renderizar();\n      })\n      .catch(function() {\n        document.getElementById(\"onot1-kurtki-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar.</p>\";\n      });\n  }\n\n  function renderizar() {\n    var html = \"\";\n    articulos.forEach(function(articulo) {\n      html +=\n        '<div class=\"onot1-card\">' +\n        '<img src=\"' + articulo.img + '\" alt=\"' + articulo.title + '\" loading=\"lazy\">' +\n        '<div class=\"onot1-card-title\">' + articulo.title + '</div>' +\n        '<div class=\"onot1-card-price\">' + articulo.price + '</div>' +\n        '<a class=\"onot1-card-btn\" href=\"' + articulo.loc + '\" target=\"_blank\">🛒 VER ARTÍCULO</a>' +\n        '</div>';\n    });\n    \n    html +=\n      '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n      '<a href=\"' + CATALOG_URL + '\" target=\"_blank\" style=\"display: inline-block; background: #c0392b; color: #fff; padding: 16px 40px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; font-family: \\'Segoe UI\\', Roboto, Arial, sans-serif;\">🛍️ VER MÁS EN LA WEB OFICIAL</a>' +\n      '</div>';\n    \n    document.getElementById(\"onot1-kurtki-grid\").innerHTML = html;\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargar);\n  } else {\n    cargar();\n  }\n})();\n</script>",
 "fecha_copia": "2026-10-03T05:43:11.120Z"
