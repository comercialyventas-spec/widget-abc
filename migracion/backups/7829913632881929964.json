 "titulo": "BASYCO JEREZ",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi5CBYGyLIgaTPyBmkYiNdTWwd6OrLOOcoj-k2TW4i8CTj91ZuH2XIOvHQCve0p3S9cL_Yt_6ydjcZlnrYA4rTIRMG7FSzRaMzGaid4QJWzC267RQg-9mdHxRlcuFEN3UsVadzcan_-ViPxHNI2m2yCfhjnepIupD4d3cgAjmPJMr4nGRPxG0Lcje9ms2o/s562/vestido-sicilia.jpg\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" data-original-height=\"562\" data-original-width=\"450\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi5CBYGyLIgaTPyBmkYiNdTWwd6OrLOOcoj-k2TW4i8CTj91ZuH2XIOvHQCve0p3S9cL_Yt_6ydjcZlnrYA4rTIRMG7FSzRaMzGaid4QJWzC267RQg-9mdHxRlcuFEN3UsVadzcan_-ViPxHNI2m2yCfhjnepIupD4d3cgAjmPJMr4nGRPxG0Lcje9ms2o/s320/vestido-sicilia.jpg\" /></a></div><div style=\"text-align: justify;\">Basyco es una tienda de moda femenina ubicada en Jerez de la Frontera, centrada en ropa casual, vestidos de fiesta y complementos con un estilo juvenil y actual. La marca combina venta física y online, destacando por prendas coloridas, estampados llamativos y colecciones pensadas para ocasiones especiales y looks de temporada. También mantiene una fuerte presencia en redes sociales y colaboraciones con influencers de moda.</div><div id=\"basyco-widget\">\n  <div id=\"basyco-grid\" style=\"color: #333333; display: grid; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin: auto; max-width: 1000px;\">\n    <p style=\"color: #999999; grid-column: 1 / -1; text-align: center;\">Cargando productos de Basyco Jerez...</p>\n  </div>\n  <div id=\"basyco-status\" style=\"color: #999999; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; font-size: 13px; margin-top: 20px; text-align: center;\"></div>\n</div>\n\n<style>\n  #basyco-widget .basy-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; display: flex; flex-direction: column; }\n  #basyco-widget .basy-card img { width: 100%; height: 250px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #fafafa; }\n  #basyco-widget .basy-card-title { font-size: 13px; font-weight: 600; margin-bottom: 5px; color: #333; min-height: 40px; }\n  #basyco-widget .basy-card a { display: block; background: #8B0000; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; margin-top: auto; }\n  #basyco-widget .basy-card a:hover { background: #600000; }\n</style>\n\n<script>\n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var SITEMAP_URL = \"https://basycojerez.com/1_es_0_sitemap.xml\";\n  var TIENDA_URL = \"https://basycojerez.com/\";\n  var productos = [];\n  var mostrados = 0;\n  var cargando = false;\n  var POR_LOTE = 12;\n\n  function cargarBasyco() {\n    document.getElementById(\"basyco-status\").textContent = \"Cargando productos...\";\n    \n    fetch(proxy + \"?url=\" + encodeURIComponent(SITEMAP_URL))\n      .then(function(res) { return res.text(); })\n      .then(function(xml) {\n        var bloques = xml.split(\"<url>\");\n        bloques.shift();\n        \n        bloques.forEach(function(bloque) {\n          var locMatch = bloque.match(/<loc>\\s*<!\\[CDATA\\[\\s*(https:\\/\\/basycojerez\\.com\\/[^\\]]+)\\s*\\]\\]>\\s*<\\/loc>/);\n          var imgMatch = bloque.match(/<image:loc>\\s*<!\\[CDATA\\[\\s*(https:\\/\\/basycojerez\\.com\\/[^\\]]+)\\s*\\]\\]>\\s*<\\/image:loc>/);\n          \n          if (locMatch && imgMatch) {\n            var url = locMatch[1];\n            // Solo productos, no páginas\n            if (url.indexOf(\"/outlet/\") === -1 && url.indexOf(\"/producto/\") === -1 && url.indexOf(\".html\") === -1) return;\n            \n            var partes = url.replace(/\\/$/, \"\").split(\"/\");\n            var slug = partes[partes.length - 1].replace(\".html\", \"\");\n            productos.push({\n              title: slug.replace(/-/g, \" \").replace(/\\b\\w/g, function(l) { return l.toUpperCase(); }),\n              link: url,\n              img: imgMatch[1]\n            });\n          }\n        });\n\n        var vistos = {};\n        productos = productos.filter(function(p) {\n          if (vistos[p.link]) return false;\n          vistos[p.link] = true;\n          return true;\n        });\n\n        if (productos.length === 0) {\n          document.getElementById(\"basyco-grid\").innerHTML =\n            \"<p style='grid-column: 1/-1; text-align: center; color: #666;'>No se encontraron productos.</p>\";\n          return;\n        }\n\n        document.getElementById(\"basyco-status\").textContent = productos.length + \" productos encontrados\";\n        cargarLote();\n      })\n      .catch(function() {\n        document.getElementById(\"basyco-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar.</p>\";\n      });\n  }\n\n  function cargarLote() {\n    if (cargando || mostrados >= productos.length) {\n      if (mostrados >= productos.length && productos.length > 0) {\n        document.getElementById(\"basyco-status\").textContent = \"✅ \" + productos.length + \" productos\";\n        renderizar();\n      }\n      return;\n    }\n    cargando = true;\n    mostrados = Math.min(mostrados + POR_LOTE, productos.length);\n    renderizar();\n    cargando = false;\n    if (mostrados < productos.length) {\n      document.getElementById(\"basyco-status\").textContent = \"Mostrando \" + mostrados + \" de \" + productos.length;\n    }\n  }\n\n  function renderizar() {\n    var html = \"\";\n    for (var i = 0; i < mostrados; i++) {\n      var p = productos[i];\n      html +=\n        '<div class=\"basy-card\">' +\n        '<img src=\"' + p.img + '\" alt=\"' + p.title + '\" loading=\"lazy\">' +\n        '<div class=\"basy-card-title\">' + p.title + '</div>' +\n        '<a href=\"' + p.link + '\" target=\"_blank\">👗 VER PRODUCTO</a>' +\n        '</div>';\n    }\n\n    if (mostrados >= productos.length && productos.length > 0) {\n      html +=\n        '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n        '<a href=\"' + TIENDA_URL + '\" target=\"_blank\" style=\"display: inline-block; background: #8B0000; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;\">👗 VER TIENDA COMPLETA</a>' +\n        '</div>';\n    }\n\n    document.getElementById(\"basyco-grid\").innerHTML = html;\n  }\n\n  window.addEventListener(\"scroll\", function() {\n    var grid = document.getElementById(\"basyco-grid\");\n    if (!grid) return;\n    var rect = grid.getBoundingClientRect();\n    if (rect.bottom < window.innerHeight + 500) {\n      cargarLote();\n    }\n  });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarBasyco);\n  } else {\n    cargarBasyco();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-30T19:10:12.342Z"
}