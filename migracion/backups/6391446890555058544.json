 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://encrypted-tbn3.gstatic.com/images?q=tbn:ANd9GcTnfMEhRFa9Vjy8eIB6dIH17ysuuGA7SFI5VzUgaNueXbteOA\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" height=\"320\" src=\"https://encrypted-tbn3.gstatic.com/images?q=tbn:ANd9GcTnfMEhRFa9Vjy8eIB6dIH17ysuuGA7SFI5VzUgaNueXbteOA\" /></a></div>\n\n<div style=\"text-align: justify;\">Las últimas noticias de datos-inflacion/20230124 seleccionadas por newtral.es.</div>\n\n<div id=\"noticias-5-container\">\n  <div id=\"noticias-5-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\" />\n  <div id=\"noticias-5-lista\">Cargando noticias de tag/inflacion...</div>\n</div>\n\n<style>\n  #noticias-5-container { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #noticias-5-container .nw-featured { text-align: center; margin-bottom: 40px; }\n  #noticias-5-container .nw-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  #noticias-5-container .nw-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #noticias-5-container .nw-title-featured:hover { color: #c0392b; }\n  #noticias-5-container .nw-desc-featured { font-size: 15px; color: #555; line-height: 1.6; margin-bottom: 10px; }\n  #noticias-5-container .nw-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #noticias-5-container .nw-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  #noticias-5-container .nw-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #noticias-5-container .nw-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #noticias-5-container .nw-item-title:hover { color: #c0392b; }\n  #noticias-5-container .nw-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    #noticias-5-container .nw-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #noticias-5-container .nw-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function(){\n  var FEED = \"https://www.newtral.es/tag/inflacion/feed/\";\n  var PROXY = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var TRACKER = \"https://script.google.com/macros/s/AKfycbw7seO_gWWhbVnYLVeWNuvrQ8SYvdv8QA7qLy9FQxoDEaDC9BuGh7nsRT5reNvwupiG/exec\";\n  var META_LABEL = \"NEWTRAL.ES · TAG/INFLACION\";\n  var WID = \"noticias-5\";\n  var MEDIO = \"newtral.es\";\n  var SECCION = \"tag/inflacion\";\n  var BLOG = \"periódicosaliazon\";\n  var URL_SECCION = \"https://www.newtral.es/datos-inflacion/20230124/\";\n\n  window.registrarClic = function(url, titulo) {\n    var trackerUrl = TRACKER + \"?url=\" + encodeURIComponent(url) + \"&titulo=\" + encodeURIComponent(titulo) + \"&medio=\" + encodeURIComponent(MEDIO) + \"&seccion=\" + encodeURIComponent(SECCION) + \"&blog=\" + encodeURIComponent(BLOG);\n    fetch(trackerUrl, { mode: \"no-cors\" }).catch(function(){});\n  }\n\n  function construirUrlConUtm(url) {\n    var sep = url.indexOf(\"?\") === -1 ? \"?\" : \"&\";\n    return url + sep + \"utm_source=\" + encodeURIComponent(BLOG) + \"&utm_medium=widget&utm_campaign=\" + encodeURIComponent(MEDIO + \"_\" + SECCION);\n  }\n\n  async function cargar() {\n    try {\n      var res = await fetch(PROXY + \"?url=\" + encodeURIComponent(FEED));\n      var text = await res.text();\n      var parser = new DOMParser();\n      var xml = parser.parseFromString(text, \"text/xml\");\n      var items = Array.from(xml.querySelectorAll(\"item\"));\n      if (!items.length) throw new Error(\"Sin resultados\");\n\n      var noticias = items.slice(0, 6).map(function(item) {\n        var title = item.querySelector(\"title\")?.textContent || \"\";\n        var linkEl = item.querySelector(\"link\");\n        var loc = linkEl ? (linkEl.nextSibling?.nodeValue?.trim() || linkEl.textContent?.trim() || \"\") : \"\";\n        var pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n        var desc = item.querySelector(\"description\")?.textContent || \"\";\n        var tmp = document.createElement(\"div\");\n        tmp.innerHTML = desc;\n        var descTexto = (tmp.textContent || \"\").trim().slice(0, 180);\n        var contentEl = item.getElementsByTagNameNS(\"http://purl.org/rss/1.0/modules/content/\", \"encoded\")[0];\n        var rawContent = contentEl ? contentEl.textContent : desc;\n        var imgMatch = rawContent.match(/src=\"(https?:\\/\\/[^\"]+\\.(jpg|jpeg|png|webp))[^\"]*\"/i);\n        var img = imgMatch ? imgMatch[1] : \"\";\n        return { loc: loc, title: title, pubDate: pubDate, desc: descTexto, img: img };\n      }).filter(function(n) { return n.title; });\n\n      function renderizar(lista) {\n        var destacadoHtml = \"\";\n        var listaHtml = \"\";\n        lista.forEach(function(noticia, index) {\n          var fecha = noticia.pubDate ? new Date(noticia.pubDate).toLocaleDateString(\"es-ES\", { day: \"2-digit\", month: \"short\", year: \"numeric\" }) : \"\";\n          var urlConUtm = construirUrlConUtm(noticia.loc);\n          if (index === 0) {\n            destacadoHtml = '<div class=\"nw-featured\">' +\n              (noticia.img ? '<a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\', \\'' + noticia.title.replace(/'/g, '\\\\\\'') + '\\'); return true;\"><img src=\"' + noticia.img + '\" class=\"nw-img-featured\" alt=\"' + noticia.title.replace(/\"/g, '&quot;') + '\"></a>' : '') +\n              '<a href=\"' + urlConUtm + '\" class=\"nw-title-featured\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\', \\'' + noticia.title.replace(/'/g, '\\\\\\'') + '\\'); return true;\">' + noticia.title + '</a>' +\n              (noticia.desc ? '<p class=\"nw-desc-featured\">' + noticia.desc + '…</p>' : '') +\n              '<div class=\"nw-meta\">' + META_LABEL + ' · ' + fecha + '</div>' +\n              '</div>';\n          } else {\n            listaHtml += '<div class=\"nw-item\">' +\n              (noticia.img ? '<div class=\"nw-img-container\"><a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\', \\'' + noticia.title.replace(/'/g, '\\\\\\'') + '\\'); return true;\"><img src=\"' + noticia.img + '\" alt=\"' + noticia.title.replace(/\"/g, '&quot;') + '\"></a></div>' : '') +\n              '<div><a href=\"' + urlConUtm + '\" class=\"nw-item-title\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\', \\'' + noticia.title.replace(/'/g, '\\\\\\'') + '\\'); return true;\">' + noticia.title + '</a>' +\n              '<div class=\"nw-meta\">' + META_LABEL + ' · ' + fecha + '</div></div></div>';\n          }\n        });\n        document.getElementById(WID + \"-destacada\").innerHTML = destacadoHtml;\n        document.getElementById(WID + \"-lista\").innerHTML = listaHtml;\n      }\n\n      renderizar(noticias);\n\n      for (var i = 0; i < noticias.length; i++) {\n        if (noticias[i].img) continue;\n        try {\n          var r = await fetch(PROXY + \"?url=\" + encodeURIComponent(noticias[i].loc));\n          var htmlStr = await r.text();\n          var m = htmlStr.match(/property=\"og:image\"\\s+content=\"([^\"]+)\"/i)\n                 || htmlStr.match(/content=\"([^\"]+)\"\\s+property=\"og:image\"/i)\n                 || htmlStr.match(/https?:\\/\\/[^\\s\"']+\\.(?:jpg|jpeg|png|webp)/i);\n          if (m) { noticias[i].img = m[1] || m[0]; renderizar(noticias); }\n        } catch(e) {}\n      }\n\n    } catch(err) {\n      document.getElementById(WID + \"-container\").innerHTML = \"<p style='color:red'>Error al cargar las noticias.</p>\";\n    }\n  }\n\n  cargar();\n})();\n</script>\n\n<div style=\"text-align: center; margin-top: 30px;\">\n  <a href=\"https://www.newtral.es/datos-inflacion/20230124/?utm_source=peri%C3%B3dicosaliazon&utm_medium=widget&utm_campaign=newtral.es_tag%2Finflacion\" target=\"_blank\" onclick=\"registrarClic('https://www.newtral.es/datos-inflacion/20230124/', 'Ver más noticias en newtral.es - tag/inflacion'); return true;\" style=\"display: inline-block; background: #c0392b; color: white; padding: 10px 25px; text-decoration: none; border-radius: 30px; font-size: 14px; font-weight: bold;\">\n    Ver m&aacute;s noticias en newtral.es &middot; tag/inflacion\n  </a>\n</div>\n",
 "fecha_copia": "2026-09-26T15:18:20.209Z"
