 "titulo": "ESPAÑA EUROPA PRESS",
 "fila": 1741,
 "contenido": "<div id=\"ep-widget-final\">\n  <div id=\"ep-contenido\">\n    <p style=\"text-align:center; padding:20px; color:#666; font-family:sans-serif;\">🔄 Cargando noticias en alta resolución...</p>\n  </div>\n</div>\n\n<style>\n  #ep-contenido { \n    display: grid; \n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); \n    gap: 20px; \n    font-family: 'Segoe UI', Roboto, Arial, sans-serif;\n  }\n  \n  /* NOTICIA PRINCIPAL */\n  #ep-contenido > div:first-child { \n    grid-column: 1 / -1; \n    border-bottom: 2px solid #eee !important;\n    padding-bottom: 20px;\n  }\n  \n  /* TRATAMIENTO DE IMAGEN PARA MÁXIMA NITIDEZ */\n  #ep-contenido div[style*=\"background\"] { \n    background-size: cover !important; \n    background-position: center !important;\n    background-repeat: no-repeat !important;\n    border-radius: 8px;\n    /* Evita que el navegador suavice de más la imagen si es pequeña */\n    image-rendering: -webkit-optimize-contrast; \n  }\n\n  #ep-contenido > div:first-child div[style*=\"background\"] { \n    height: 400px !important; \n  }\n\n  #ep-contenido > div:not(:first-child) div[style*=\"background\"] { \n    height: 160px !important; \n  }\n\n  #ep-contenido a { \n    text-decoration: none; \n    color: #111; \n    font-weight: 800; \n    font-size: 18px;\n    display: block;\n    margin-top: 12px;\n    line-height: 1.3;\n  }\n</style>\n\n<script>\n(function() {\n  const MI_MOTOR = \"https://script.google.com/macros/s/AKfycbxTehoGzJL9MT1SvEnV7XNNbpIs0n3XEQd_yFl1aBQdC_ZBPLRhQ3m-wokLZKZtwrIT/exec\";\n  const RSS_URL = \"https://www.europapress.es/rss/rss.aspx?ch=00066\";\n  const contenedor = document.getElementById('ep-contenido');\n\n  fetch(`${MI_MOTOR}?url=${encodeURIComponent(RSS_URL)}`)\n    .then(response => response.text())\n    .then(html => {\n      /* \n         TRUCO MAESTRO PARA EUROPA PRESS:\n         Europa Press suele enviar miniaturas terminadas en num_100.jpg o num_120.jpg.\n         Este código detecta esos patrones y pide la imagen original (más grande).\n      */\n      let altaCalidad = html\n        .replace(/_(\\d{2,3})\\.jpg/g, '.jpg') // Quita el sufijo de miniatura (ej: _120.jpg -> .jpg)\n        .replace(/_(\\d{2,3})\\.png/g, '.png')\n        .replace(/filter: blur\\(.*?\\);/g, ''); // Por si acaso hay desenfoque por código\n\n      contenedor.innerHTML = altaCalidad;\n    })\n    .catch(err => {\n      contenedor.innerHTML = \"<p style='text-align:center;'>Error al cargar las imágenes.</p>\";\n    });\n})();\n</script>",
 "fecha_copia": "2026-09-26T15:18:03.444Z"
}