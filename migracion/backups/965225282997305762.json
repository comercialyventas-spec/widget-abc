 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEje7LubQq2HyCRJ82LrZutJiJ8YboSCT5AcH5d7fqFaLNoGGirOW1E0xDnbeuPb7jeiEpmcK-9YiR7RVlfaerLYrysrdnExViQzjTRmAM102YKB31NXWu7ibBSGDQQQclJKUzwkeEIHffuvAGninp4Pa_RiPC5abPqnaLi4XP-jxlbfvtnFEQA6q9ddsL4/s2400/2080s260014_Falda_Benedetta_Blanca_1560b_7%20%281%29.jpg\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" height=\"320\" data-original-height=\"2400\" data-original-width=\"1934\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEje7LubQq2HyCRJ82LrZutJiJ8YboSCT5AcH5d7fqFaLNoGGirOW1E0xDnbeuPb7jeiEpmcK-9YiR7RVlfaerLYrysrdnExViQzjTRmAM102YKB31NXWu7ibBSGDQQQclJKUzwkeEIHffuvAGninp4Pa_RiPC5abPqnaLi4XP-jxlbfvtnFEQA6q9ddsL4/s320/2080s260014_Falda_Benedetta_Blanca_1560b_7%20%281%29.jpg\"/></a></div><br />\n\n<div style=\"text-align: justify;\">Las faldas de El Ganso destacan por su estilo femenino, fresco y versátil, inspirado en un espíritu mediterráneo y desenfadado. La colección reúne diseños midi y largos, estampados florales, rayas, bordados y tejidos ligeros como el lino, pensados para crear looks cómodos y elegantes para el día a día. Con una cuidada atención a los detalles y una paleta de colores luminosa, cada modelo refleja el equilibrio entre tendencia, naturalidad y calidad que caracteriza a la marca.</div>\n\n<!--more-->\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://www.elganso.com/?utm_source=ropaycomplementos&amp;utm_medium=boton_oficial&amp;utm_campaign=catalogo_elganso\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: &quot;Helvetica Neue&quot;, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=ropaycomplementos&utm_medium=tarjeta_producto&utm_campaign=catalogo_elganso';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\nfetch('https://script.google.com/macros/s/AKfycbxOCb-AYehPn7O-x10c4JVzcrGCkcAAS2upa9XWnsZKLtXJ9q-O5BYlhJvvgxX6KB2S/exec?url=https%3A%2F%2Fwww.elganso.com%2Fes%2Fmujer%2Ffaldas-mujer.html&pagina=1')\n  .then(function(r){ return r.json(); })\n  .then(function(data){\n    document.getElementById('tienda-catalogo').innerHTML = data.productos.map(crearTarjeta).join('');\n    document.getElementById('loader').style.display = 'none';\n    document.getElementById('web-oficial-container').style.display = 'block';\n  })\n  .catch(function(err){ console.log(err); });\n\n</script>\n\n<div><br /></div>