 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh75_hjN17UeKof3z5BKKebSUZqAN8Q5xScsAze2DKx6CmiE1Sjw5Bmqnh7j-TCqTBm8VXQn4QwamxXJUFKDWLvQqD0aCOlmSqC60z-lON3o1P6Wsjr3G_uKEijQBd9P7OluLvX0ddB1eShpe-JN_RuZDW3dnQGMJ8xwajEwoPhyrD8kcn4lBJrcwilql8/s495/hemos-mejorado-para-ti-en-c-lope-de-vega-495x400.jpg\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" width=\"320\" data-original-height=\"400\" data-original-width=\"495\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh75_hjN17UeKof3z5BKKebSUZqAN8Q5xScsAze2DKx6CmiE1Sjw5Bmqnh7j-TCqTBm8VXQn4QwamxXJUFKDWLvQqD0aCOlmSqC60z-lON3o1P6Wsjr3G_uKEijQBd9P7OluLvX0ddB1eShpe-JN_RuZDW3dnQGMJ8xwajEwoPhyrD8kcn4lBJrcwilql8/s320/hemos-mejorado-para-ti-en-c-lope-de-vega-495x400.jpg\"/></a></div><div id=\"cf-act-widget\">\n  <div id=\"cf-act-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 1000px; margin: auto; color: #333;\">\n    <p style=\"grid-column: 1/-1; text-align: center; color: #999;\">Cargando actualidad de Cash Fresh...</p>\n  </div>\n  <div id=\"cf-act-status\" style=\"text-align: center; margin-top: 20px; color: #999; font-size: 13px; font-family: 'Segoe UI', Roboto, Arial, sans-serif;\"></div>\n</div>\n\n<style>\n  #cf-act-widget .cfa-card { border: 1px solid #eaeaea; border-radius: 10px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }\n  #cf-act-widget .cfa-card img { width: 100%; height: 180px; object-fit: cover; }\n  #cf-act-widget .cfa-card-body { padding: 16px; display: flex; flex-direction: column; flex: 1; }\n  #cf-act-widget .cfa-card h3 { font-size: 15px; font-weight: 700; color: #111; margin-bottom: 8px; }\n  #cf-act-widget .cfa-card .cfa-date { font-size: 11px; color: #999; margin-bottom: 12px; }\n  #cf-act-widget .cfa-card a.cfa-btn { display: block; background: #e63946; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 13px; font-weight: bold; text-align: center; margin-top: auto; }\n  #cf-act-widget .cfa-card a.cfa-btn:hover { background: #c1121f; }\n</style>\n\n<script>\n(function() {\n  var proxy    = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var BASE_URL = \"https://www.cashfresh.es/actualidad/\";\n  var articulos  = [];\n  var paginaActual = 1;\n  var hayMasPaginas = true;\n  var cargandoPagina = false;\n\n  function extraerDePagina(html) {\n    var encontradas = [];\n    var regex = /<article[^>]*>([\\s\\S]*?)<\\/article>/g;\n    var match;\n    while ((match = regex.exec(html)) !== null) {\n      var bloque = match[1];\n\n      var linkMatch = bloque.match(/href='(https:\\/\\/www\\.cashfresh\\.es\\/[^']+)'/);\n      if (!linkMatch) linkMatch = bloque.match(/href=\"(https:\\/\\/www\\.cashfresh\\.es\\/[^\"]+)\"/);\n      if (!linkMatch) continue;\n      var link = linkMatch[1];\n\n      var tituloMatch = bloque.match(/class='slide-entry-title entry-title[^']*'[^>]*><a[^>]*>([^<]+)<\\/a>/);\n      if (!tituloMatch) tituloMatch = bloque.match(/class=\"slide-entry-title entry-title[^\"]*\"[^>]*><a[^>]*>([^<]+)<\\/a>/);\n      if (!tituloMatch) tituloMatch = bloque.match(/itemprop=\"headline\"[^>]*><a[^>]*>([^<]+)<\\/a>/);\n      if (!tituloMatch) continue;\n      var titulo = tituloMatch[1].trim();\n\n      var imgMatch = bloque.match(/src=\"(https:\\/\\/www\\.cashfresh\\.es\\/wp-content\\/uploads\\/[^\"]+\\.(?:jpg|jpeg|png|webp))\"/i);\n      if (!imgMatch) imgMatch = bloque.match(/src='(https:\\/\\/www\\.cashfresh\\.es\\/wp-content\\/uploads\\/[^']+\\.(?:jpg|jpeg|png|webp))'/i);\n      var img = imgMatch ? imgMatch[1] : \"\";\n\n      var fechaMatch = bloque.match(/<time[^>]*datetime=\"([^\"]+)\"/);\n      var fecha = fechaMatch ? fechaMatch[1] : \"\";\n\n      var yaExiste = articulos.some(function(r) { return r.link === link; });\n      if (!yaExiste) encontradas.push({ title: titulo, link: link, img: img, date: fecha });\n    }\n    return encontradas;\n  }\n\n  function hayPaginaSiguiente(html) {\n    return html.indexOf('rel=\"next\"') !== -1 || html.indexOf(\"page/\" + (paginaActual + 1) + \"/\") !== -1;\n  }\n\n  function cargarPagina() {\n    if (cargandoPagina || !hayMasPaginas) return;\n    cargandoPagina = true;\n\n    var url = paginaActual === 1 ? BASE_URL : BASE_URL + \"page/\" + paginaActual + \"/\";\n    document.getElementById(\"cf-act-status\").textContent = \"Cargando página \" + paginaActual + \"...\";\n\n    fetch(proxy + \"?url=\" + encodeURIComponent(url))\n      .then(function(res) { return res.text(); })\n      .then(function(html) {\n        var nuevas = extraerDePagina(html);\n        hayMasPaginas = hayPaginaSiguiente(html);\n\n        if (nuevas.length > 0) {\n          articulos = articulos.concat(nuevas);\n          renderizar();\n        }\n\n        paginaActual++;\n        cargandoPagina = false;\n\n        if (!hayMasPaginas) {\n          document.getElementById(\"cf-act-status\").textContent = \"✅ \" + articulos.length + \" artículos en total\";\n        } else {\n          document.getElementById(\"cf-act-status\").textContent = articulos.length + \" artículos · Baja para ver más\";\n        }\n      })\n      .catch(function() {\n        cargandoPagina = false;\n        document.getElementById(\"cf-act-status\").textContent = \"Error al cargar. Baja para reintentar.\";\n      });\n  }\n\n  function renderizar() {\n    var html = \"\";\n    for (var i = 0; i < articulos.length; i++) {\n      var r = articulos[i];\n      var fecha = r.date ? new Date(r.date).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) : \"\";\n      html +=\n        '<div class=\"cfa-card\">' +\n        (r.img\n          ? '<img src=\"https://images.weserv.nl/?url=' + encodeURIComponent(r.img) + '&w=400&h=180&fit=cover\" alt=\"' + r.title + '\" loading=\"lazy\">'\n          : '<div style=\"height:180px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;font-size:40px;\">📰</div>') +\n        '<div class=\"cfa-card-body\">' +\n        '<h3>' + r.title + '</h3>' +\n        (fecha ? '<div class=\"cfa-date\">' + fecha + '</div>' : '') +\n        '<a class=\"cfa-btn\" href=\"' + r.link + '\" target=\"_blank\">📰 LEER ARTÍCULO</a>' +\n        '</div>' +\n        '</div>';\n    }\n\n    if (!hayMasPaginas && articulos.length > 0) {\n      html +=\n        '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n        '<a href=\"' + BASE_URL + '\" target=\"_blank\" style=\"display: inline-block; background: #e63946; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;\">📰 VER TODA LA ACTUALIDAD</a>' +\n        '</div>';\n    }\n\n    document.getElementById(\"cf-act-grid\").innerHTML = html;\n  }\n\n  window.addEventListener(\"scroll\", function() {\n    var grid = document.getElementById(\"cf-act-grid\");\n    if (!grid) return;\n    var rect = grid.getBoundingClientRect();\n    if (rect.bottom < window.innerHeight + 600 && !cargandoPagina && hayMasPaginas) {\n      cargarPagina();\n    }\n  });\n\n  cargarPagina();\n})();\n</script>",
 "fecha_copia": "2026-09-28T18:22:00.839Z"
}