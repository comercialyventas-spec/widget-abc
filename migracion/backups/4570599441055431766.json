 "titulo": "ZIMMERLI",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiE3-ycvscobZGfoQitg8bwgolGHm9HdpCN_tQqhH5ECAke9DFkAJHXLEZ3cJ6Qq_w6bbRgP32mJPI1jhVfdS19b3_dcGJObFO_Ign6Gc6T1Hot08ku07nW_n760YCqVAqrZg-uqroUcOiDvZyooM4qzRRXIfmfNioJeRj89-AOwA_16ZVg5o3YSnRFRgQ/s1920/videoframe_10476.png\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" width=\"320\" data-original-height=\"1080\" data-original-width=\"1920\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiE3-ycvscobZGfoQitg8bwgolGHm9HdpCN_tQqhH5ECAke9DFkAJHXLEZ3cJ6Qq_w6bbRgP32mJPI1jhVfdS19b3_dcGJObFO_Ign6Gc6T1Hot08ku07nW_n760YCqVAqrZg-uqroUcOiDvZyooM4qzRRXIfmfNioJeRj89-AOwA_16ZVg5o3YSnRFRgQ/s320/videoframe_10476.png\"/></a></div>\nZimmerli es una firma suiza de lujo fundada en 1871, especializada en ropa interior, loungewear y prendas de descanso para hombre y mujer. La marca destaca por su artesanía suiza, el uso de materiales premium como seda, algodón Sea Island y modal, y una producción centrada en la comodidad, los acabados cuidados y la calidad atemporal. Su propuesta combina diseño minimalista y confección de alta gama en prendas pensadas para el uso diario y el descanso.\n<div id=\"tienda-catalogo\"></div>\n\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">\n  Cargando...\n</div>\n\n<style>\n#tienda-catalogo {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: 20px;\n  font-family: Arial, sans-serif;\n}\n\n.producto-card {\n  border: 1px solid #eaeaea;\n  padding: 15px;\n  border-radius: 10px;\n  text-align: center;\n  background: #fff;\n}\n\n.producto-card img {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n  border-radius: 8px;\n}\n\n.producto-title {\n  font-size: 14px;\n  margin: 10px 0;\n  font-weight: 600;\n}\n\n.producto-link {\n  display: block;\n  background: #111;\n  color: #fff;\n  padding: 10px;\n  text-decoration: none;\n  border-radius: 6px;\n  font-size: 12px;\n  font-weight: bold;\n}\n\n.producto-link:hover {\n  background: #333;\n}\n</style>\n\n<script>\nvar TIENDA_URL = \"https://www.zimmerli.com/\";\nvar APPS_SCRIPT = \"https://script.google.com/macros/s/AKfycbxa_UqeA9VYkB0ARWi12nfJTQR3RJ5JzsZwwZPUl5l7kY_sAdaqX79pg8wh093rNM_b2w/exec\";\n\nvar paginaActual = 1;\nvar cargando = false;\nvar hayMas = true;\nvar cola = false;\n\nfunction limpiarUrl(url) {\n  return url ? url.replace(/&amp;/g, \"&\").replace(/&apos;/g, \"'\") : \"\";\n}\n\nfunction ocultarTarjeta(img) {\n  var card = img.closest(\".producto-card\");\n  if (card) card.style.display = \"none\";\n}\n\nfunction crearTarjeta(p) {\n  if (!p.imagen) return \"\";\n  var imgUrl = \"https://images.weserv.nl/?url=\" + encodeURIComponent(limpiarUrl(p.imagen)) + \"&w=400&output=webp\";\n  return '<div class=\"producto-card\">' +\n    '<img src=\"' + imgUrl + '\" loading=\"lazy\" alt=\"' + p.titulo + '\" onerror=\"ocultarTarjeta(this)\">' +\n    '<div class=\"producto-title\">' + p.titulo + '</div>' +\n    '<a class=\"producto-link\"' +\n    ' href=\"' + limpiarUrl(p.url) + '\"' +\n    ' target=\"_blank\"' +\n    ' onclick=\"registrarClic(\\'' + p.titulo.replace(/'/g, \"\\\\'\") + '\\',\\'' + p.url + '\\',\\'' + p.tienda + '\\')\">' +\n    'Comprar' +\n    '</a>' +\n    '</div>';\n}\n\nasync function cargarProductos() {\n  if (cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById(\"loader\").style.display = \"block\";\n\n  try {\n    var res = await fetch(\n      APPS_SCRIPT +\n      \"?tienda=\" + encodeURIComponent(TIENDA_URL) +\n      \"&pagina=\" + paginaActual\n    );\n    var data = await res.json();\n    var cont = document.getElementById(\"tienda-catalogo\");\n    cont.innerHTML += data.productos.map(crearTarjeta).join(\"\");\n    hayMas = data.hayMas;\n    paginaActual++;\n\n    if (hayMas) {\n      setTimeout(function() {\n        if (!cargando) cargarProductos();\n      }, 500);\n    }\n\n  } catch (e) {\n    console.log(e);\n  }\n\n  document.getElementById(\"loader\").style.display = \"none\";\n  cargando = false;\n\n  if (cola) {\n    cola = false;\n    cargarProductos();\n  }\n}\n\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  cargarProductos();\n\n  var sentinel = document.getElementById(\"sentinel\");\n  var observer = new IntersectionObserver(function (entries) {\n    if (entries[0].isIntersecting) {\n      if (cargando) {\n        cola = true;\n        return;\n      }\n      cargarProductos();\n    }\n  }, { rootMargin: \"800px\" });\n\n  observer.observe(sentinel);\n});\n\nasync function registrarClic(titulo, url, tienda) {\n  try {\n    await fetch(APPS_SCRIPT, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ tienda: tienda, titulo: titulo, url: url }),\n      mode: \"no-cors\"\n    });\n  } catch (e) {\n    console.log(\"tracking error\", e);\n  }\n}\n</script>\n<div><br /></div><a href=\"https://www.zimmerli.com/\" target=\"_blank\"><b>IR A LA WEB OFICIAL&nbsp;</b></a><div><br /></div><div><span style=\"font-size: medium;\"><span>SI EL PRODUCTO ESTÁ AGOTADO, NO HAY DE TU TALLA O COLOR O NO ENVÍAN A TU DESTINO CONTÁCTANOS:</span><span>&nbsp;</span><a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-09-26T17:00:27.645Z"
}