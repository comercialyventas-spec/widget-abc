{
 "id": "4507085587546466004",
 "url": "https://periodicosaliazon.blogspot.com/2026/03/comer-en-la-vanguardia.html",
 "path": "/2026/03/comer-en-la-vanguardia.html",
 "titulo": "COMER EN LA VANGUARDIA",
 "fila": 25,
 "contenido": "<div id=\"lv-comer-container\">\n  <div id=\"lv-comer-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"lv-comer-rss\">Cargando recetas y actualidad gastronómica...</div>\n</div>\n\n<style>\n  #lv-comer-container { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  .lv-com-featured { text-align: center; margin-bottom: 40px; }\n  .lv-img-com-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  .lv-title-com-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  .lv-title-com-featured:hover { color: #e67e22; }\n  .lv-desc-com-featured { font-size: 18px; color: #444; line-height: 1.5; margin-bottom: 10px; }\n  .lv-com-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  .lv-com-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  .lv-com-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  .lv-com-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  .lv-com-title:hover { color: #e67e22; }\n  .lv-com-desc { font-size: 14px; color: #666; line-height: 1.5; }\n  .lv-com-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    .lv-com-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    .lv-com-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\nasync function cargarComerLV() {\n  const rssUrl = \"https://www.lavanguardia.com/rss/comer.xml\";\n  const proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  const url = `${proxy}?url=${encodeURIComponent(rssUrl)}`;\n\n  try {\n    const res = await fetch(url);\n    const text = await res.text();\n    const parser = new DOMParser();\n    const xmlDoc = parser.parseFromString(text, \"text/xml\");\n    const items = Array.from(xmlDoc.querySelectorAll(\"item\"));\n\n    if (items.length === 0) throw new Error(\"Sin resultados\");\n\n    let destacadoHtml = \"\";\n    let listaHtml = \"\";\n\n    items.slice(0, 6).forEach((item, index) => {\n      const title = item.querySelector(\"title\")?.textContent || \"\";\n      const link = item.querySelector(\"link\")?.textContent || \"\";\n      const desc = (item.querySelector(\"description\")?.textContent || \"\")\n        .replace(/<[^>]*>?/gm, '').split('.')[0];\n      const pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n      const fecha = new Date(pubDate).toLocaleDateString('es-ES', \n        { day: '2-digit', month: 'short', year: 'numeric' });\n      const img = item.querySelector(\"enclosure\")?.getAttribute(\"url\") || \"\";\n\n      if (index === 0) {\n        destacadoHtml = `\n          <div class=\"lv-com-featured\">\n            <a href=\"${link}\" target=\"_blank\">\n              ${img ? `<img src=\"${img}\" class=\"lv-img-com-featured\" alt=\"${title}\">` : \"\"}\n            </a>\n            <a class=\"lv-title-com-featured\" href=\"${link}\" target=\"_blank\">${title}</a>\n            <div class=\"lv-desc-com-featured\">${desc}...</div>\n            <div class=\"lv-com-meta\">GASTRONOMÍA · COMER · ${fecha}</div>\n          </div>`;\n      } else {\n        listaHtml += `\n          <div class=\"lv-com-item\">\n            ${img ? `<div class=\"lv-com-img-container\"><img src=\"${img}\" alt=\"${title}\"></div>` : \"\"}\n            <div class=\"lv-com-content\">\n              <a class=\"lv-com-title\" href=\"${link}\" target=\"_blank\">${title}</a>\n              <div class=\"lv-com-desc\">${desc}...</div>\n              <div class=\"lv-com-meta\">${fecha}</div>\n            </div>\n          </div>`;\n      }\n    });\n\n    document.getElementById(\"lv-comer-destacada\").innerHTML = destacadoHtml;\n    document.getElementById(\"lv-comer-rss\").innerHTML = listaHtml;\n\n  } catch (error) {\n    document.getElementById(\"lv-comer-container\").innerHTML = \n      \"<p style='color:red'>Error al cargar las noticias. Inténtalo más tarde.</p>\";\n    console.error(error);\n  }\n}\n\ncargarComerLV();\n</script>",
 "fecha_copia": "2026-09-26T15:17:59.439Z"
}