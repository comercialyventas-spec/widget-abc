  "title": "VIAJES EN LA VANGUARDIA",
  "content": "<div id=\"lv-viajes-container\">\n  <div id=\"lv-viajes-destacada\"></div>\n  \n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  \n  <div id=\"lv-viajes-rss\">Explorando los mejores destinos del mundo...</div>\n</div>\n\n<style>\n  #lv-viajes-container { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  \n  /* ESTILOS NOTICIA DESTACADA (VIAJES) */\n  .lv-via-featured { text-align: center; margin-bottom: 40px; }\n  .lv-img-via-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; background-color: #f4f4f4; }\n  .lv-title-via-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  .lv-title-via-featured:hover { color: #1abc9c; } /* Turquesa Viajes */\n  .lv-desc-via-featured { font-size: 18px; color: #444; line-height: 1.5; margin-bottom: 10px; }\n\n  /* ESTILOS LISTA (EL RESTO) */\n  .lv-via-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  .lv-via-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; background-color: #f4f4f4; }\n  .lv-via-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  .lv-via-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  .lv-via-title:hover { color: #1abc9c; }\n  .lv-via-desc { font-size: 14px; color: #666; line-height: 1.5; }\n  .lv-via-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n\n  @media (min-width: 600px) {\n    .lv-via-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    .lv-via-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\nasync function cargarViajesLV() {\n  const rssUrl = \"https://www.lavanguardia.com/rss/ocio/viajes.xml\";\n  const proxyUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}&t=${new Date().getTime()}`;\n\n  try {\n    const res = await fetch(proxyUrl);\n    const data = await res.json();\n    if (data.status !== 'ok') throw new Error();\n\n    let destacadoHtml = \"\";\n    let listaHtml = \"\";\n    \n    data.items.slice(0, 6).forEach((item, index) => {\n      let img = (item.enclosure && item.enclosure.link) ? item.enclosure.link : \n                (item.thumbnail ? item.thumbnail : \"\");\n      \n      let fecha = new Date(item.pubDate).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });\n      \n      // FILTRO DE TEXTO: Limpieza de HTML y corte en la primera frase\n      let desc = (item.description || \"\").replace(/<[^>]*>?/gm, '').split('.')[0];\n\n      if (index === 0) {\n        destacadoHtml = `\n          <div class=\"lv-via-featured\">\n            <a href=\"${item.link}\" target=\"_blank\">\n              <img src=\"${img}\" class=\"lv-img-via-featured\" alt=\"${item.title}\">\n            </a>\n            <a class=\"lv-title-via-featured\" href=\"${item.link}\" target=\"_blank\">${item.title}</a>\n            <div class=\"lv-desc-via-featured\">${desc}...</div>\n            <div class=\"lv-via-meta\">OCIO | VIAJES | ${fecha}</div>\n          </div>\n        `;\n      } else {\n        listaHtml += `\n          <div class=\"lv-via-item\">\n            ${img ? `<div class=\"lv-via-img-container\"><img src=\"${img}\"></div>` : \"\"}\n            <div class=\"lv-via-content\">\n              <a class=\"lv-via-title\" href=\"${item.link}\" target=\"_blank\">${item.title}</a>\n              <div class=\"lv-via-desc\">${desc}...</div>\n              <div class=\"lv-via-meta\">${fecha}</div>\n            </div>\n          </div>\n        `;\n      }\n    });\n\n    document.getElementById(\"lv-viajes-destacada\").innerHTML = destacadoHtml;\n    document.getElementById(\"lv-viajes-rss\").innerHTML = listaHtml;\n\n  } catch (error) {\n    document.getElementById(\"lv-viajes-container\").innerHTML = \"Error al conectar con la sección de Viajes.\";\n  }\n}\n\ncargarViajesLV();\n</script>",
