  "url": "https://periodicosaliazon.blogspot.com/2026/10/recetas-esdiario.html",
  "selfLink": "https://www.googleapis.com/blogger/v3/blogs/7463231340560247006/posts/5221479010919545067",
  "title": "RECETAS ESDIARIO",
  "content": "<div style=\"text-align: justify;\">Las últimas noticias de chismografo seleccionadas por esdiario.com.</div>\n\n<div id=\"noticias-2018-container\" data-medio=\"esdiario.com\" data-seccion=\"recetas\" data-blog=\"periódicosaliazon\" data-tracker=\"https://script.google.com/macros/s/AKfycbw7seO_gWWhbVnYLVeWNuvrQ8SYvdv8QA7qLy9FQxoDEaDC9BuGh7nsRT5reNvwupiG/exec\">\n  <div id=\"noticias-2018-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\" />\n  <div id=\"noticias-2018-lista\">🔄 Cargando noticias...</div>\n</div>\n\n<style>\n  #noticias-2018-container { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #noticias-2018-container .nw-featured { text-align: center; margin-bottom: 40px; }\n  #noticias-2018-container .nw-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  #noticias-2018-container .nw-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #noticias-2018-container .nw-title-featured:hover { color: #c0392b; }\n  #noticias-2018-container .nw-desc-featured { font-size: 15px; color: #555; line-height: 1.6; margin-bottom: 10px; }\n  #noticias-2018-container .nw-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #noticias-2018-container .nw-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  #noticias-2018-container .nw-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #noticias-2018-container .nw-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #noticias-2018-container .nw-item-title:hover { color: #c0392b; }\n  #noticias-2018-container .nw-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    #noticias-2018-container .nw-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #noticias-2018-container .nw-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function(){\n  var FEED = \"https://www.esdiario.com/rss/chismografo/recetas.xml\";\n  var TRACKER = \"https://script.google.com/macros/s/AKfycbw7seO_gWWhbVnYLVeWNuvrQ8SYvdv8QA7qLy9FQxoDEaDC9BuGh7nsRT5reNvwupiG/exec\";\n  var META_LABEL = \"ESDIARIO.COM · RECETAS\";\n  var WID = \"noticias-2018\";\n  var MEDIO = \"esdiario.com\";\n  var SECCION = \"recetas\";\n  var BLOG = \"periódicosaliazon\";\n  var LIMITE = 6;\n  var timestamp = new Date().getTime();\n  var synologyUrl = \"https://noticias.carmenprofe.synology.me/proxy.php?v=\" + timestamp + \"&f=\" + WID + \".json\";\n  var githubUrl = \"https://raw.githubusercontent.com/comercialyventas-spec/widget-abc/main/\" + WID + \".json\";\n\n  var MAX_ANTIGUEDAD_MS = 6 * 60 * 60 * 1000;\n  var copiaSynologyVieja = null;\n  function esReciente(data) {\n    if (!data || !data.actualizado) return true;\n    var t = Date.parse(data.actualizado);\n    if (isNaN(t)) return true;\n    return (Date.now() - t) < MAX_ANTIGUEDAD_MS;\n  }\n  function usarCopiaViejaOOcultar() {\n    if (copiaSynologyVieja) { try { renderizarDesdeJson(copiaSynologyVieja); return; } catch(e) {} }\n    ocultarWidget();\n  }\n\n  window.registrarClic = window.registrarClic || function(url, titulo) {\n    var ctx = (this && this.closest) ? this.closest(\"[data-medio]\") : null;\n    var m = ctx ? ctx.getAttribute(\"data-medio\") : MEDIO;\n    var s = ctx ? ctx.getAttribute(\"data-seccion\") : SECCION;\n    var b = ctx ? ctx.getAttribute(\"data-blog\") : BLOG;\n    var tk = ctx ? ctx.getAttribute(\"data-tracker\") : TRACKER;\n    var t = tk + \"?url=\" + encodeURIComponent(url) + \"&titulo=\" + encodeURIComponent(titulo) + \"&medio=\" + encodeURIComponent(m) + \"&seccion=\" + encodeURIComponent(s) + \"&blog=\" + encodeURIComponent(b);\n    fetch(t, { mode: \"no-cors\" }).catch(function(){});\n  };\n\n  function construirUrlConUtm(url) {\n    var sep = url.indexOf(\"?\") === -1 ? \"?\" : \"&\";\n    return url + sep + \"utm_source=\" + encodeURIComponent(BLOG) + \"&utm_medium=widget&utm_campaign=\" + encodeURIComponent(MEDIO + \"_\" + SECCION);\n  }\n\n  function limpiarHtml(htmlGrave) {\n    var div = document.createElement(\"div\");\n    div.innerHTML = htmlGrave;\n    var textoLimpio = div.textContent || div.innerText || \"\";\n    return textoLimpio.replace(/Seguir leyendo\\.{3}/gi, \"\").trim();\n  }\n\n  function renderizarDesdeJson(data) {\n    if (!data.noticias || data.noticias.length === 0) throw new Error(\"JSON vacío\");\n    var destacadoHtml = \"\", listaHtml = \"\", count = 0;\n    data.noticias.forEach(function(noticia) {\n      if (count >= LIMITE || !noticia.titulo) return;\n      var urlConUtm = construirUrlConUtm(noticia.link);\n      var tituloEsc = noticia.titulo.replace(/'/g, \"&#39;\");\n      var tituloLimpio = limpiarHtml(noticia.titulo);\n      if (count === 0) {\n        destacadoHtml = '<div class=\"nw-featured\">' +\n          (noticia.imagen ? '<a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.link + '\\',\\'' + tituloEsc + '\\')\"><img src=\"' + noticia.imagen + '\" class=\"nw-img-featured\" alt=\"' + tituloEsc + '\"></a>' : '') +\n          '<a href=\"' + urlConUtm + '\" class=\"nw-title-featured\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.link + '\\',\\'' + tituloEsc + '\\')\">' + tituloLimpio + '</a>' +\n          '<div class=\"nw-meta\">' + META_LABEL + '</div></div>';\n      } else {\n        listaHtml += '<div class=\"nw-item\">' +\n          (noticia.imagen ? '<div class=\"nw-img-container\"><a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.link + '\\',\\'' + tituloEsc + '\\')\"><img src=\"' + noticia.imagen + '\" alt=\"' + tituloEsc + '\"></a></div>' : '') +\n          '<div><a href=\"' + urlConUtm + '\" class=\"nw-item-title\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.link + '\\',\\'' + tituloEsc + '\\')\">' + tituloLimpio + '</a>' +\n          '<div class=\"nw-meta\">' + META_LABEL + '</div></div></div>';\n      }\n      count++;\n    });\n    inyectarAlContenedor(destacadoHtml, listaHtml);\n  }\n\n  function parsearYRenderizarXml(text) {\n    var parser = new DOMParser();\n    var xml = parser.parseFromString(text, \"text/xml\");\n    var items = Array.from(xml.querySelectorAll(\"item\"));\n    if (!items.length) { ocultarWidget(); return; }\n    var destacadoHtml = \"\", listaHtml = \"\";\n    var noticias = items.slice(0, LIMITE).map(function(item) {\n      var titleRaw = item.querySelector(\"title\")?.textContent || \"\";\n      var title = limpiarHtml(titleRaw);\n      var linkEl = item.querySelector(\"link\");\n      var loc = linkEl ? (linkEl.nextSibling?.nodeValue?.trim() || linkEl.textContent?.trim() || \"\") : \"\";\n      var pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n      var descRaw = item.querySelector(\"description\")?.textContent || \"\";\n      var descTexto = limpiarHtml(descRaw).slice(0, 180) + \"...\";\n      var contentEl = item.getElementsByTagNameNS(\"http://purl.org/rss/1.0/modules/content/\", \"encoded\")[0];\n      var rawContent = contentEl ? contentEl.textContent : descRaw;\n      var imgMatch = rawContent.match(/src=\"(https?:\\/\\/[^\"]+\\.(jpg|jpeg|png|webp))[^\"]*\"/i);\n      var img = imgMatch ? imgMatch[1] : \"\";\n      return { loc: loc, title: title, pubDate: pubDate, desc: descTexto, img: img };\n    }).filter(function(n) { return n.title; });\n\n    noticias.forEach(function(noticia, index) {\n      var urlConUtm = construirUrlConUtm(noticia.loc);\n      var tituloEsc = noticia.title.replace(/'/g, \"&#39;\");\n      if (index === 0) {\n        destacadoHtml = '<div class=\"nw-featured\">' +\n          (noticia.img ? '<a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\',\\'' + tituloEsc + '\\')\"><img src=\"' + noticia.img + '\" class=\"nw-img-featured\" alt=\"' + tituloEsc + '\"></a>' : '') +\n          '<a href=\"' + urlConUtm + '\" class=\"nw-title-featured\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\',\\'' + tituloEsc + '\\')\">' + noticia.title + '</a>' +\n          '<div class=\"nw-meta\">' + META_LABEL + '</div></div>';\n      } else {\n        listaHtml += '<div class=\"nw-item\">' +\n          (noticia.img ? '<div class=\"nw-img-container\"><a href=\"' + urlConUtm + '\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\',\\'' + tituloEsc + '\\')\"><img src=\"' + noticia.img + '\" alt=\"' + tituloEsc + '\"></a></div>' : '') +\n          '<div><a href=\"' + urlConUtm + '\" class=\"nw-item-title\" target=\"_blank\" onclick=\"registrarClic(\\'' + noticia.loc + '\\',\\'' + tituloEsc + '\\')\">' + noticia.title + '</a>' +\n          '<div class=\"nw-meta\">' + META_LABEL + '</div></div></div>';\n      }\n    });\n    inyectarAlContenedor(destacadoHtml, listaHtml);\n  }\n\n  function inyectarAlContenedor(dest, list) {\n    document.getElementById(WID + \"-destacada\").innerHTML = dest;\n    document.getElementById(WID + \"-lista\").innerHTML = list;\n    var cab = document.getElementById(WID + \"-cabecera\"); if (cab) cab.style.display = \"block\";\n  }\n  function ocultarWidget() { var c = document.getElementById(WID + \"-container\"); if (c) c.style.display = \"none\"; }\n\n  console.log(\"[\"+WID+\"] Cargando JSON prioritario desde Synology...\");\n  var controllerSynology = new AbortController();\n  var timeoutSynology = setTimeout(function(){ controllerSynology.abort(); }, 5000);\n  fetch(synologyUrl, { signal: controllerSynology.signal })\n    .then(function(r){ clearTimeout(timeoutSynology); if(!r.ok) throw new Error(); return r.json(); })\n    .then(function(data){ if (!esReciente(data)) { copiaSynologyVieja = data; throw new Error(\"JSON de Synology desactualizado\"); } renderizarDesdeJson(data); })\n    .catch(function(){\n       console.warn(\"[\"+WID+\"] Synology falló. Probando GitHub...\");\n       fetch(githubUrl, { cache: \"no-store\" })\n         .then(function(r){ if(!r.ok) throw new Error(); return r.json(); })\n         .then(renderizarDesdeJson)\n         .catch(function(){\n            console.warn(\"[\"+WID+\"] GitHub también falló. Cargando Fallback...\");\n            if (typeof window.cargarWidgetNoticias === \"function\") {\n              window.cargarWidgetNoticias({ id: WID, feed: FEED, render: parsearYRenderizarXml });\n            } else {\n              fetch(\"https://api.allorigins.win/raw?url=\" + encodeURIComponent(FEED))\n                .then(function(r){ if(!r.ok) throw new Error(); return r.text(); })\n                .then(parsearYRenderizarXml)\n                .catch(usarCopiaViejaOOcultar);\n            }\n         });\n    });\n})();\n</script>\n\n<div style=\"text-align: center; margin-top: 30px;\">\n  <a href=\"https://www.esdiario.com?utm_source=peri%C3%B3dicosaliazon&utm_medium=widget&utm_campaign=esdiario.com_recetas\" target=\"_blank\" onclick=\"registrarClic('https://www.esdiario.com', 'Ver más noticias en esdiario.com - recetas'); return true;\" style=\"display: inline-block; background: #c0392b; color: white; padding: 10px 25px; text-decoration: none; border-radius: 30px; font-size: 14px; font-weight: bold;\">\n    Ver m&aacute;s noticias en esdiario.com &middot; recetas\n  </a>\n</div>\n",
