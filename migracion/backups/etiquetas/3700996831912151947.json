 @1\"/>\n  <v:f eqn=\"prod @2 1 2\"/>\n  <v:f eqn=\"prod @3 21600 pixelWidth\"/>\n  <v:f eqn=\"prod @3 21600 pixelHeight\"/>\n  <v:f eqn=\"sum @0 0 1\"/>\n  <v:f eqn=\"prod @6 1 2\"/>\n  <v:f eqn=\"prod @7 21600 pixelWidth\"/>\n  <v:f eqn=\"sum @8 21600 0\"/>\n  <v:f eqn=\"prod @7 21600 pixelHeight\"/>\n  <v:f eqn=\"sum @10 21600 0\"/>\n </v:formulas>\n <v:path o:extrusionok=\"f\" gradientshapeok=\"t\" o:connecttype=\"rect\"/>\n <o:lock v:ext=\"edit\" aspectratio=\"t\"/>\n</v:shapetype><![endif]--><!--[if mso & !supportInlineShapes & supportFields]><v:shape\n id=\"_x0000_i1025\" type=\"#_x0000_t75\" style='width:24pt;height:24pt'>\n <v:imagedata croptop=\"-65520f\" cropbottom=\"65520f\"/>\n</v:shape><span style='mso-element:field-end'></span><![endif]--><o:p></o:p></p><p class=\"MsoNormal\" style=\"margin-left: 36pt;\">Los medios\nisraelíes informaron que el Gabinete de Seguridad israelí está considerando una\n\"ocupación militar total\" de la Franja de Gaza y un\n\"asedio\" de ciertos centros urbanos donde Hamás es más activo.<o:p></o:p></p><p class=\"MsoNormal\" style=\"margin-left: 36pt;\">El Canal 12\nde televisión de Israel informó el lunes (28 de julio) que los temas discutidos\npor el Gabinete de Seguridad israelí ese día incluían la posibilidad de\n\"conquistar la Franja de Gaza\" o \"sitiar ciudades donde Hamás\nestá activo\".<o:p></o:p></p><p class=\"MsoNormal\" style=\"margin-left: 36pt;\">El informe\nindica que, de implementarse el plan mencionado, las FDI realizarán operaciones\nen zonas donde se cree que se encuentran detenidos israelíes. Hasta el momento,\nlas FDI prácticamente han evitado actuar en estas zonas.<o:p></o:p></p><p class=\"MsoNormal\" style=\"margin-left: 36pt;\">Según un\ninforme del periódico israelí Haaretz publicado el lunes, para mantener a\nalgunos partidos de extrema derecha israelíes en la coalición gobernante, el\nprimer ministro israelí, Netanyahu, planea presentar un plan al gabinete de\nseguridad para anexar partes de la Franja de Gaza. Según el plan, Israel dará a\nHamás unos días para alcanzar un acuerdo de alto el fuego; de lo contrario,\ncomenzará a anexar partes de la Franja de Gaza.<o:p></o:p></p><p class=\"MsoNormal\" style=\"background: rgb(255, 255, 255); color: #444444; font-family: Dosis, Verdana, Arial, &quot;Trebuchet MS&quot;, sans-serif; line-height: normal; margin: 0px 0px 0cm 36pt; outline: 0px; padding: 0px; text-align: left;\">\n\n\n\n\n\n\n\n\n\n\n\n</p><p class=\"MsoNormal\" style=\"margin-left: 36pt;\">El informe\nindica que Israel primero anexará algunas localidades de la zona de\namortiguación militar y luego partes del norte de la Franja de Gaza adyacentes\nal sur de Israel. Este proceso se llevará a cabo gradualmente \"hasta que\nse anexione toda la Franja de Gaza\". El informe también indica que el plan\nha sido \"aprobado por la administración Trump de Estados Unidos\".<b><o:p></o:p></b></p><p class=\"MsoNormal\" style=\"background: rgb(255, 255, 255); color: #444444; font-family: Dosis, Verdana, Arial, &quot;Trebuchet MS&quot;, sans-serif; line-height: normal; margin: 0px 0px 0cm 36pt; outline: 0px; padding: 0px; text-align: justify;\"><span style=\"font-size: 15px;\">FUENTE:</span><a href=\"https://www.zaobao.com.sg/realtime/world/story20250729-7238684?ref=sidebar-realtime\"><span style=\"font-size: xx-small;\">https://www.zaobao.com.sg/realtime/world/story20250729-7238684?ref=sidebar-realtime</span></a></p><p class=\"MsoNormal\" style=\"background: rgb(255, 255, 255); color: #444444; font-family: Dosis, Verdana, Arial, &quot;Trebuchet MS&quot;, sans-serif; font-size: 15px; line-height: normal; margin: 0px 0px 0cm 36pt; outline: 0px; padding: 0px; text-align: justify;\"><br /></p><p class=\"MsoNormal\" style=\"background: rgb(255, 255, 255); color: #444444; font-family: Dosis, Verdana, Arial, &quot;Trebuchet MS&quot;, sans-serif; font-size: 15px; line-height: normal; margin: 0px 0px 0cm 36pt; outline: 0px; padding: 0px; text-align: left;\"><br /></p><p clas