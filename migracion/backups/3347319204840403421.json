 "titulo": "VESTIDOS JOVANI EN MY CECILE BOUTIQUE",
 "fila": null,
 "contenido": "<div id=\"mcb-jovani-widget\">\n\n  <!--PORTADA JOVANI-->\n  <div style=\"font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; margin-bottom: 30px; margin-left: auto; margin-right: auto; max-width: 800px; text-align: center;\">\n    <div style=\"padding: 1em 0px; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiD3MYcaaK4a6J9FrtXX22ZQapgDMH0fbtZwGvK2Z5o50VUx6_XQPZONgLGKNzAUtguEojxKKY-CnG28Re1AFMi9vkVA1LyDCVmCzpGyrq2hdz2qqXkvnHQ90PzcrJ9jOWLwAzQrKq5UvIipHIxcCBnS1sDICyCXD4W_uDumce8cNEse6rnonM9NlW16bE/s2878/43764__d_f.webp\" style=\"margin-left: 1em; margin-right: 1em;\"><img border=\"0\" data-original-height=\"2878\" data-original-width=\"1920\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiD3MYcaaK4a6J9FrtXX22ZQapgDMH0fbtZwGvK2Z5o50VUx6_XQPZONgLGKNzAUtguEojxKKY-CnG28Re1AFMi9vkVA1LyDCVmCzpGyrq2hdz2qqXkvnHQ90PzcrJ9jOWLwAzQrKq5UvIipHIxcCBnS1sDICyCXD4W_uDumce8cNEse6rnonM9NlW16bE/s320/43764__d_f.webp\" width=\"213\" /></a></div><br />\n    <h2 style=\"color: #111111; font-weight: 800; margin-bottom: 15px;\"><span style=\"font-size: medium;\">&nbsp;Colección Jovani en My Cecile Boutique</span></h2>\n    <p style=\"color: #444444; font-size: 16px; line-height: 1.6; margin: 0px auto 20px; max-width: 650px; text-align: justify;\">\n      Jovani es una firma de moda reconocida por sus diseños para ocasiones especiales: vestidos de noche, fiesta y ceremonia con cortes favorecedores y tejidos de calidad. No es alta costura, pero ofrece una excelente relación calidad-precio para quien busca un look elegante sin gastar una fortuna. En esta colección encontrarás desde vestidos largos hasta complementos.\n    </p>\n    \n    <!--AVISO DE CARGA-->\n    <div style=\"background: rgb(255, 248, 225); border-left: 4px solid rgb(243, 156, 18); border-radius: 6px; margin-bottom: 10px; padding: 15px 20px; text-align: left;\">\n      <p style=\"color: #8d6e00; font-size: 13px; margin: 0px;\">\n        ⏳ <strong>Paciencia, por favor.</strong> Los artículos cargan poco a poco. En unos segundos empezarás a verlos aparecer.\n      </p>\n    </div>\n  </div>\n\n  <!--GRID DE PRODUCTOS-->\n  <div id=\"mcb-jovani-grid\" style=\"color: #333333; display: grid; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin: auto; max-width: 1000px;\">\n    <p style=\"color: #999999; grid-column: 1 / -1; text-align: center;\">Cargando artículos de Jovani...</p>\n  </div>\n  \n  <div id=\"mcb-jovani-status\" style=\"color: #999999; font-family: &quot;Segoe UI&quot;, Roboto, Arial, sans-serif; font-size: 13px; margin-top: 20px; text-align: center;\"></div>\n</div>\n\n<style>\n  #mcb-jovani-widget .mcb-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; display: flex; flex-direction: column; }\n  #mcb-jovani-widget .mcb-card img { width: 100%; height: 300px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #fafafa; }\n  #mcb-jovani-widget .mcb-card-title { font-size: 14px; font-weight: 600; margin-bottom: 5px; color: #333; min-height: 40px; }\n  #mcb-jovani-widget .mcb-card-price { font-size: 16px; font-weight: bold; color: #2c3e50; margin-bottom: 10px; }\n  #mcb-jovani-widget .mcb-card-btn { display: block; background: #111; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; margin-top: auto; }\n  #mcb-jovani-widget .mcb-card-btn:hover { background: #333; }\n</style>\n<script>\n  \n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var ARTICULOS = [];\n  var MOSTRADOS = 0;\n  var CARGANDO = false;\n  var PAGINAS = 5;\n\n  function cargar() {\n    var promesas = [];\n    \n    for (var p = 1; p <= PAGINAS; p++) {\n      var pageUrl = p === 1 \n        ? \"https://www.mycecileboutique.com/jovani\"\n        : \"https://www.mycecileboutique.com/jovani?page=\" + p;\n      \n      promesas.push(\n        fetch(proxy + \"?url=\" + encodeURIComponent(pageUrl))\n          .then(function(res) { return res.text(); })\n          .then(function(html) {\n            var urlRegex = /\"url\"\\s*:\\s*\"([^\"]+)\"/g;\n            var match;\n            while ((match = urlRegex.exec(html)) !== null) {\n              if (match[1].indexOf(\"/jovani/\") !== -1 && match[1].indexOf(\"mycecileboutique.com\") !== -1) {\n                ARTICULOS.push({\n                  loc: match[1],\n                  title: \"\",\n                  img: \"\",\n                  price: \"\"\n                });\n              }\n            }\n          })\n      );\n    }\n\n    Promise.all(promesas).then(function() {\n      var vistos = {};\n      ARTICULOS = ARTICULOS.filter(function(p) {\n        if (vistos[p.loc]) return false;\n        vistos[p.loc] = true;\n        return true;\n      });\n\n      ARTICULOS.forEach(function(articulo) {\n        var slug = articulo.loc.split(\"/\").pop();\n        articulo.title = \"Jovani \" + slug.replace(/-/g, \" \").replace(/\\b\\w/g, function(l) { return l.toUpperCase(); });\n      });\n\n      if (ARTICULOS.length === 0) {\n        document.getElementById(\"mcb-jovani-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>No se encontraron artículos.</p>\";\n        return;\n      }\n\n      document.getElementById(\"mcb-jovani-status\").textContent =\n        ARTICULOS.length + \" artículos encontrados. Cargando detalles...\";\n\n      cargarLote();\n    }).catch(function() {\n      document.getElementById(\"mcb-jovani-grid\").innerHTML =\n        \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar.</p>\";\n    });\n  }\n\n  function cargarLote() {\n    if (CARGANDO || MOSTRADOS >= ARTICULOS.length) return;\n    CARGANDO = true;\n\n    var lote = ARTICULOS.slice(MOSTRADOS, MOSTRADOS + 3);\n    var pendientes = lote.length;\n\n    lote.forEach(function(articulo) {\n      fetch(proxy + \"?url=\" + encodeURIComponent(articulo.loc))\n        .then(function(r) { return r.text(); })\n        .then(function(html) {\n          var imgMatch = html.match(/<meta[^>]+property=\"og:image\"[^>]+content=\"([^\"]+)\"/i);\n          var titleMatch = html.match(/<meta[^>]+property=\"og:title\"[^>]+content=\"([^\"]+)\"/i);\n          var priceMatch = html.match(/\"price\"[^:]*:\\s*([\\d.]+)/i);\n\n          if (imgMatch) articulo.img = imgMatch[1];\n          if (titleMatch) articulo.title = titleMatch[1].split(\"|\")[0].trim();\n          if (priceMatch) articulo.price = \"$\" + priceMatch[1];\n        })\n        .catch(function() {})\n        .finally(function() {\n          pendientes--;\n          if (pendientes === 0) {\n            MOSTRADOS += lote.length;\n            renderizar();\n            CARGANDO = false;\n            \n            document.getElementById(\"mcb-jovani-status\").textContent =\n              \"Mostrando \" + MOSTRADOS + \" de \" + ARTICULOS.length + \" artículos\";\n\n            if (MOSTRADOS < ARTICULOS.length) {\n              setTimeout(cargarLote, 2000);\n            } else {\n              document.getElementById(\"mcb-jovani-status\").textContent =\n                \"✅ \" + ARTICULOS.length + \" artículos de Jovani\";\n            }\n          }\n        });\n    });\n  }\n\n  function renderizar() {\n    var html = \"\";\n    for (var i = 0; i < MOSTRADOS; i++) {\n      var articulo = ARTICULOS[i];\n      html +=\n        '<div class=\"mcb-card\">' +\n        (articulo.img ? '<img src=\"' + articulo.img + '\" alt=\"' + articulo.title + '\" loading=\"lazy\">' : '<div style=\"height:300px; background:#f5f5f5; display:flex; align-items:center; justify-content:center; color:#ccc; border-radius:8px;\">📷</div>') +\n        '<div class=\"mcb-card-title\">' + articulo.title + '</div>' +\n        (articulo.price ? '<div class=\"mcb-card-price\">' + articulo.price + '</div>' : '') +\n        '<a class=\"mcb-card-btn\" href=\"' + articulo.loc + '\" target=\"_blank\">🛒 VER ARTÍCULO</a>' +\n        '</div>';\n    }\n    \n    if (MOSTRADOS >= ARTICULOS.length) {\n      html +=\n        '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n        '<a href=\"https://www.mycecileboutique.com/jovani?page=6\" target=\"_blank\" style=\"display: inline-block; background: #c0392b; color: #fff; padding: 16px 40px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; font-family: \\'Segoe UI\\', Roboto, Arial, sans-serif;\">🛍️ VER MÁS ARTÍCULOS EN LA WEB OFICIAL</a>' +\n        '<p style=\"color: #999; font-size: 12px; margin-top: 8px; font-family: \\'Segoe UI\\', Roboto, Arial, sans-serif;\">Continúa explorando el catálogo completo de Jovani en MyCecileBoutique</p>' +\n        '</div>';\n    }\n    \n    document.getElementById(\"mcb-jovani-grid\").innerHTML = html;\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargar);\n  } else {\n    cargar();\n  }\n})();\n</script>\nSI NO ESTÁ DISPONIBLE TU TALLA, COLOR O NO ENVÍAN A TU DESTINO CONTÁCTA EL BLOG: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a>",
 "fecha_copia": "2026-10-01T05:51:27.265Z"
}