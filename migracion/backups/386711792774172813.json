 "titulo": "NATORI",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhi5eYBRTq9mzRVrWGlONLlCUR3xSgco_T5KhgxyEiNoqfQ5KvH9_TYmoMrbiFKhfw5el7SZTL9-M-uzIwdAIC8eO3k1-sXSdlNk7cmRKSX9arR6fHsoBvhyphenhyphent0T8i7EUpsy-_IcaVXFmln9EOV8qd022JrAPlJNYaeegg8liMpMhRq5XwelKiVujDG0tus/s2764/3d4ea79849e393733a5a17688f7b.jpg\" style=\"display: block; margin-left: 1em; margin-right: 1em; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" data-original-height=\"2764\" data-original-width=\"1920\" height=\"320\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhi5eYBRTq9mzRVrWGlONLlCUR3xSgco_T5KhgxyEiNoqfQ5KvH9_TYmoMrbiFKhfw5el7SZTL9-M-uzIwdAIC8eO3k1-sXSdlNk7cmRKSX9arR6fHsoBvhyphenhyphent0T8i7EUpsy-_IcaVXFmln9EOV8qd022JrAPlJNYaeegg8liMpMhRq5XwelKiVujDG0tus/s320/3d4ea79849e393733a5a17688f7b.jpg\" /></a></div>\n\n<div style=\"text-align: justify;\">Natori es una firma de lujo fundada por la diseñadora filipino-estadounidense Josie Natori, reconocida por fusionar la sofisticación occidental con la riqueza artística de las tradiciones orientales. Desde 1977, la marca ha desarrollado colecciones de lencería, moda prêt-à-porter, ropa de descanso y accesorios caracterizadas por la calidad de sus tejidos, la elegancia de sus siluetas y una cuidada atención al detalle. Su estilo distintivo, definido por el equilibrio entre confort, feminidad y refinamiento, ha convertido a Natori en un referente internacional del lujo contemporáneo.</div>\n\n<!--more-->\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://www.natori.com/?utm_source=ropaycomplementos&amp;utm_medium=boton_oficial&amp;utm_campaign=catalogo_natori\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: &quot;Helvetica Neue&quot;, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=ropaycomplementos&utm_medium=tarjeta_producto&utm_campaign=catalogo_natori';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\nvar hayMas = true;\nvar cola = false;\nvar paginaActual = 1;\nvar SITEMAP_URL = 'https://www.natori.com/sitemap.xml';\nvar PROXY_ANTIGUO = 'https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec';\n\n/* --- AÑADIDO: tercera fuente directa (Shopify) y control de fallos --- */\nvar ORIGEN_TIENDA = SITEMAP_URL.split('/').slice(0, 3).join('/');\nvar SHOPIFY_LIMITE = 24;\nvar modoShopify = false;\nvar paginaShopify = 1;\nvar yaPintado = false;\n\nfunction fetchConTimeout(url, ms){\n  var c = new AbortController();\n  var t = setTimeout(function(){ c.abort(); }, ms);\n  return fetch(url, { signal: c.signal }).then(function(r){ clearTimeout(t); return r; }, function(e){ clearTimeout(t); throw e; });\n}\nfunction esperar(ms){ return new Promise(function(res){ setTimeout(res, ms); }); }\nfunction tieneProductos(data){ return data && data.productos && data.productos.length > 0; }\n\nfunction terminarSinMas(){\n  hayMas = false;\n  document.getElementById('loader').style.display = 'none';\n  document.getElementById('web-oficial-container').style.display = 'block';\n  cargando = false;\n}\n\nfunction pedirNas(intento){\n  var urlNas = 'https://carmenprofe.synology.me/generador_htmlrobots/generar_o_servir.php?url=' + encodeURIComponent(SITEMAP_URL) + '&pagina=' + paginaActual;\n  return fetchConTimeout(urlNas, 8000)\n    .then(function(r){\n      return r.json().then(function(data){\n        if (r.status === 503 && intento < 2) {\n          var s = (data && data.reintentar_tras_segundos) ? data.reintentar_tras_segundos : 3;\n          return esperar(Math.min(s, 5) * 1000).then(function(){ return pedirNas(intento + 1); });\n        }\n        if (tieneProductos(data)) return data;\n        throw new Error('NAS sin resultados');\n      });\n    });\n}\n\nfunction pedirProxyAntiguo(){\n  return fetchConTimeout(PROXY_ANTIGUO + '?url=' + encodeURIComponent(SITEMAP_URL) + '&pagina=' + paginaActual, 20000)\n    .then(function(r){ return r.json(); })\n    .then(function(data){\n      if (tieneProductos(data)) return data;\n      throw new Error('Proxy antiguo sin resultados' + (data && data.error ? ': ' + data.error : ''));\n    });\n}\n\nfunction limpiarTexto(html){\n  var d = document.createElement('div');\n  d.innerHTML = html || '';\n  var t = (d.textContent || '').replace(/\\s+/g, ' ').trim();\n  return t.length > 90 ? t.slice(0, 90) + '...' : t;\n}\n\nfunction pedirShopify(){\n  return fetchConTimeout(ORIGEN_TIENDA + '/products.json?limit=' + SHOPIFY_LIMITE + '&page=' + paginaShopify, 15000)\n    .then(function(r){ if (!r.ok) throw new Error('Shopify HTTP ' + r.status); return r.json(); })\n    .then(function(j){\n      var lista = (j && j.products) ? j.products : [];\n      var productos = lista.map(function(p){\n        var v = (p.variants && p.variants[0]) ? p.variants[0] : {};\n        var img = (p.images && p.images[0]) ? p.images[0].src : '';\n        return {\n          titulo: (p.title || '').replace(/\"/g, '&quot;'),\n          url: ORIGEN_TIENDA + '/products/' + p.handle,\n          imagen: img,\n          precio: v.price ? ('US$ ' + v.price) : '',\n          descripcion: limpiarTexto(p.body_html)\n        };\n      }).filter(function(p){ return p.titulo && p.imagen; });\n      paginaShopify++;\n      return { productos: productos, hayMas: lista.length === SHOPIFY_LIMITE };\n    });\n}\n/* --- FIN AÑADIDO --- */\n\nfunction pintarPagina(data){\n  document.getElementById('tienda-catalogo').innerHTML += data.productos.map(crearTarjeta).join('');\n  hayMas = data.hayMas;\n  paginaActual++;\n  yaPintado = true;\n  if(!hayMas) document.getElementById('web-oficial-container').style.display = 'block';\n  document.getElementById('loader').style.display = 'none';\n  cargando = false;\n  if(cola){ cola = false; cargarProductos(); }\n}\n\nfunction cargarProductos(){\n  if(cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById('loader').style.display = 'block';\n\n  if (modoShopify) {\n    pedirShopify()\n      .then(function(data){ if (data.productos.length) pintarPagina(data); else terminarSinMas(); })\n      .catch(function(e){ console.log(e); terminarSinMas(); });\n    return;\n  }\n\n  pedirNas(0)\n    .then(pintarPagina)\n    .catch(function(err){\n      console.log(err);\n      pedirProxyAntiguo()\n        .then(pintarPagina)\n        .catch(function(err2){\n          console.log(err2);\n          if (yaPintado) { terminarSinMas(); return; }\n          modoShopify = true;\n          pedirShopify()\n            .then(function(data){ if (data.productos.length) pintarPagina(data); else terminarSinMas(); })\n            .catch(function(err3){ console.log(err3); terminarSinMas(); });\n        });\n    });\n}\n\nfunction iniciarCatalogo(){\n  cargarProductos();\n  var observer = new IntersectionObserver(function(entries){\n    if(entries[0].isIntersecting){ if(cargando){ cola=true; return; } cargarProductos(); }\n  }, {rootMargin:'250px'});\n  observer.observe(document.getElementById('sentinel'));\n}\nif (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciarCatalogo);\nelse iniciarCatalogo();\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-09-28T17:39:27.552Z"
}