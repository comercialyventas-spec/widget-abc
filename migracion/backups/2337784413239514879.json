 "titulo": "DEPORTES RTVE",
 "fila": 2433,
 "contenido": "<div id=\"rtve-dep-widget\">\n  <div id=\"rtve-dep-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"rtve-dep-lista\">Cargando noticias de Deportes...</div>\n</div>\n\n<style>\n  #rtve-dep-widget { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #rtve-dep-widget .rtve-featured { text-align: center; margin-bottom: 40px; }\n  #rtve-dep-widget .rtve-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  #rtve-dep-widget .rtve-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #rtve-dep-widget .rtve-title-featured:hover { color: #c0392b; }\n  #rtve-dep-widget .rtve-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #rtve-dep-widget .rtve-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  #rtve-dep-widget .rtve-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #rtve-dep-widget .rtve-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #rtve-dep-widget .rtve-item-title:hover { color: #c0392b; }\n  #rtve-dep-widget .rtve-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    #rtve-dep-widget .rtve-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #rtve-dep-widget .rtve-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function() {\n  function cargarDeportes() {\n    var sitemapUrl = \"https://www.rtve.es/sitemaps/sitemaps-news.xml\";\n    var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n    var url = proxy + \"?url=\" + encodeURIComponent(sitemapUrl);\n\n    fetch(url)\n      .then(function(res) { return res.text(); })\n      .then(function(text) {\n        var parser = new DOMParser();\n        var xmlDoc = parser.parseFromString(text, \"text/xml\");\n        var urls = Array.from(xmlDoc.querySelectorAll(\"url\"));\n        \n        if (urls.length === 0) throw new Error(\"Sin resultados\");\n        \n        var todas = urls.map(function(urlElement) {\n          var loc = urlElement.querySelector(\"loc\")?.textContent || \"\";\n          var title = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"title\")[0]?.textContent || \"\";\n          var pubDate = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"publication_date\")[0]?.textContent || \"\";\n          var name = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"name\")[0]?.textContent || \"\";\n          return { loc: loc, title: title, pubDate: pubDate, name: name };\n        }).filter(function(n) { return n.title; });\n        \n        // Filtrar SOLO por sección \"RTVE Deportes\"\n        var noticias = todas.filter(function(n) {\n          return n.name.toLowerCase().indexOf(\"deportes\") !== -1;\n        }).slice(0, 6);\n\n        if (noticias.length === 0) {\n          document.getElementById(\"rtve-dep-widget\").innerHTML =\n            \"<p style='color:#666; text-align:center; padding:30px;'>No hay noticias de Deportes ahora mismo.</p>\";\n          return;\n        }\n\n        function renderizar() {\n          var destacadoHtml = \"\";\n          var listaHtml = \"\";\n\n          noticias.forEach(function(noticia, index) {\n            var fecha = new Date(noticia.pubDate).toLocaleDateString('es-ES',\n              { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n\n            if (index === 0) {\n              destacadoHtml =\n                '<div class=\"rtve-featured\">' +\n                (noticia.img ? '<a href=\"' + noticia.loc + '\" target=\"_blank\"><img src=\"' + noticia.img + '\" class=\"rtve-img-featured\" alt=\"' + noticia.title + '\"></a>' : '') +\n                '<a class=\"rtve-title-featured\" href=\"' + noticia.loc + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"rtve-meta\">RTVE DEPORTES · ' + fecha + '</div>' +\n                '</div>';\n            } else {\n              listaHtml +=\n                '<div class=\"rtve-item\">' +\n                (noticia.img ? '<div class=\"rtve-img-container\"><img src=\"' + noticia.img + '\" alt=\"' + noticia.title + '\"></div>' : '') +\n                '<div>' +\n                '<a class=\"rtve-item-title\" href=\"' + noticia.loc + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"rtve-meta\">RTVE DEPORTES · ' + fecha + '</div>' +\n                '</div>' +\n                '</div>';\n            }\n          });\n\n          document.getElementById(\"rtve-dep-destacada\").innerHTML = destacadoHtml;\n          document.getElementById(\"rtve-dep-lista\").innerHTML = listaHtml;\n        }\n\n        renderizar();\n\n        noticias.forEach(function(noticia) {\n          if (noticia.img) return;\n          fetch(proxy + \"?url=\" + encodeURIComponent(noticia.loc))\n            .then(function(r) { return r.text(); })\n            .then(function(html) {\n              var match = html.match(/<meta[^>]+property=\"og:image\"[^>]+content=\"([^\"]+)\"/i);\n              if (match) {\n                noticia.img = match[1];\n                renderizar();\n              }\n            })\n            .catch(function() {});\n        });\n\n      })\n      .catch(function() {\n        document.getElementById(\"rtve-dep-widget\").innerHTML =\n          \"<p style='color:red'>Error al cargar noticias.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarDeportes);\n  } else {\n    cargarDeportes();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-28T18:38:51.320Z"
}