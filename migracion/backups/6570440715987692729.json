 "titulo": "BIMBA Y LOLA",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjZaSHMjvfTbwW-YFY-X600-VQ41zoo5GXgA-kzZY6hflAB0kma-TqpdcUwsxuUjvoak6VTzA88NyDM95xv5PD7NImExdw1CNLdZKkzgF4tAsQSHNV0e-xikPWaDnPJii7ElBrmfQpvTyApJ9MDr9doUvVrEEvX7bBqlQ5Pv5bF-NxAgjo3tDe5HTGpP94/s1920/videoframe_10186.png\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" data-original-height=\"1080\" data-original-width=\"1920\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjZaSHMjvfTbwW-YFY-X600-VQ41zoo5GXgA-kzZY6hflAB0kma-TqpdcUwsxuUjvoak6VTzA88NyDM95xv5PD7NImExdw1CNLdZKkzgF4tAsQSHNV0e-xikPWaDnPJii7ElBrmfQpvTyApJ9MDr9doUvVrEEvX7bBqlQ5Pv5bF-NxAgjo3tDe5HTGpP94/s320/videoframe_10186.png\" width=\"320\" /></a><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjZaSHMjvfTbwW-YFY-X600-VQ41zoo5GXgA-kzZY6hflAB0kma-TqpdcUwsxuUjvoak6VTzA88NyDM95xv5PD7NImExdw1CNLdZKkzgF4tAsQSHNV0e-xikPWaDnPJii7ElBrmfQpvTyApJ9MDr9doUvVrEEvX7bBqlQ5Pv5bF-NxAgjo3tDe5HTGpP94/s1920/videoframe_10186.png\" style=\"display: block; padding: 1em 0px; text-align: justify;\"><p data-end=\"319\" data-start=\"0\"><span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\">Bimba y Lola</span> es una marca española de moda fundada en 2005 en Galicia, conocida por su estilo moderno, creativo y con fuerte identidad visual. Sus colecciones combinan prendas contemporáneas con diseños llamativos, colores y estampados originales, situándose en el segmento de “lujo accesible”.</p>\n<p data-end=\"528\" data-is-last-node=\"\" data-is-only-node=\"\" data-start=\"321\">Se ha expandido internacionalmente con ropa, bolsos y accesorios, manteniendo una estética reconocible y actual, orientada a un público urbano que busca diseño con personalidad sin ser excesivamente clásico.</p></a></div>\n<div id=\"tienda-catalogo\"></div>\n\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">\n  Cargando...\n</div>\n\n<style>\n#tienda-catalogo{\n  display:grid;\n  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));\n  gap:20px;\n  font-family:Arial;\n}\n\n.producto-card{\n  border:1px solid #eaeaea;\n  padding:15px;\n  border-radius:10px;\n  text-align:center;\n  background:#fff;\n}\n\n.producto-card img{\n  width:100%;\n  height:200px;\n  object-fit:cover;\n  border-radius:8px;\n}\n\n.producto-title{\n  font-size:14px;\n  margin:10px 0;\n  font-weight:600;\n  line-height:1.3;\n}\n\n.producto-link{\n  display:block;\n  background:#111;\n  color:#fff;\n  padding:10px;\n  text-decoration:none;\n  border-radius:6px;\n  font-size:12px;\n  font-weight:bold;\n}\n</style>\n\n<script>\n\nvar TIENDA_URL = \"https://www.bimbaylola.com\";\n\nvar APPS_SCRIPT = \"https://script.google.com/macros/s/AKfycbwAz-q8cQuhZsdVzfl5bY9my_rzawc1B3lW4b8fAc1jtUgC9ZQcC-lg2iGHp5bq4KM6YQ/exec\";\n\nvar paginaActual = 1;\nvar cargando = false;\nvar hayMas = true;\nvar cola = false;\n\n// 🔥 limpiar URLs\nfunction limpiarUrl(url){\n  return url ? url.replace(/&amp;/g,\"&\").replace(/&apos;/g,\"'\") : \"\";\n}\n\n// 🔥 título limpio definitivo (SIN es_en, es_es, etc.)\nfunction obtenerTitulo(p){\n\n  if(p.titulo && !p.titulo.includes(\"http\")){\n    return p.titulo;\n  }\n\n  try {\n\n    var url = p.url || \"\";\n\n    url = url\n      .replace(\"https://www.bimbaylola.com\", \"\")\n      .toLowerCase()\n\n      // 🔥 eliminar idiomas\n      .replace(/\\/es_es\\//g, \" \")\n      .replace(/\\/es_en\\//g, \" \")\n      .replace(/\\/en_es\\//g, \" \")\n      .replace(/\\/es_es/g, \" \")\n      .replace(/\\/es_en/g, \" \")\n      .replace(/\\/en_es/g, \" \")\n\n      // limpieza general\n      .replace(/\\//g, \" \")\n      .replace(/\\.html/g, \" \")\n      .replace(/\\d{3,}/g, \" \")\n      .replace(/\\./g, \" \")\n      .replace(/\\s+/g, \" \")\n      .trim();\n\n    return url\n      .replace(/\\b\\w/g, l => l.toUpperCase());\n\n  } catch(e){\n    return \"Producto\";\n  }\n}\n\n// 🔥 tarjeta producto\nfunction crearTarjeta(p){\n\n  var titulo = obtenerTitulo(p);\n  var url = limpiarUrl(p.url);\n  var img = limpiarUrl(p.imagen);\n\n  return `\n    <div class=\"producto-card\">\n\n      <img src=\"${img}\" loading=\"lazy\">\n\n      <div class=\"producto-title\">\n        ${titulo}\n      </div>\n\n      <a class=\"producto-link\"\n         href=\"${url}\"\n         target=\"_blank\"\n         onclick=\"registrarClic('${titulo.replace(/'/g,\"\\\\'\")}','${url}','${p.tienda}')\">\n\n        Comprar\n\n      </a>\n\n    </div>\n  `;\n}\n\n// 🔥 carga productos\nasync function cargarProductos(){\n\n  if(cargando || !hayMas) return;\n\n  cargando = true;\n\n  document.getElementById(\"loader\").style.display = \"block\";\n\n  try {\n\n    var res = await fetch(\n      APPS_SCRIPT +\n      \"?tienda=\" + encodeURIComponent(TIENDA_URL) +\n      \"&pagina=\" + paginaActual\n    );\n\n    var data = await res.json();\n\n    var cont = document.getElementById(\"tienda-catalogo\");\n\n    cont.innerHTML += data.productos.map(crearTarjeta).join(\"\");\n\n    hayMas = data.hayMas;\n\n    paginaActual++;\n\n  } catch(e){\n    console.log(\"error carga\", e);\n  }\n\n  document.getElementById(\"loader\").style.display = \"none\";\n\n  cargando = false;\n\n  if(cola){\n    cola = false;\n    cargarProductos();\n  }\n}\n\n// 🔥 infinite scroll seguro\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n\n  cargarProductos();\n\n  var sentinel = document.getElementById(\"sentinel\");\n\n  var observer = new IntersectionObserver((entries) => {\n\n    if(entries[0].isIntersecting){\n\n      if(cargando){\n        cola = true;\n        return;\n      }\n\n      cargarProductos();\n    }\n\n  }, { rootMargin: \"250px\" });\n\n  observer.observe(sentinel);\n\n});\n\n// 🔥 tracking clics (funciona en Blogger)\nasync function registrarClic(titulo, url, tienda){\n\n  try {\n\n    await fetch(APPS_SCRIPT, {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\"\n      },\n      body: JSON.stringify({\n        tienda: tienda,\n        titulo: titulo,\n        url: url\n      }),\n      mode: \"no-cors\"\n    });\n\n  } catch(e){\n    console.log(\"tracking error\", e);\n  }\n}\n\n</script>\n\n<div style=\"font-size: 16px; margin-top: 30px;\">\n\n  <a href=\"https://www.bimbaylola.com\" target=\"_blank\">\n    <b>IR A LA WEB OFICIAL</b>\n  </a>\n\n  <div style=\"margin-top: 10px;\"><span style=\"font-size: xx-large;\">SI ESTÁ AGOTADA TU TALLA, COLOR&nbsp; O NO ENVÍAN A TU DESTINO CONTÁCTANOS:&nbsp;</span><a href=\"mailto:comercialyventas@gmail.com\" style=\"font-size: xx-large;\">comercialyventas@gmail.com</a></div>\n\n</div>",
 "fecha_copia": "2026-09-30T19:53:30.657Z"
}