 "titulo": "BALONCESTO MARCA",
 "fila": 2423,
 "contenido": "<div id=\"marca-basket-widget\">\n  <div id=\"marca-basket-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"marca-basket-lista\">Cargando noticias de Baloncesto...</div>\n</div>\n\n<style>\n  #marca-basket-widget { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #marca-basket-widget .mb-featured { text-align: center; margin-bottom: 40px; }\n  #marca-basket-widget .mb-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  #marca-basket-widget .mb-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #marca-basket-widget .mb-title-featured:hover { color: #c0392b; }\n  #marca-basket-widget .mb-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #marca-basket-widget .mb-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  #marca-basket-widget .mb-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #marca-basket-widget .mb-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #marca-basket-widget .mb-item-title:hover { color: #c0392b; }\n  #marca-basket-widget .mb-author { font-size: 12px; color: #888; margin-bottom: 8px; }\n  #marca-basket-widget .mb-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    #marca-basket-widget .mb-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #marca-basket-widget .mb-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function() {\n  function cargarMarcaBasket() {\n    var rssUrl = \"https://www.marca.com/rss/baloncesto.xml\";\n    var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n    var url = proxy + \"?url=\" + encodeURIComponent(rssUrl);\n\n    fetch(url)\n      .then(function(res) { return res.text(); })\n      .then(function(text) {\n        var parser = new DOMParser();\n        var xmlDoc = parser.parseFromString(text, \"text/xml\");\n        var items = Array.from(xmlDoc.querySelectorAll(\"item\"));\n        \n        if (items.length === 0) throw new Error(\"Sin resultados\");\n        \n        var noticias = items.slice(0, 6).map(function(item) {\n          var title = item.querySelector(\"title\")?.textContent?.trim() || \"\";\n          var link = item.querySelector(\"link\")?.textContent?.trim() || \"\";\n          var pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n          var author = item.querySelector(\"dc\\\\:creator\")?.textContent?.trim() || \"MARCA\";\n          \n          var img = \"\";\n          var mediaContent = item.querySelector(\"media\\\\:content\") ||\n                            item.getElementsByTagNameNS(\"http://search.yahoo.com/mrss/\", \"content\")[0];\n          if (mediaContent) {\n            img = mediaContent.getAttribute(\"url\") || \"\";\n          }\n          \n          return { title: title, link: link, pubDate: pubDate, author: author, img: img };\n        }).filter(function(n) { return n.title; });\n\n        function renderizar() {\n          var destacadoHtml = \"\";\n          var listaHtml = \"\";\n\n          noticias.forEach(function(noticia, index) {\n            var fecha = new Date(noticia.pubDate).toLocaleDateString('es-ES',\n              { day: '2-digit', month: 'short', year: 'numeric' });\n\n            if (index === 0) {\n              destacadoHtml =\n                '<div class=\"mb-featured\">' +\n                (noticia.img ? '<a href=\"' + noticia.link + '\" target=\"_blank\"><img src=\"' + noticia.img + '\" class=\"mb-img-featured\" alt=\"' + noticia.title + '\"></a>' : '') +\n                '<a class=\"mb-title-featured\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"mb-author\">Por ' + noticia.author + '</div>' +\n                '<div class=\"mb-meta\">MARCA BALONCESTO · ' + fecha + '</div>' +\n                '</div>';\n            } else {\n              listaHtml +=\n                '<div class=\"mb-item\">' +\n                (noticia.img ? '<div class=\"mb-img-container\"><img src=\"' + noticia.img + '\" alt=\"' + noticia.title + '\"></div>' : '') +\n                '<div>' +\n                '<a class=\"mb-item-title\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"mb-author\">Por ' + noticia.author + '</div>' +\n                '<div class=\"mb-meta\">' + fecha + '</div>' +\n                '</div>' +\n                '</div>';\n            }\n          });\n\n          document.getElementById(\"marca-basket-destacada\").innerHTML = destacadoHtml;\n          document.getElementById(\"marca-basket-lista\").innerHTML = listaHtml;\n        }\n\n        renderizar();\n\n      })\n      .catch(function() {\n        document.getElementById(\"marca-basket-widget\").innerHTML =\n          \"<p style='color:red'>Error al cargar noticias de MARCA.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarMarcaBasket);\n  } else {\n    cargarMarcaBasket();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-26T15:40:08.358Z"
}