 "url": "https://periodicosaliazon.blogspot.com/2026/05/portada-rtve-noticias.html",
 "path": "/2026/05/portada-rtve-noticias.html",
 "titulo": "PORTADA RTVE NOTICIAS",
 "fila": 2431,
 "contenido": "<div id=\"rtve-container\">\n  <div id=\"rtve-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"rtve-lista\">Cargando noticias de RTVE...</div>\n</div>\n\n<style>\n  #rtve-container { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  .rtve-featured { text-align: center; margin-bottom: 40px; }\n  .rtve-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  .rtve-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  .rtve-title-featured:hover { color: #c0392b; }\n  .rtve-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  .rtve-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  .rtve-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  .rtve-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  .rtve-item-title:hover { color: #c0392b; }\n  .rtve-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    .rtve-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    .rtve-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\nasync function cargarRTVE() {\n  const sitemapUrl = \"https://www.rtve.es/sitemaps/sitemaps-news.xml\";\n  const proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  const url = `${proxy}?url=${encodeURIComponent(sitemapUrl)}`;\n\n  try {\n    const res = await fetch(url);\n    const text = await res.text();\n    const parser = new DOMParser();\n    const xmlDoc = parser.parseFromString(text, \"text/xml\");\n    \n    const urls = Array.from(xmlDoc.querySelectorAll(\"url\"));\n    if (urls.length === 0) throw new Error(\"Sin resultados\");\n    \n    const noticias = urls.slice(0, 6).map(urlElement => {\n      const loc = urlElement.querySelector(\"loc\")?.textContent || \"\";\n      const title = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"title\")[0]?.textContent || \"\";\n      const pubDate = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"publication_date\")[0]?.textContent || \"\";\n      const name = urlElement.getElementsByTagNameNS(\"http://www.google.com/schemas/sitemap-news/0.9\", \"name\")[0]?.textContent || \"RTVE\";\n      return { loc, title, pubDate, name };\n    }).filter(n => n.title);\n\n    // Mostrar noticias SIN imagen primero\n    function renderizar(noticiasConImagen) {\n      let destacadoHtml = \"\";\n      let listaHtml = \"\";\n\n      noticiasConImagen.forEach((noticia, index) => {\n        const fecha = new Date(noticia.pubDate).toLocaleDateString('es-ES',\n          { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });\n\n        if (index === 0) {\n          destacadoHtml = `\n            <div class=\"rtve-featured\">\n              <a href=\"${noticia.loc}\" target=\"_blank\">\n                ${noticia.img ? `<img src=\"${noticia.img}\" class=\"rtve-img-featured\" alt=\"${noticia.title}\">` : \"\"}\n              </a>\n              <a class=\"rtve-title-featured\" href=\"${noticia.loc}\" target=\"_blank\">${noticia.title}</a>\n              <div class=\"rtve-meta\">${noticia.name} · ${fecha}</div>\n            </div>`;\n        } else {\n          listaHtml += `\n            <div class=\"rtve-item\">\n              ${noticia.img ? `<div class=\"rtve-img-container\"><img src=\"${noticia.img}\" alt=\"${noticia.title}\"></div>` : \"\"}\n              <div>\n                <a class=\"rtve-item-title\" href=\"${noticia.loc}\" target=\"_blank\">${noticia.title}</a>\n                <div class=\"rtve-meta\">${noticia.name} · ${fecha}</div>\n              </div>\n            </div>`;\n        }\n      });\n\n      document.getElementById(\"rtve-destacada\").innerHTML = destacadoHtml;\n      document.getElementById(\"rtve-lista\").innerHTML = listaHtml;\n    }\n\n    // Renderizar sin imágenes (carga instantánea)\n    renderizar(noticias.map(n => ({...n, img: \"\"})));\n\n    // Cargar imágenes UNA POR UNA (sin saturar el proxy)\n    for (let i = 0; i < noticias.length; i++) {\n      try {\n        const imgRes = await fetch(`${proxy}?url=${encodeURIComponent(noticias[i].loc)}`);\n        const html = await imgRes.text();\n        const match = html.match(/<meta[^>]+property=\"og:image\"[^>]+content=\"([^\"]+)\"/i);\n        if (match) {\n          noticias[i].img = match[1];\n          // Actualizar solo esta noticia\n          renderizar([...noticias]);\n        }\n      } catch(e) {\n        console.log(\"Sin imagen para:\", noticias[i].title.substring(0, 40));\n      }\n    }\n\n  } catch (error) {\n    document.getElementById(\"rtve-container\").innerHTML =\n      \"<p style='color:red'>Error al cargar las noticias de RTVE. Inténtalo más tarde.</p>\";\n    console.error(error);\n  }\n}\n\ncargarRTVE();\n</script>",
 "fecha_copia": "2026-09-28T18:38:38.506Z"
}