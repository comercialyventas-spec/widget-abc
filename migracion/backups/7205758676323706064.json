 "path": "/2026/05/cargando-ofertas-por-favor-espera_01889922284.html",
 "titulo": "",
 "fila": null,
 "contenido": "<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando ofertas, por favor espera...</div>\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://alsa.wd3.myworkdayjobs.com/Alsa\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: 'Helvetica Neue', sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">\n    Ver todas las ofertas\n  </a>\n</div>\n<style>\n#tienda-catalogo table{width:100%;border-collapse:separate;border-spacing:10px;}\n#tienda-catalogo td{width:33%;vertical-align:top;border:1px solid #eaeaea;padding:12px;border-radius:10px;text-align:center;background:#fff;}\n#tienda-catalogo td img{width:100%;height:160px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:13px;margin:8px 0;font-weight:600;word-break:break-word;}\n.producto-date{font-size:11px;color:#999;margin-bottom:8px;}\n.producto-link{display:block;background:#111;color:#fff;padding:8px;text-decoration:none;border-radius:6px;font-size:11px;font-weight:bold;}\n</style>\n<script>\nvar SITEMAP_URL = \"https://alsa.wd3.myworkdayjobs.com/Alsa/siteMap.xml\";\nvar APPS_SCRIPT = \"https://script.google.com/macros/s/AKfycbw-rTAN1a9_8SBUwpub-qQnma74-rLcpXX2A3Bwps-cKZuNmxxO48tqjQipZcfIWMFgrQ/exec\";\nvar paginaActual = 1;\nvar cargando = false;\nvar hayMas = true;\nvar cola = false;\nvar filaActual = null;\nvar contadorFila = 0;\nfunction crearOActualizarTabla(p) {\n  var tabla = document.querySelector(\"#tienda-catalogo table\");\n  if (!tabla) {\n    tabla = document.createElement(\"table\");\n    document.getElementById(\"tienda-catalogo\").appendChild(tabla);\n  }\n  if (contadorFila % 3 === 0) {\n    filaActual = document.createElement(\"tr\");\n    tabla.appendChild(filaActual);\n  }\n  var td = document.createElement(\"td\");\n  td.innerHTML =\n    (p.imagen ? '<img src=\"' + p.imagen + '\" loading=\"lazy\" alt=\"' + p.titulo + '\" onerror=\"this.style.display=\\'none\\'\">' : '') +\n    '<div class=\"producto-title\">' + p.titulo + '</div>' +\n    (p.lastmod ? '<div class=\"producto-date\">Actualizado: ' + p.lastmod + '</div>' : '') +\n    '<a class=\"producto-link\" href=\"' + p.url + '\" target=\"_blank\">Ver oferta</a>';\n  filaActual.appendChild(td);\n  contadorFila++;\n}\nasync function cargarProductos(){\n  if(cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById(\"loader\").style.display = \"block\";\n  try {\n    var res = await fetch(APPS_SCRIPT + \"?sitemap=\" + encodeURIComponent(SITEMAP_URL) + \"&pagina=\" + paginaActual);\n    var data = await res.json();\n    data.productos.forEach(function(p){ crearOActualizarTabla(p); });\n    hayMas = data.hayMas;\n    paginaActual++;\n    if(!hayMas) document.getElementById(\"web-oficial-container\").style.display = \"block\";\n  } catch(e){ console.log(e); }\n  document.getElementById(\"loader\").style.display = \"none\";\n  cargando = false;\n  if(cola){ cola = false; cargarProductos(); }\n}\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n  cargarProductos();\n  var observer = new IntersectionObserver(function(entries){\n    if(entries[0].isIntersecting){ if(cargando){ cola=true; return; } cargarProductos(); }\n  }, {rootMargin:\"250px\"});\n  observer.observe(document.getElementById(\"sentinel\"));\n});\n</script>\n<div><br /></div><a href=\"https://alsa.wd3.myworkdayjobs.com/Alsa\" target=\"_blank\"><b>VER TODAS LAS OFERTAS</b></a>\n<div><br /></div>\n<div><span style=\"font-size: medium;\">¿TIENES DUDAS SOBRE ALGUNA OFERTA? CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-10-03T10:41:27.303Z"
}