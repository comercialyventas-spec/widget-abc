{
 "id": "5452307371590317297",
 "url": "https://periodicosaliazon.blogspot.com/2026/05/cargando-mas-noticias.html",
 "path": "/2026/05/cargando-mas-noticias.html",
 "titulo": "NOTICIAS 20 MINUTOS",
 "fila": 214,
 "contenido": "<div id=\"widget-20minutos\">\n\n  <div id=\"noticia-destacada\"></div>\n\n  <div id=\"lista-noticias\"></div>\n\n  <!-- trigger infinito -->\n  <div id=\"infinite-trigger\"></div>\n\n  <div id=\"loader\">\n    Cargando más noticias...\n  </div>\n\n</div>\n\n<style>\n#widget-20minutos{\n  max-width:900px;\n  margin:auto;\n  font-family:Arial,sans-serif;\n  color:#222;\n}\n\n/* DESTACADA */\n#widget-20minutos .featured{\n  margin-bottom:40px;\n}\n\n#widget-20minutos .featured img{\n  width:100%;\n  height:420px;\n  object-fit:cover;\n  border-radius:10px;\n}\n\n#widget-20minutos .featured-title{\n  display:block;\n  margin-top:15px;\n  font-size:32px;\n  font-weight:700;\n  line-height:1.2;\n  text-decoration:none;\n  color:#111;\n}\n\n#widget-20minutos .featured-title:hover{\n  color:#c62828;\n}\n\n#widget-20minutos .meta{\n  margin-top:10px;\n  color:#777;\n  font-size:13px;\n}\n\n/* ITEMS */\n#widget-20minutos .item{\n  display:flex;\n  gap:20px;\n  padding:22px 0;\n  border-bottom:1px solid #eee;\n}\n\n#widget-20minutos .thumb{\n  width:220px;\n  height:130px;\n  overflow:hidden;\n  border-radius:8px;\n  flex-shrink:0;\n}\n\n#widget-20minutos .thumb img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n}\n\n#widget-20minutos .content{\n  flex:1;\n}\n\n#widget-20minutos .title{\n  display:block;\n  font-size:22px;\n  font-weight:700;\n  line-height:1.3;\n  text-decoration:none;\n  color:#111;\n  margin-bottom:10px;\n}\n\n#widget-20minutos .title:hover{\n  color:#c62828;\n}\n\n#widget-20minutos .date{\n  color:#999;\n  font-size:12px;\n}\n\n/* loader */\n#loader{\n  text-align:center;\n  padding:30px;\n  color:#777;\n  display:none;\n}\n\n#infinite-trigger{\n  height:20px;\n}\n\n/* móvil */\n@media(max-width:700px){\n\n  #widget-20minutos .item{\n    flex-direction:column;\n  }\n\n  #widget-20minutos .thumb{\n    width:100%;\n    height:220px;\n  }\n\n  #widget-20minutos .featured img{\n    height:250px;\n  }\n\n  #widget-20minutos .featured-title{\n    font-size:26px;\n  }\n\n  #widget-20minutos .title{\n    font-size:20px;\n  }\n\n}\n</style>\n\n<script>\n(async function(){\n\n  const rssUrl =\n    \"https://www.20minutos.es/rss/\";\n\n  const proxy =\n    \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n\n  const feed =\n    proxy + \"?url=\" + encodeURIComponent(rssUrl);\n\n  let noticias = [];\n  let indice = 0;\n  let cargando = false;\n\n  const cantidad = 5;\n\n  const lista =\n    document.getElementById(\"lista-noticias\");\n\n  const destacada =\n    document.getElementById(\"noticia-destacada\");\n\n  const loader =\n    document.getElementById(\"loader\");\n\n  const trigger =\n    document.getElementById(\"infinite-trigger\");\n\n  /* EXTRAER IMG */\n  function extraerImagen(item){\n\n    let img = \"\";\n\n    const enclosure =\n      item.querySelector(\"enclosure\");\n\n    if(\n      enclosure &&\n      enclosure.getAttribute(\"url\")\n    ){\n      img = enclosure.getAttribute(\"url\");\n    }\n\n    if(!img){\n\n      const media =\n        item.querySelector(\"media\\\\:content\");\n\n      if(media){\n        img = media.getAttribute(\"url\");\n      }\n\n    }\n\n    if(!img){\n\n      const desc =\n        item.querySelector(\"description\")\n        ?.textContent || \"\";\n\n      const match =\n        desc.match(/<img.*?src=[\"'](.*?)[\"']/i);\n\n      if(match){\n        img = match[1];\n      }\n\n    }\n\n    return img ||\n      \"https://picsum.photos/800/500\";\n  }\n\n  /* CARGAR RSS */\n  async function cargarRSS(){\n\n    try{\n\n      const response =\n        await fetch(feed);\n\n      const text =\n        await response.text();\n\n      const parser =\n        new DOMParser();\n\n      const xml =\n        parser.parseFromString(\n          text,\n          \"text/xml\"\n        );\n\n      const items =\n        [...xml.querySelectorAll(\"item\")];\n\n      noticias =\n        items.map(item => ({\n\n          title:\n            item.querySelector(\"title\")\n            ?.textContent || \"\",\n\n          link:\n            item.querySelector(\"link\")\n            ?.textContent || \"\",\n\n          date:\n            item.querySelector(\"pubDate\")\n            ?.textContent || \"\",\n\n          author:\n            item.querySelector(\"dc\\\\:creator\")\n            ?.textContent || \"20minutos\",\n\n          img:\n            extraerImagen(item)\n\n        }));\n\n      pintarNoticias();\n\n      iniciarInfiniteScroll();\n\n    }catch(error){\n\n      document.getElementById(\n        \"widget-20minutos\"\n      ).innerHTML =\n      \"<p style='color:red'>Error cargando noticias</p>\";\n\n      console.error(error);\n\n    }\n\n  }\n\n  /* PINTAR */\n  function pintarNoticias(){\n\n    if(cargando) return;\n\n    if(indice >= noticias.length) return;\n\n    cargando = true;\n\n    loader.style.display = \"block\";\n\n    const bloque =\n      noticias.slice(\n        indice,\n        indice + cantidad\n      );\n\n    bloque.forEach((n,i) => {\n\n      const fecha =\n        new Date(n.date)\n        .toLocaleDateString(\n          \"es-ES\",\n          {\n            day:\"2-digit\",\n            month:\"short\",\n            year:\"numeric\"\n          }\n        );\n\n      /* DESTACADA */\n      if(indice === 0 && i === 0){\n\n        destacada.innerHTML = `\n          <article class=\"featured\">\n\n            <a href=\"${n.link}\" target=\"_blank\">\n              <img src=\"${n.img}\">\n            </a>\n\n            <a\n              href=\"${n.link}\"\n              target=\"_blank\"\n              class=\"featured-title\"\n            >\n              ${n.title}\n            </a>\n\n            <div class=\"meta\">\n              ${n.author} · ${fecha}\n            </div>\n\n          </article>\n        `;\n\n      }else{\n\n        lista.insertAdjacentHTML(\n          \"beforeend\",\n          `\n          <article class=\"item\">\n\n            <a\n              href=\"${n.link}\"\n              target=\"_blank\"\n              class=\"thumb\"\n            >\n              <img src=\"${n.img}\">\n            </a>\n\n            <div class=\"content\">\n\n              <a\n                href=\"${n.link}\"\n                target=\"_blank\"\n                class=\"title\"\n              >\n                ${n.title}\n              </a>\n\n              <div class=\"date\">\n                ${fecha}\n              </div>\n\n            </div>\n\n          </article>\n          `\n        );\n\n      }\n\n    });\n\n    indice += cantidad;\n\n    cargando = false;\n\n    loader.style.display = \"none\";\n  }\n\n  /* SCROLL INFINITO REAL */\n  function iniciarInfiniteScroll(){\n\n    const observer =\n      new IntersectionObserver(entries => {\n\n        entries.forEach(entry => {\n\n          if(entry.isIntersecting){\n\n            pintarNoticias();\n\n          }\n\n        });\n\n      },{\n        root:null,\n        rootMargin:\"1000px\",\n        threshold:0\n      });\n\n    observer.observe(trigger);\n\n  }\n\n  cargarRSS();\n\n})();\n</script>",
 "fecha_copia": "2026-09-26T15:18:24.356Z"
}