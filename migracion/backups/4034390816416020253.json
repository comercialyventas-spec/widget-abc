r-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;}\n</style>\n\n<script>\nvar cargando = false;\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=supermercadoaliazon&utm_medium=tarjeta_producto&utm_campaign=catalogo_kondimenta-store';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + ' €</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '</div>';\n  return h;\n}\nfetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?sitemap=https%3A%2F%2Fkondimenta-store.com%2Fproducts%2Fharissa.json&pagina=1')\n  .then(function(r){ return r.json(); })\n  .then(function(data){\n    document.getElementById('tienda-catalogo').innerHTML = data.productos.map(crearTarjeta).join('');\n    document.getElementById('loader').style.display = 'none';\n    document.getElementById('web-oficial-container').style.display = 'block';\n  })\n  .catch(function(err){ console.log(err); });\n\n</script>\n\n<div><br /></div>\n<a href=\"https://kondimenta-store.com/?utm_source=supermercadoaliazon&amp;utm_medium=enlace_texto_inferior&amp;utm_campaign=catalogo_kondimenta-store\" rel=\"nofollow\" target=\"_blank\"><b>IR A LA WEB OFICIAL</b></a>\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI ESTA AGOTADA TU TALLA, COLOR O NO ENVIAN A TU DESTINO CONTACTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
