 "titulo": "LEGUMBRES EN COMPRAFRUTAONLINE",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj0oy7vU442TKCtNuWC7Ut99DYfy2U6P80GpGN9DYOzB0Im1rbRpKkDjjbZSHP3gsALF6IfKOcbbWtXMTlTfF_jaQvgtqsTeVoJvEti2vctvOJd2vzhSnXCqZg7DDf2g5LAlWjfTp6GrVLkRsWeSF7v6J563EWNtgt5eUCZYWthcgkjl9-Cy43ScC-OJew/s200/alubia-blanca-rion.png\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" width=\"320\" data-original-height=\"200\" data-original-width=\"200\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj0oy7vU442TKCtNuWC7Ut99DYfy2U6P80GpGN9DYOzB0Im1rbRpKkDjjbZSHP3gsALF6IfKOcbbWtXMTlTfF_jaQvgtqsTeVoJvEti2vctvOJd2vzhSnXCqZg7DDf2g5LAlWjfTp6GrVLkRsWeSF7v6J563EWNtgt5eUCZYWthcgkjl9-Cy43ScC-OJew/s320/alubia-blanca-rion.png\"/></a></div>\nLas legumbres de Compra Fruta Online destacan por ofrecer variedades tradicionales como garbanzos, lentejas y alubias, ideales para recetas caseras y platos de cuchara. Son productos sencillos, con buena presencia y pensados para el consumo diario, manteniendo una relación calidad-precio bastante equilibrada para quienes buscan legumbres clásicas y fáciles de preparar.\n<div id=\"cfo-legumbres-widget\">\n  <div id=\"cfo-legumbres-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 1000px; margin: auto; color: #333;\">\n    <p style=\"grid-column: 1/-1; text-align: center; color: #999;\">Cargando legumbres de CompraFrutaOnline...</p>\n  </div>\n</div>\n\n<style>\n  #cfo-legumbres-widget .cfo-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; display: flex; flex-direction: column; }\n  #cfo-legumbres-widget .cfo-card img { width: 100%; height: 200px; object-fit: contain; border-radius: 8px; margin-bottom: 10px; background: #fafafa; }\n  #cfo-legumbres-widget .cfo-card-title { font-size: 14px; font-weight: 600; margin-bottom: 5px; color: #333; min-height: 40px; }\n  #cfo-legumbres-widget .cfo-card-price { font-size: 16px; font-weight: bold; color: #40a52b; margin-bottom: 10px; }\n  #cfo-legumbres-widget .cfo-card-btn { display: block; background: #40a52b; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; margin-top: auto; }\n  #cfo-legumbres-widget .cfo-card-btn:hover { background: #2d7a1e; }\n</style>\n\n<script>\n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var PAGE_URL = \"https://www.comprafrutaonline.com/catalogo/legumbres/\";\n\n  function cargarCFO() {\n    fetch(proxy + \"?url=\" + encodeURIComponent(PAGE_URL))\n      .then(function(res) { return res.text(); })\n      .then(function(html) {\n        var bloques = html.split('class=\"col-xs-6 col-sm-3 item\"');\n        bloques.shift();\n        \n        if (bloques.length === 0) {\n          document.getElementById(\"cfo-legumbres-grid\").innerHTML =\n            \"<p style='grid-column: 1/-1; text-align: center; color: #666;'>No se encontraron productos.</p>\";\n          return;\n        }\n\n        var productos = [];\n        bloques.forEach(function(bloque) {\n          var imgMatch = bloque.match(/<img src=\"([^\"]+)\"/);\n          var titleMatch = bloque.match(/<a[^>]*>([^<]+)<\\/a>/);\n          var priceMatch = bloque.match(/<span>([^<]+)<\\/span>/);\n          var linkMatch = bloque.match(/<a href=\"(\\/catalogo\\/[^\"]+)\"/);\n          \n          if (imgMatch && titleMatch && priceMatch && linkMatch) {\n            productos.push({\n              img: \"https://www.comprafrutaonline.com\" + imgMatch[1],\n              title: titleMatch[1].trim(),\n              price: priceMatch[1].trim(),\n              link: \"https://www.comprafrutaonline.com\" + linkMatch[1]\n            });\n          }\n        });\n\n        var htmlOut = \"\";\n        productos.forEach(function(p) {\n          htmlOut +=\n            '<div class=\"cfo-card\">' +\n            '<img src=\"' + p.img + '\" alt=\"' + p.title + '\" loading=\"lazy\">' +\n            '<div class=\"cfo-card-title\">' + p.title + '</div>' +\n            '<div class=\"cfo-card-price\">' + p.price + '</div>' +\n            '<a class=\"cfo-card-btn\" href=\"' + p.link + '\" target=\"_blank\">🛒 VER PRODUCTO</a>' +\n            '</div>';\n        });\n\n        htmlOut +=\n          '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n          '<a href=\"' + PAGE_URL + '\" target=\"_blank\" style=\"display: inline-block; background: #40a52b; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;\">🥕 VER TODAS LAS LEGUMBRES</a>' +\n          '</div>';\n\n        document.getElementById(\"cfo-legumbres-grid\").innerHTML = htmlOut;\n      })\n      .catch(function() {\n        document.getElementById(\"cfo-legumbres-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar productos.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarCFO);\n  } else {\n    cargarCFO();\n  }\n})();\n</script>",
 "fecha_copia": "2026-10-03T05:18:42.940Z"
}