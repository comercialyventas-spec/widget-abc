 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjoRG8n_j-GymNObmPOELC9sOE1VTbaHHyw_XrZ8gfB3B5-QdvNzmeY1y5McR7gc9Ba0GVj09srIkdlWsgXuSZvVZI38GgbBmKyluhqYfbO2T-LlyGrApNHeQTVHy0KSP403-39Ihb7rLsghOA8kYGAfkPWRuFfDourAbQ7Yucsini7yXOeKSRByohoMcs/s2400/2080s260014_Falda_Benedetta_Blanca_1560b_7%20%282%29.jpg\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" height=\"320\" data-original-height=\"2400\" data-original-width=\"1934\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjoRG8n_j-GymNObmPOELC9sOE1VTbaHHyw_XrZ8gfB3B5-QdvNzmeY1y5McR7gc9Ba0GVj09srIkdlWsgXuSZvVZI38GgbBmKyluhqYfbO2T-LlyGrApNHeQTVHy0KSP403-39Ihb7rLsghOA8kYGAfkPWRuFfDourAbQ7Yucsini7yXOeKSRByohoMcs/s320/2080s260014_Falda_Benedetta_Blanca_1560b_7%20%282%29.jpg\"/></a></div><br /><div style=\"text-align: justify;\"><br />Las faldas de El Ganso destacan por su estilo femenino, fresco y versátil, inspirado en un espíritu mediterráneo y desenfadado. La colección reúne diseños midi y largos, estampados florales, rayas, bordados y tejidos ligeros como el lino, pensados para crear looks cómodos y elegantes para el día a día. Con una cuidada atención a los detalles y una paleta de colores luminosa, cada modelo refleja el equilibrio entre tendencia, naturalidad y calidad que caracteriza a la marca.</div>\n\n<!--more-->\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: block; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://www.elganso.com/es/mujer/faldas-mujer.html?utm_source=ropaycomplementos&amp;utm_medium=boton_oficial&amp;utm_campaign=catalogo_elganso\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: &quot;Helvetica Neue&quot;, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\n(function(){\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\n// Capa 1: NAS magento_categoria.php (la categoria real de la tienda CON PRECIOS actualizados, cache 3 h).\n// Capa 2: NAS generar_o_servir.php (sitemap cacheado, sin precios). Capa 3: proxy Apps Script de siempre.\nvar NAS_MAGENTO = 'https://carmenprofe.synology.me/generador_htmlrobots/magento_categoria.php';\nvar CATEGORIA = 'https://www.elganso.com/es/mujer/faldas-mujer.html';\nvar NAS_URL = 'https://carmenprofe.synology.me/generador_htmlrobots/generar_o_servir.php';\nvar SITEMAP_NAS = 'https://www.elganso.com/media/sitemap_es.xml';\nvar PALABRA = /\\bfalda/i;   // solo faldas\nvar PROXY = 'https://script.google.com/macros/s/AKfycbxOCb-AYehPn7O-x10c4JVzcrGCkcAAS2upa9XWnsZKLtXJ9q-O5BYlhJvvgxX6KB2S/exec?url=https%3A%2F%2Fwww.elganso.com%2Fes%2Fmujer%2Ffaldas-mujer.html&pagina=1';\nvar POR_LOTE = 12;\nvar productos = [], vistos = {}, mostrados = 0, terminado = false;\n\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=ropaycomplementos&utm_medium=tarjeta_producto&utm_campaign=catalogo_elganso';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' referrerpolicy=' + String.fromCharCode(34) + 'no-referrer' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + (p.precio_antes ? '<s style=' + String.fromCharCode(34) + 'color:#999;font-weight:normal;font-size:13px;margin-right:6px' + String.fromCharCode(34) + '>' + p.precio_antes + '</s>' : '') + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\n\n// Si una foto falla (antihotlink u otra causa), se pide a traves de images.weserv.nl\n(function(){ var c = document.getElementById('tienda-catalogo'); if (c) c.addEventListener('error', function(e){ var t = e.target; if (t && t.tagName === 'IMG' && !t.getAttribute('data-resp')) { t.setAttribute('data-resp', '1'); t.src = 'https://images.weserv.nl/?url=' + encodeURIComponent(t.src.replace(/^https?:\\/\\//, '')); } }, true); })();\n\nfunction anadir(p){\n  if (!p || !p.url || vistos[p.url]) return;\n  vistos[p.url] = true;\n  productos.push(p);\n}\nfunction pintar(){\n  document.getElementById('tienda-catalogo').innerHTML = productos.slice(0, mostrados).map(crearTarjeta).join('');\n}\nfunction cargarLote(){\n  if (mostrados >= productos.length) return;\n  mostrados = Math.min(mostrados + POR_LOTE, productos.length);\n  pintar();\n}\nfunction fetchConTiempo(url, ms){\n  var ctrl = new AbortController();\n  var t = setTimeout(function(){ ctrl.abort(); }, ms);\n  return fetch(url, { signal: ctrl.signal }).then(function(r){ clearTimeout(t); if (!r.ok) throw new Error(r.status); return r.json(); });\n}\nfunction paginaNas(n){\n  return fetchConTiempo(NAS_URL + '?url=' + encodeURIComponent(SITEMAP_NAS) + '&pagina=' + n, 15000);\n}\nfunction cargarDesdeNas(){\n  return paginaNas(1).then(function(d){\n    var total = d.totalPaginas || 1;\n    function meter(dd){ (dd.productos || []).forEach(function(x){ if (PALABRA.test(x.titulo || '')) anadir({ url: x.url, imagen: x.imagen, titulo: x.titulo, precio: x.precio || '', descripcion: '' }); }); }\n    meter(d);\n    var pendientes = [];\n    for (var i = 2; i <= total; i++) pendientes.push(i);\n    function tanda(){\n      var t = pendientes.splice(0, 8);\n      if (!t.length) return Promise.resolve();\n      return Promise.all(t.map(function(n){ return paginaNas(n).then(meter).catch(function(){}); }))\n        .then(function(){ if (mostrados < POR_LOTE && productos.length) cargarLote(); return tanda(); });\n    }\n    return tanda();\n  });\n}\nfunction paginaMagento(n){\n  return fetchConTiempo(NAS_MAGENTO + '?url=' + encodeURIComponent(CATEGORIA) + '&pagina=' + n, 20000);\n}\nfunction cargarDesdeMagento(){\n  return paginaMagento(1).then(function(d){\n    (d.productos || []).forEach(anadir);\n    if (productos.length) cargarLote();\n    var total = d.totalPaginas || 1, cadena = Promise.resolve();\n    for (var i = 2; i <= total; i++) (function(n){ cadena = cadena.then(function(){ return paginaMagento(n).then(function(dd){ (dd.productos || []).forEach(anadir); if (mostrados < POR_LOTE) cargarLote(); }).catch(function(){}); }); })(i);\n    return cadena;\n  });\n}\nfunction cargarDesdeProxy(){\n  return fetchConTiempo(PROXY, 20000).then(function(data){ (data.productos || []).forEach(anadir); });\n}\nfunction finalizar(){\n  terminado = true;\n  document.getElementById('loader').style.display = 'none';\n  if (mostrados === 0) cargarLote(); else pintar();\n  document.getElementById('web-oficial-container').style.display = 'block';\n}\nwindow.addEventListener('scroll', function(){\n  var s = document.getElementById('sentinel');\n  if (!s || !productos.length) return;\n  if (s.getBoundingClientRect().top < window.innerHeight + 400 && mostrados < productos.length) cargarLote();\n});\nfunction arrancar(){\n  cargarDesdeMagento().catch(function(){})\n    .then(function(){ if (!productos.length) return cargarDesdeNas().catch(function(){}); })\n    .then(function(){ if (!productos.length) return cargarDesdeProxy().catch(function(){}); })\n    .then(finalizar);\n}\nif (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arrancar); else arrancar();\n})();\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div><br />",
 "fecha_copia": "2026-10-01T05:51:04.111Z"
