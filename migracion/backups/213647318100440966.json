 "contenido": "<div id=\"cashfresh-cat-widget\">\n  <!-- PORTADA -->\n  <div style=\"text-align: center; margin-bottom: 30px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 650px; margin-left: auto; margin-right: auto;\">\n    <img src=\"https://www.cashfresh.es/wp-content/uploads/2022/11/servicios_profesionales.png\" alt=\"Cash Fresh\" style=\"width: 100%; max-width: 400px; height: auto; border-radius: 10px; margin-bottom: 15px;\" />\n    <h2 style=\"font-size: 22px; font-weight: 800; color: #111; margin-bottom: 10px;\">📂 Categorías de Cash Fresh</h2>\n    <p style=\"font-size: 14px; color: #666; line-height: 1.6;\">\n      Descubre todas las secciones del blog de Cash Fresh, donde encontrarás recetas fáciles y tradicionales, consejos de alimentación y ahorro, novedades sobre productos y noticias relacionadas con el supermercado. Un espacio pensado para inspirarte en tu día a día con ideas prácticas para cocinar, conocer nuevos productos y sacar más partido a tu compra semanal.\n    </p>\n  </div>\n\n  <div id=\"cashfresh-cat-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333;\">\n    <p style=\"grid-column: 1/-1; text-align: center; color: #999;\">Cargando categorías de Cash Fresh...</p>\n  </div>\n</div>\n\n<style>\n  #cashfresh-cat-widget .cfcat-card { border: 1px solid #eaeaea; border-radius: 10px; padding: 16px; text-align: center; background: #fff; }\n  #cashfresh-cat-widget .cfcat-card a { font-size: 14px; font-weight: 600; color: #e63946; text-decoration: none; display: block; }\n  #cashfresh-cat-widget .cfcat-card a:hover { color: #c1121f; }\n</style>\n\n<script>\n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var SITEMAP_URL = \"https://www.cashfresh.es/category-sitemap.xml\";\n\n  function cargarCFCat() {\n    fetch(proxy + \"?url=\" + encodeURIComponent(SITEMAP_URL))\n      .then(function(res) { return res.text(); })\n      .then(function(xml) {\n        var bloques = xml.split(\"<loc>\");\n        bloques.shift();\n        \n        var categorias = [];\n        for (var i = 0; i < bloques.length; i++) {\n          var fin = bloques[i].indexOf(\"</loc>\");\n          if (fin > 0) {\n            var url = bloques[i].substring(0, fin);\n            var slug = url.replace(/\\/$/, \"\").split(\"/\").pop();\n            if (slug === \"sin-categoria\" || slug === \"uncategorized\") continue;\n            var nombre = slug.replace(/-/g, \" \").replace(/\\b\\w/g, function(l) { return l.toUpperCase(); });\n            categorias.push({ nombre: nombre, url: url });\n          }\n        }\n\n        if (categorias.length === 0) {\n          document.getElementById(\"cashfresh-cat-grid\").innerHTML =\n            \"<p style='grid-column: 1/-1; text-align: center; color: #666;'>No se encontraron categorías.</p>\";\n          return;\n        }\n\n        var html = \"\";\n        categorias.forEach(function(c) {\n          html +=\n            '<div class=\"cfcat-card\">' +\n            '<a href=\"' + c.url + '\" target=\"_blank\">📂 ' + c.nombre + '</a>' +\n            '</div>';\n        });\n\n        html +=\n          '<div style=\"grid-column: 1/-1; text-align: center; padding: 15px;\">' +\n          '<a href=\"https://www.cashfresh.es/\" target=\"_blank\" style=\"display: inline-block; background: #e63946; color: #fff; padding: 12px 30px; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: bold;\">🛒 VER WEB DE CASH FRESH</a>' +\n          '</div>';\n\n        document.getElementById(\"cashfresh-cat-grid\").innerHTML = html;\n      })\n      .catch(function() {\n        document.getElementById(\"cashfresh-cat-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarCFCat);\n  } else {\n    cargarCFCat();\n  }\n})();\n</script>",
 "fecha_copia": "2026-10-03T10:13:00.770Z"
}