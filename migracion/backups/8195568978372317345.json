 "titulo": "PIJAMAS BASYCO JEREZ",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjIA0oRBCh3iy21pfbzQVwTl5bHgVV3W2XIBxY07jSfwYp-N7YXohHrUMTu2-Fv9UYFYiAxWh7WUtefgQwSkXt8TxWgOjSvU4VjZWQ-31Q0ng5xqbxtV8KK8qlarfYI-EiVaTg4fsTKzAOfpwaf-cMMpw9kfdySgBn3zArEBIN0VX7MSpzUYquptbONtDg/pijama-versalles-lila.jpg\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" width=\"320\" data-original-height=\"0\" data-original-width=\"0\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjIA0oRBCh3iy21pfbzQVwTl5bHgVV3W2XIBxY07jSfwYp-N7YXohHrUMTu2-Fv9UYFYiAxWh7WUtefgQwSkXt8TxWgOjSvU4VjZWQ-31Q0ng5xqbxtV8KK8qlarfYI-EiVaTg4fsTKzAOfpwaf-cMMpw9kfdySgBn3zArEBIN0VX7MSpzUYquptbONtDg/s320/pijama-versalles-lila.jpg\"/></a></div><div class=\"separator\" style=\"clear: both;\"><a href=\"\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" height=\"320\" src=\"\" /></a></div>\n\n<div style=\"text-align: justify;\">Basycojerez es una firma de moda contemporánea que fusiona sensualidad, sofisticación y espíritu urbano en cada una de sus colecciones. Diseñada en Nueva York, la marca se caracteriza por sus siluetas femeninas, tejidos de calidad y una estética que conecta con la mujer moderna y dinámica. Descubre todas sus propuestas y encuentra las prendas que mejor expresan tu estilo.</div>\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://basycojerez.com/?utm_source=ropaycomplementosaliazon&utm_medium=boton_oficial&utm_campaign=catalogo_basycojerez\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: Helvetica Neue, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\nvar PROXY_TRANSLATE = 'https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec';\nasync function traducir(texto) {\n  if (!texto) return '';\n  try {\n    var tUrl = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&q=' + encodeURIComponent(texto);\n    var res = await fetch(PROXY_TRANSLATE + '?url=' + encodeURIComponent(tUrl));\n    var raw = await res.text();\n    var data = JSON.parse(raw);\n    return data[0].map(function(p){ return p[0]; }).join('');\n  } catch(e) { return texto; }\n}\nasync function traducirProductos(productos) {\n  await Promise.all(productos.map(async function(p) {\n    var r = await Promise.all([traducir(p.titulo), traducir(p.descripcion || '')]);\n    p.titulo = r[0];\n    if (p.descripcion) p.descripcion = r[1];\n  }));\n}\nvar NAS_URL = 'https://carmenprofe.synology.me/generador_htmlrobots/generar_o_servir.php';\nfunction obtenerPagina(pagina){\n  return fetch(NAS_URL + '?url=https%3A%2F%2Fbasycojerez.com%2F1_es_0_sitemap.xml&pagina=' + pagina)\n    .then(function(r){ return r.json(); })\n    .then(function(data){\n      if (data && data.productos && data.productos.length > 0) return data;\n      return fetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?url=https%3A%2F%2Fbasycojerez.com%2F1_es_0_sitemap.xml&pagina=' + pagina).then(function(r){ return r.json(); });\n    })\n    .catch(function(){\n      return fetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?url=https%3A%2F%2Fbasycojerez.com%2F1_es_0_sitemap.xml&pagina=' + pagina).then(function(r){ return r.json(); });\n    });\n}\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=ropaycomplementosaliazon&utm_medium=tarjeta_producto&utm_campaign=catalogo_basycojerez';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' referrerpolicy=' + String.fromCharCode(34) + 'no-referrer' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\nvar FILTRO_TITULO = 'pijama';\nvar hayMas = true;\nvar paginaActual = 1;\nasync function cargarProductos(){\n  if(cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById('loader').style.display = 'block';\n  obtenerPagina(paginaActual)\n    .then(async function(data){\n      var filtrados = data.productos.filter(function(p){\n        return p.titulo && p.titulo.toLowerCase().indexOf(FILTRO_TITULO) !== -1;\n      });\n      if(filtrados.length > 0){\n        document.getElementById('tienda-catalogo').innerHTML += filtrados.map(crearTarjeta).join('');\n        await traducirProductos(filtrados);\n        var tarjetas = document.getElementById('tienda-catalogo').querySelectorAll('.producto-card');\n        var offset = tarjetas.length - filtrados.length;\n        filtrados.forEach(function(p, i){ tarjetas[offset + i].outerHTML = crearTarjeta(p); });\n      }\n      hayMas = data.hayMas;\n      paginaActual++;\n      cargando = false;\n      if(hayMas){\n        cargarProductos();\n      } else {\n        document.getElementById('web-oficial-container').style.display = 'block';\n        document.getElementById('loader').style.display = 'none';\n      }\n    })\n    .catch(function(err){ console.log(err); cargando = false; });\n}\ndocument.addEventListener('DOMContentLoaded', function(){\n  cargarProductos();\n});\n\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-10-03T12:24:53.021Z"
}