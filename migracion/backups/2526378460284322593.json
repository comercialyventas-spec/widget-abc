 "titulo": "ARTE Y CULTURA DIARIO CRITICO",
 "fila": 2421,
 "contenido": "<div id=\"dc-arte-widget\">\n  <div id=\"dc-arte-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"dc-arte-lista\">Cargando noticias de Arte y Cultura...</div>\n</div>\n\n<style>\n  #dc-arte-widget { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #dc-arte-widget .dc-featured { text-align: center; margin-bottom: 40px; }\n  #dc-arte-widget .dc-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }\n  #dc-arte-widget .dc-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #dc-arte-widget .dc-title-featured:hover { color: #c0392b; }\n  #dc-arte-widget .dc-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #dc-arte-widget .dc-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; }\n  #dc-arte-widget .dc-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #dc-arte-widget .dc-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #dc-arte-widget .dc-item-title:hover { color: #c0392b; }\n  #dc-arte-widget .dc-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; }\n  @media (min-width: 600px) {\n    #dc-arte-widget .dc-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #dc-arte-widget .dc-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function() {\n  function cargarDC() {\n    var rssUrl = \"https://www.diariocritico.com/rss/seccion/106/\";\n    var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n    var url = proxy + \"?url=\" + encodeURIComponent(rssUrl);\n\n    fetch(url)\n      .then(function(res) { return res.text(); })\n      .then(function(text) {\n        var parser = new DOMParser();\n        var xmlDoc = parser.parseFromString(text, \"text/xml\");\n        var items = Array.from(xmlDoc.querySelectorAll(\"item\"));\n        \n        if (items.length === 0) throw new Error(\"Sin resultados\");\n        \n        var noticias = items.slice(0, 6).map(function(item) {\n          var title = item.querySelector(\"title\")?.textContent?.trim() || \"\";\n          var link = item.querySelector(\"link\")?.textContent?.trim() || \"\";\n          var pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n          var author = item.querySelector(\"author\")?.textContent?.replace(/\\(.*\\)/, '').trim() || \"Diariocrítico\";\n          \n          var img = \"\";\n          var mediaContent = item.querySelector(\"media\\\\:content\") ||\n                            item.getElementsByTagNameNS(\"http://search.yahoo.com/mrss/\", \"content\")[0];\n          if (mediaContent) {\n            img = mediaContent.getAttribute(\"url\") || \"\";\n          }\n          \n          return { title: title, link: link, pubDate: pubDate, author: author, img: img };\n        }).filter(function(n) { return n.title; });\n\n        function renderizar() {\n          var destacadoHtml = \"\";\n          var listaHtml = \"\";\n\n          noticias.forEach(function(noticia, index) {\n            var fecha = new Date(noticia.pubDate).toLocaleDateString('es-ES',\n              { day: '2-digit', month: 'short', year: 'numeric' });\n\n            if (index === 0) {\n              destacadoHtml =\n                '<div class=\"dc-featured\">' +\n                '<a href=\"' + noticia.link + '\" target=\"_blank\">' +\n                '<img src=\"' + noticia.img + '\" class=\"dc-img-featured\" alt=\"' + noticia.title + '\">' +\n                '</a>' +\n                '<a class=\"dc-title-featured\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"dc-meta\">DIARIOCRÍTICO CULTURA · ' + noticia.author + ' · ' + fecha + '</div>' +\n                '</div>';\n            } else {\n              listaHtml +=\n                '<div class=\"dc-item\">' +\n                '<div class=\"dc-img-container\"><img src=\"' + noticia.img + '\" alt=\"' + noticia.title + '\"></div>' +\n                '<div>' +\n                '<a class=\"dc-item-title\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"dc-meta\">' + noticia.author + ' · ' + fecha + '</div>' +\n                '</div>' +\n                '</div>';\n            }\n          });\n\n          document.getElementById(\"dc-arte-destacada\").innerHTML = destacadoHtml;\n          document.getElementById(\"dc-arte-lista\").innerHTML = listaHtml;\n        }\n\n        renderizar();\n\n      })\n      .catch(function() {\n        document.getElementById(\"dc-arte-widget\").innerHTML =\n          \"<p style='color:red'>Error al cargar noticias de Diariocrítico.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarDC);\n  } else {\n    cargarDC();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-28T18:21:55.582Z"
}