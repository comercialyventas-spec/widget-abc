 "path": "/2026/04/gente-en-la-vanguardia.html",
 "titulo": "GENTE EN LA VANGUARDIA",
 "fila": 23,
 "contenido": "<div id=\"widget-noticias-lv\" style=\"min-height: 200px;\">\n  <p style=\"text-align: center; color: #666; font-family: sans-serif; font-size: 13px;\">\n    Cargando sucesos de La Vanguardia...\n  </p>\n</div>\n\n<style>\n  /* Diseño para el widget cuando se reorganice */\n  #widget-noticias-lv .noticia-destacada { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #eee; padding-bottom: 20px; }\n  #widget-noticias-lv .noticia-destacada img { width: 100%; max-height: 350px; object-fit: cover; border-radius: 8px; }\n  #widget-noticias-lv .noticia-destacada a { font-size: 24px; font-weight: bold; display: block; margin-top: 10px; color: #000; text-decoration: none; }\n  #widget-noticias-lv .lista-noticias { display: flex; flex-direction: column; gap: 15px; }\n  #widget-noticias-lv .item-lista { display: flex; gap: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px; }\n  #widget-noticias-lv .item-lista img { width: 100px; height: 70px; object-fit: cover; border-radius: 4px; }\n</style>\n\n<script>\n  (function() {\n    const MI_MOTOR = \"https://script.google.com/macros/s/AKfycbxTehoGzJL9MT1SvEnV7XNNbpIs0n3XEQd_yFl1aBQdC_ZBPLRhQ3m-wokLZKZtwrIT/exec\"; \n    const RSS_URL = \"https://www.lavanguardia.com/rss/gente.xml\";\n    const contenedor = document.getElementById('widget-noticias-lv');\n\n    fetch(`${MI_MOTOR}?url=${encodeURIComponent(RSS_URL)}`)\n      .then(response => response.text())\n      .then(html => {\n        // Aquí insertamos el HTML original que tu script devuelve\n        contenedor.innerHTML = html;\n        \n        // --- AHORA REORGANIZAMOS EL CONTENIDO ---\n        const items = contenedor.querySelectorAll('li'); // Asumiendo que tu script devuelve una lista (li)\n        if (items.length > 0) {\n          const primero = items[0];\n          primero.classList.add('noticia-destacada');\n          \n          let listaHtml = '<div class=\"lista-noticias\">';\n          for(let i = 1; i < items.length; i++) {\n            items[i].classList.add('item-lista');\n            listaHtml += items[i].outerHTML;\n          }\n          listaHtml += '</div>';\n          \n          contenedor.innerHTML = primero.outerHTML + listaHtml;\n        }\n      })\n      .catch(err => {\n        contenedor.innerHTML = \"<p style='color:red;'>Error al reorganizar.</p>\";\n      });\n  })();\n</script>",
 "fecha_copia": "2026-09-26T15:17:55.079Z"
}