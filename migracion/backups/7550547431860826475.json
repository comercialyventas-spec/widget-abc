 "titulo": "NOVEDADES ADOR",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhZue4sDWJzSOEtMDWNum1JgFuJFvh1zNpYAYtgW9mQUe0ljWPL46750yT3vUhNf4dtu3oWkqAeM7lqZdg8lNH0C-GKGo36OMRmUpFOJDKO6ZbJOcGOivAaM3AJ9O2twbVV-k2Dc9-2ajWUdPpmUu-HjkTOVlHlZ5ovTF0H_3kXWH-zKb5_TQ3XoPxxOpA/s1092/17769256393810%20%281%29.webp\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"\" border=\"0\" width=\"320\" data-original-height=\"1080\" data-original-width=\"1092\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhZue4sDWJzSOEtMDWNum1JgFuJFvh1zNpYAYtgW9mQUe0ljWPL46750yT3vUhNf4dtu3oWkqAeM7lqZdg8lNH0C-GKGo36OMRmUpFOJDKO6ZbJOcGOivAaM3AJ9O2twbVV-k2Dc9-2ajWUdPpmUu-HjkTOVlHlZ5ovTF0H_3kXWH-zKb5_TQ3XoPxxOpA/s320/17769256393810%20%281%29.webp\"/></a></div><div class=\"separator\" style=\"clear: both;\"><a href=\"\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" height=\"320\" src=\"\" /></a></div>\n\n<div style=\"text-align: justify;\">La colección Novedades de Ador presenta una selección de prendas que reflejan la estética urbana, sensual y sofisticada de la firma neoyorquina. Cada pieza está diseñada con atención al detalle, tejidos de calidad y siluetas que favorecen la figura femenina. Una propuesta que mantiene la identidad característica de Ador con nuevas formas y estilos para cada temporada.</div>\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://ador.com/?utm_source=ropaycomplementosaliazon&utm_medium=boton_oficial&utm_campaign=catalogo_ador\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: Helvetica Neue, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\nvar PROXY_TRANSLATE = 'https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec';\nasync function traducir(texto) {\n  if (!texto) return '';\n  try {\n    var tUrl = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&q=' + encodeURIComponent(texto);\n    var res = await fetch(PROXY_TRANSLATE + '?url=' + encodeURIComponent(tUrl));\n    var raw = await res.text();\n    var data = JSON.parse(raw);\n    return data[0].map(function(p){ return p[0]; }).join('');\n  } catch(e) { return texto; }\n}\nasync function traducirProductos(productos) {\n  await Promise.all(productos.map(async function(p) {\n    var r = await Promise.all([traducir(p.titulo), traducir(p.descripcion || '')]);\n    p.titulo = r[0];\n    if (p.descripcion) p.descripcion = r[1];\n  }));\n}\nvar URL_DIRECTA_SHOPIFY = 'https://ador.com/collections/novedades/products.json';\nvar RUTA_COLECCION = '/es/collections/novedades';\nvar coleccionResuelta = false;\nvar ORIGEN_TIENDA = 'https://ador.com';\nvar modoDirecto = false;\nvar paginaDirecta = 1;\nvar yaPintado = false;\nvar proxyUltimo = false;\nfunction fetchConTimeout(url, ms){ var c = new AbortController(); var t = setTimeout(function(){ c.abort(); }, ms); return fetch(url, { signal: c.signal }).then(function(r){ clearTimeout(t); return r; }, function(e){ clearTimeout(t); throw e; }); }\nfunction terminarSinMas(){ hayMas = false; cargando = false; var l = document.getElementById('loader'); if (l) l.style.display = 'none'; var w = document.getElementById('web-oficial-container'); if (w) w.style.display = 'block'; }\nfunction limpiarTextoProd(html){ var d = document.createElement('div'); d.innerHTML = html || ''; var t = (d.textContent || '').replace(/\\s+/g, ' ').trim(); return t.length > 90 ? t.slice(0, 90) + '...' : t; }\nfunction pedirDirectoBase(){\n  return fetchConTimeout(URL_DIRECTA_SHOPIFY + '?limit=24&page=' + paginaDirecta, 15000)\n    .then(function(r){ if (!r.ok) throw new Error('Tienda HTTP ' + r.status); return r.json(); })\n    .then(function(j){\n      var lista = (j && j.products) ? j.products : [];\n      paginaDirecta++;\n      var productos = lista.map(function(p){ var v = (p.variants && p.variants[0]) ? p.variants[0] : {}; return { titulo: (p.title || '').replace(/\"/g, '&quot;'), url: ORIGEN_TIENDA + '/products/' + p.handle, imagen: (p.images && p.images[0]) ? p.images[0].src : '', precio: v.price ? v.price : '', descripcion: limpiarTextoProd(p.body_html) }; }).filter(function(p){ return p.titulo && p.imagen; });\n      return { productos: productos, hayMas: lista.length === 24 };\n    });\n}\nfunction resolverColeccionOriginal(){\n  var clave = 'shopcol:' + ORIGEN_TIENDA + RUTA_COLECCION;\n  return fetchConTimeout(ORIGEN_TIENDA + RUTA_COLECCION + '.json', 5000)\n    .then(function(r){ return r.json(); })\n    .then(function(d){\n      var id = (d && d.collection) ? String(d.collection.id) : '';\n      if (!id) return '';\n      function buscar(p){\n        return fetchConTimeout(ORIGEN_TIENDA + '/collections.json?limit=250&page=' + p, 5000).then(function(r){ return r.json(); }).then(function(j){\n          var lista = (j && j.collections) || [];\n          for (var i = 0; i < lista.length; i++) { if (String(lista[i].id) === id) return lista[i].handle; }\n          return (lista.length === 250 && p < 4) ? buscar(p + 1) : '';\n        });\n      }\n      return buscar(1);\n    })\n    .then(function(h){ if (h) { try { localStorage.setItem(clave, h); } catch(e) {} } return h; })\n    .catch(function(){ return ''; });\n}\nfunction pedirDirecto(){\n  if (!coleccionResuelta && RUTA_COLECCION) { try { var c = localStorage.getItem('shopcol:' + ORIGEN_TIENDA + RUTA_COLECCION); if (c) { URL_DIRECTA_SHOPIFY = ORIGEN_TIENDA + '/collections/' + c + '/products.json'; coleccionResuelta = true; } } catch(e) {} }\n  var primera = (paginaDirecta === 1);\n  return pedirDirectoBase().catch(function(){ return { productos: [], hayMas: false }; }).then(function(res){\n    if (res.productos.length || coleccionResuelta || !RUTA_COLECCION || !primera) return res;\n    coleccionResuelta = true;\n    return resolverColeccionOriginal().then(function(h){\n      if (!h) return res;\n      URL_DIRECTA_SHOPIFY = ORIGEN_TIENDA + '/collections/' + h + '/products.json';\n      paginaDirecta = 1;\n      return pedirDirectoBase();\n    });\n  });\n}\nfunction respaldoDirecto(err){\n  console.log(err);\n  if (modoDirecto && !yaPintado && !proxyUltimo) { modoDirecto = false; proxyUltimo = true; cargando = false; cargarProductos(); return; }\n  if (!URL_DIRECTA_SHOPIFY || yaPintado || modoDirecto || proxyUltimo || typeof cargarProductos !== 'function') { terminarSinMas(); return; }\n  modoDirecto = true; cargando = false; cargarProductos();\n}\nvar NAS_URL = 'https://carmenprofe.synology.me/generador_htmlrobots/generar_o_servir.php';\nvar GITHUB_PRODUCTOS = 'https://raw.githubusercontent.com/comercialyventas-spec/widget-abc/main/productos/producto-7d93d2a94d84b54a-p';\nfunction pedirGithub(pagina){\n  return fetchConTimeout(GITHUB_PRODUCTOS + pagina + '.json', 6000)\n    .then(function(r){ if (!r.ok) throw new Error('GitHub HTTP ' + r.status); return r.json(); })\n    .then(function(data){ if (data && data.productos && data.productos.length > 0) return data; throw new Error('GitHub sin productos'); });\n}\nfunction obtenerSoloNas(pagina){\n  return fetchConTimeout(NAS_URL + '?url=https%3A%2F%2Fador.com%2Fes%2Fcollections%2Fnovedades&pagina=' + pagina, 8000)\n    .then(function(r){ return r.json(); })\n    .then(function(data){ if (data && data.productos && data.productos.length > 0) return data; throw new Error('NAS sin productos'); })\n    .catch(function(){ return pedirGithub(pagina); });\n}\nfunction pedirProxySolo(pagina){\n  return fetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?url=https%3A%2F%2Fador.com%2Fes%2Fcollections%2Fnovedades&pagina=' + pagina).then(function(r){ return r.json(); });\n}\nfunction obtenerPagina(pagina){\n  return fetchConTimeout(NAS_URL + '?url=https%3A%2F%2Fador.com%2Fes%2Fcollections%2Fnovedades&pagina=' + pagina, 8000)\n    .then(function(r){ return r.json(); })\n    .then(function(data){\n      if (data && data.productos && data.productos.length > 0) return data;\n      return pedirGithub(pagina).catch(function(){ return fetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?url=https%3A%2F%2Fador.com%2Fes%2Fcollections%2Fnovedades&pagina=' + pagina).then(function(r){ return r.json(); }); });\n    })\n    .catch(function(){\n      return pedirGithub(pagina).catch(function(){ return fetch('https://script.google.com/macros/s/AKfycbxo5Q4FNyOpLE4qEDHgZVzdavmxZQMUhQmCak2RjWRNJqQI0uqxcqjgHp2y81mxznFg/exec?url=https%3A%2F%2Fador.com%2Fes%2Fcollections%2Fnovedades&pagina=' + pagina).then(function(r){ return r.json(); }); });\n    });\n}\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=ropaycomplementosaliazon&utm_medium=tarjeta_producto&utm_campaign=catalogo_ador';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' referrerpolicy=' + String.fromCharCode(34) + 'no-referrer' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\nvar hayMas = true;\nvar cola = false;\nvar paginaActual = 1;\nasync function cargarProductos(){\n  if(cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById('loader').style.display = 'block';\n  (modoDirecto ? pedirDirecto() : (proxyUltimo ? pedirProxySolo(paginaActual) : ((URL_DIRECTA_SHOPIFY && !yaPintado) ? obtenerSoloNas(paginaActual) : obtenerPagina(paginaActual))))\n    .then(async function(data){\n      if (!data || !data.productos || !data.productos.length) throw new Error('Sin productos');\n      document.getElementById('tienda-catalogo').innerHTML += data.productos.map(crearTarjeta).join('');\n      await traducirProductos(data.productos);\n      var tarjetas = document.getElementById('tienda-catalogo').querySelectorAll('.producto-card');\n      var offset = tarjetas.length - data.productos.length;\n      data.productos.forEach(function(p, i){ tarjetas[offset + i].outerHTML = crearTarjeta(p); });\n      hayMas = data.hayMas;\n      paginaActual++;\n      yaPintado = true;\n      if(!hayMas) document.getElementById('web-oficial-container').style.display = 'block';\n      document.getElementById('loader').style.display = 'none';\n      cargando = false;\n      if(cola){ cola = false; cargarProductos(); }\n    })\n    .catch(respaldoDirecto);\n}\n(function(f){ if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', f); else f(); })(function(){\n  cargarProductos();\n  var observer = new IntersectionObserver(function(entries){\n    if(entries[0].isIntersecting){ if(cargando){ cola=true; return; } cargarProductos(); }\n  }, {rootMargin:'250px'});\n  observer.observe(document.getElementById('sentinel'));\n});\n\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-09-30T19:10:31.852Z"
}