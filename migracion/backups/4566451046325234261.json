 "id": "4566451046325234261",
 "url": "https://periodicosaliazon.blogspot.com/2026/05/cargando-ultimas-noticias.html",
 "path": "/2026/05/cargando-ultimas-noticias.html",
 "titulo": "EMPRESAS COOKING SURFACE",
 "fila": 2422,
 "contenido": "<div id=\"cooking-news-widget\">\n  <div id=\"cooking-news-destacada\"></div>\n  <hr style=\"border: 0; border-top: 1px solid #ddd; margin: 30px 0;\">\n  <div id=\"cooking-news-lista\">Cargando últimas noticias...</div>\n</div>\n\n<style>\n  #cooking-news-widget { font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 800px; margin: auto; color: #333; }\n  #cooking-news-widget .cn-featured { text-align: center; margin-bottom: 40px; }\n  #cooking-news-widget .cn-img-featured { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; background: #f5f5f5; }\n  #cooking-news-widget .cn-title-featured { font-size: 28px; font-weight: 800; color: #111; text-decoration: none; line-height: 1.2; display: block; margin-bottom: 15px; }\n  #cooking-news-widget .cn-title-featured:hover { color: #8c7853; }\n  #cooking-news-widget .cn-item { display: flex; flex-direction: column; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 20px; }\n  #cooking-news-widget .cn-img-container { width: 100%; height: 200px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; background: #f5f5f5; }\n  #cooking-news-widget .cn-img-container img { width: 100%; height: 100%; object-fit: cover; }\n  #cooking-news-widget .cn-item-title { font-size: 19px; font-weight: 700; color: #1a1a1a; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 8px; }\n  #cooking-news-widget .cn-item-title:hover { color: #8c7853; }\n  #cooking-news-widget .cn-author { font-size: 12px; color: #888; margin-bottom: 8px; }\n  #cooking-news-widget .cn-meta { font-size: 11px; color: #aaa; text-transform: uppercase; margin-top: 5px; font-weight: bold; letter-spacing: 1px; }\n  @media (min-width: 600px) {\n    #cooking-news-widget .cn-item { flex-direction: row; gap: 20px; align-items: flex-start; }\n    #cooking-news-widget .cn-img-container { width: 180px; height: 110px; flex-shrink: 0; margin-bottom: 0; }\n  }\n</style>\n\n<script>\n(function() {\n  function cargarCookingNews() {\n    var rssUrl = \"https://www.cookingsurface.com/feed/\";\n    var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n    var url = proxy + \"?url=\" + encodeURIComponent(rssUrl);\n\n    fetch(url)\n      .then(function(res) { return res.text(); })\n      .then(function(text) {\n        var parser = new DOMParser();\n        var xmlDoc = parser.parseFromString(text, \"text/xml\");\n        var items = Array.from(xmlDoc.querySelectorAll(\"item\"));\n        \n        if (items.length === 0) throw new Error(\"Sin resultados\");\n        \n        var noticias = items.slice(0, 6).map(function(item) {\n          var title = item.querySelector(\"title\")?.textContent?.trim() || \"\";\n          var link = item.querySelector(\"link\")?.textContent?.trim() || \"\";\n          var pubDate = item.querySelector(\"pubDate\")?.textContent || \"\";\n          var author = item.querySelector(\"dc\\\\:creator\")?.textContent?.trim() || \"Cooking Surface\";\n          \n          var img = \"\";\n          \n          // 1. Intentar buscar en enclosure (estándar de imágenes en feeds)\n          var enclosure = item.querySelector(\"enclosure\");\n          if (enclosure && enclosure.getAttribute(\"type\")?.indexOf(\"image\") !== -1) {\n            img = enclosure.getAttribute(\"url\") || \"\";\n          }\n          \n          // 2. Intentar buscar mediante media:content o variantes de namespaces\n          if (!img) {\n            var mediaContent = item.querySelector(\"media\\\\:content\") || \n                               item.getElementsByTagNameNS(\"http://search.yahoo.com/mrss/\", \"content\")[0] ||\n                               item.querySelector(\"content\");\n            if (mediaContent) {\n              img = mediaContent.getAttribute(\"url\") || \"\";\n            }\n          }\n\n          // 3. Intentar buscar mediante media:thumbnail\n          if (!img) {\n            var mediaThumb = item.querySelector(\"media\\\\:thumbnail\") || \n                             item.getElementsByTagNameNS(\"http://search.yahoo.com/mrss/\", \"thumbnail\")[0];\n            if (mediaThumb) {\n              img = mediaThumb.getAttribute(\"url\") || \"\";\n            }\n          }\n          \n          // 4. Extraer del HTML interno de la descripción o contenido (Útil para WordPress en Blogger)\n          if (!img) {\n            var elContenido = \"\";\n            // Revisamos tanto content:encoded como description\n            var contentEncoded = item.getElementsByTagNameNS(\"http://purl.org/rss/1.0/modules/content/\", \"encoded\")[0];\n            if (contentEncoded) {\n              elContenido = contentEncoded.textContent;\n            } else {\n              elContenido = item.querySelector(\"description\")?.textContent || \"\";\n            }\n            \n            if (elContenido) {\n              var srcMatch = elContenido.match(/src=[\"']([^\"']+\\.(?:jpg|jpeg|png|gif|webp)(?:\\?[^\"']*)?)[\"']/i);\n              if (srcMatch && srcMatch[1]) {\n                img = srcMatch[1];\n              }\n            }\n          }\n          \n          return { title: title, link: link, pubDate: pubDate, author: author, img: img };\n        }).filter(function(n) { return n.title; });\n\n        function renderizar() {\n          var destacadoHtml = \"\";\n          var listaHtml = \"\";\n\n          noticias.forEach(function(noticia, index) {\n            var fecha = new Date(noticia.pubDate).toLocaleDateString('es-ES',\n              { day: '2-digit', month: 'short', year: 'numeric' });\n\n            // Si el feed no traía ninguna imagen, se usa una por defecto elegante y neutra para que no quede el hueco roto\n            var imagenUrl = noticia.img || \"https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=500&q=80\";\n\n            if (index === 0) {\n              destacadoHtml =\n                '<div class=\"cn-featured\">' +\n                '<a href=\"' + noticia.link + '\" target=\"_blank\"><img src=\"' + imagenUrl + '\" class=\"cn-img-featured\" alt=\"' + noticia.title + '\"></a>' +\n                '<a class=\"cn-title-featured\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"cn-author\">Por ' + noticia.author + '</div>' +\n                '<div class=\"cn-meta\">COOKING SURFACE · ' + fecha + '</div>' +\n                '</div>';\n            } else {\n              listaHtml +=\n                '<div class=\"cn-item\">' +\n                '<div class=\"cn-img-container\"><a href=\"' + noticia.link + '\" target=\"_blank\"><img src=\"' + imagenUrl + '\" alt=\"' + noticia.title + '\"></a></div>' +\n                '<div>' +\n                '<a class=\"cn-item-title\" href=\"' + noticia.link + '\" target=\"_blank\">' + noticia.title + '</a>' +\n                '<div class=\"cn-author\">Por ' + noticia.author + '</div>' +\n                '<div class=\"cn-meta\">' + fecha + '</div>' +\n                '</div>' +\n                '</div>';\n            }\n          });\n\n          document.getElementById(\"cooking-news-destacada\").innerHTML = destacadoHtml;\n          document.getElementById(\"cooking-news-lista\").innerHTML = listaHtml;\n        }\n\n        renderizar();\n\n      })\n      .catch(function() {\n        document.getElementById(\"cooking-news-widget\").innerHTML =\n          \"<p style='color:red; text-align:center;'>Error al cargar las noticias de Cooking Surface.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarCookingNews);\n  } else {\n    cargarCookingNews();\n  }\n})();\n</script>",
 "fecha_copia": "2026-09-26T15:40:04.463Z"
}