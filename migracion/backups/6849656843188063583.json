 "titulo": "PROTECCIÓN SOLAR LABIAL",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://encrypted-tbn2.gstatic.com/images?q=tbn:ANd9GcR_GZC32IZM_1VAgVumRr3n_Hr53kpZ1lDXb3nbpE9qZGpfmg\" style=\"display: block; padding: 1em 0px; text-align: center;\"><img alt=\"\" border=\"0\" height=\"320\" src=\"https://encrypted-tbn2.gstatic.com/images?q=tbn:ANd9GcR_GZC32IZM_1VAgVumRr3n_Hr53kpZ1lDXb3nbpE9qZGpfmg\" /></a></div>\n\n<div style=\"text-align: justify;\">La sección de labiales de Botica3 reúne una amplia variedad de bálsamos, sticks y tratamientos para hidratar, proteger y reparar los labios. Incluye productos de marcas reconocidas como Letibalm, Avène, ISDIN, Eucerin, Bioderma y Uriage, con opciones para labios secos, agrietados o expuestos al frío y al sol. Es una selección enfocada en el cuidado labial, con alternativas para uso diario y necesidades específicas, a precios competitivos.</div>\n\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">Cargando productos, por favor espera...</div>\n\n<div id=\"web-oficial-container\" style=\"display: none; margin-top: 30px; padding: 20px 0px 40px; text-align: center;\">\n  <a href=\"https://botica3.es/?utm_source=farmaciaaliazon&utm_medium=boton_oficial&utm_campaign=catalogo_botica3\" rel=\"nofollow\" style=\"background: rgb(17, 17, 17); border-radius: 6px; color: white; display: inline-block; font-family: Helvetica Neue, sans-serif; font-size: 14px; font-weight: bold; letter-spacing: 1px; padding: 14px 36px; text-decoration: none; text-transform: uppercase;\" target=\"_blank\">Ir a la web oficial</a>\n</div>\n\n<style>\n#tienda-catalogo{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;font-family:Arial;}\n.producto-card{border:1px solid #eaeaea;padding:15px;border-radius:10px;text-align:center;background:#fff;}\n.producto-card img{width:100%;height:200px;object-fit:cover;border-radius:8px;}\n.producto-title{font-size:14px;margin:10px 0;font-weight:600;}\n.producto-desc{font-size:12px;color:#666;margin:5px 0;}\n.producto-precio{font-size:16px;font-weight:bold;color:#111;margin:8px 0;}\n.producto-link{display:block;background:#111;color:#fff;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;margin-bottom:6px;}\n.producto-club{display:block;background:#e8f0fe;color:#1a73e8;padding:10px;text-decoration:none;border-radius:6px;font-size:12px;font-weight:bold;border:1px solid #1a73e8;}\n</style>\n\n<script>\nvar cargando = false;\nvar FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeWdB-lcCJ-K0nsBV6WqB-GZ2ZvA9KkTd798_4n1dmBh1tngA/viewform?usp=pp_url&entry.182236341=';\nvar PROXY_TRANSLATE = 'https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec';\nasync function traducir(texto) {\n  if (!texto) return '';\n  try {\n    var tUrl = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&q=' + encodeURIComponent(texto);\n    var res = await fetch(PROXY_TRANSLATE + '?url=' + encodeURIComponent(tUrl));\n    var raw = await res.text();\n    var data = JSON.parse(raw);\n    return data[0].map(function(p){ return p[0]; }).join('');\n  } catch(e) { return texto; }\n}\nasync function traducirProductos(productos) {\n  await Promise.all(productos.map(async function(p) {\n    var r = await Promise.all([traducir(p.titulo), traducir(p.descripcion || '')]);\n    p.titulo = r[0];\n    if (p.descripcion) p.descripcion = r[1];\n  }));\n}\nfunction crearTarjeta(p){\n  var sep = p.url.indexOf('?') !== -1 ? '&' : '?';\n  var utm = sep + 'utm_source=farmaciaaliazon&utm_medium=tarjeta_producto&utm_campaign=catalogo_botica3';\n  var urlConUtm = p.url + utm;\n  var urlClic = 'https://script.google.com/macros/s/AKfycbymjaZZpelLTpLoZ5t19Y_ppTRW0JH_qbOLxhUHANIH4Yk_OWzCkoXefdSRcQw3qRyu0Q/exec?producto=' + encodeURIComponent(p.titulo) + '&url=' + encodeURIComponent(p.url);\n  var urlForm = FORM_URL + encodeURIComponent(p.titulo);\n  var h = '<div class=' + String.fromCharCode(34) + 'producto-card' + String.fromCharCode(34) + '>';\n  if(p.imagen) h += '<img src=' + String.fromCharCode(34) + p.imagen + String.fromCharCode(34) + ' loading=' + String.fromCharCode(34) + 'lazy' + String.fromCharCode(34) + ' alt=' + String.fromCharCode(34) + p.titulo + String.fromCharCode(34) + '>';\n  h += '<div class=' + String.fromCharCode(34) + 'producto-title' + String.fromCharCode(34) + '>' + p.titulo + '</div>';\n  if(p.descripcion) h += '<div class=' + String.fromCharCode(34) + 'producto-desc' + String.fromCharCode(34) + '>' + p.descripcion + '</div>';\n  if(p.precio) h += '<div class=' + String.fromCharCode(34) + 'producto-precio' + String.fromCharCode(34) + '>' + p.precio + '</div>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-link' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlConUtm + String.fromCharCode(34) + ' rel=' + String.fromCharCode(34) + 'nofollow' + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + ' onclick=' + String.fromCharCode(34) + 'fetch(' + String.fromCharCode(39) + urlClic + String.fromCharCode(39) + ',{mode:' + String.fromCharCode(39) + 'no-cors' + String.fromCharCode(39) + '})' + String.fromCharCode(34) + '>Comprar ahora</a>';\n  h += '<a class=' + String.fromCharCode(34) + 'producto-club' + String.fromCharCode(34) + ' href=' + String.fromCharCode(34) + urlForm + String.fromCharCode(34) + ' target=' + String.fromCharCode(34) + '_blank' + String.fromCharCode(34) + '>Unirme al Club de Ahorro</a>';\n  h += '</div>';\n  return h;\n}\nvar hayMas = true;\nvar cola = false;\nvar paginaActual = 1;\nasync function cargarProductos(){\n  if(cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById('loader').style.display = 'block';\n  fetch('https://script.google.com/macros/s/AKfycbwsYCjU9ddQD1d7FmqJKv2tsGJ05SdvbC-VBkBXr046mbTpoqaND9lCT6gSoMIlJ8YuSw/exec?url=https%3A%2F%2Fbotica3.es%2F1262-labial&pagina=' + paginaActual)\n    .then(function(r){ return r.json(); })\n    .then(async function(data){\n      document.getElementById('tienda-catalogo').innerHTML += data.productos.map(crearTarjeta).join('');\n      await traducirProductos(data.productos);\n      var tarjetas = document.getElementById('tienda-catalogo').querySelectorAll('.producto-card');\n      var offset = tarjetas.length - data.productos.length;\n      data.productos.forEach(function(p, i){ tarjetas[offset + i].outerHTML = crearTarjeta(p); });\n      hayMas = data.hayMas;\n      paginaActual++;\n      if(!hayMas) document.getElementById('web-oficial-container').style.display = 'block';\n      document.getElementById('loader').style.display = 'none';\n      cargando = false;\n      if(cola){ cola = false; cargarProductos(); }\n    })\n    .catch(function(err){ console.log(err); cargando = false; });\n}\ndocument.addEventListener('DOMContentLoaded', function(){\n  cargarProductos();\n  var observer = new IntersectionObserver(function(entries){\n    if(entries[0].isIntersecting){ if(cargando){ cola=true; return; } cargarProductos(); }\n  }, {rootMargin:'250px'});\n  observer.observe(document.getElementById('sentinel'));\n});\n\n</script>\n\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL ARTÍCULO ESTÁ AGOTADO O NO REALIZAN ENVÍOS A TU DESTINO, CONTÁCTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-10-03T16:12:29.291Z"
}