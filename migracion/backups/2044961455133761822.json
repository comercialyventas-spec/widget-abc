 "url": "https://ropaycomplementosaliazon.blogspot.com/2026/05/chernimcherno.html",
 "path": "/2026/05/chernimcherno.html",
 "titulo": "CHERNIMCHERNO",
 "fila": null,
 "contenido": "<div class=\"separator\" style=\"clear: both;\"><a href=\"https://chernimcherno.com/\" target=\"_blank\" style=\"display: block; padding: 1em 0; text-align: center; \"><img alt=\"Chernim Cherno\" border=\"0\" width=\"320\" referrerpolicy=\"no-referrer\" src=\"https://cdn.insales-shop.ru/assets/1/6025/11523977/1789733641/cc_banner1.jpg\"/></a></div>CHERNIM CHERNO — Firma rusa de moda masculina conceptual. Destaca por un patronaje impecable, siluetas limpias y una gran atención al detalle en camisas, pantalones, prendas de punto y accesorios. Su estilo mezcla minimalismo y carácter, con colecciones cortas y una imagen de marca muy cuidada, pensada para hombres que buscan prendas diferentes a las de las grandes cadenas.\n<div id=\"tienda-catalogo\"></div>\n<div id=\"sentinel\" style=\"height: 1px;\"></div>\n<div id=\"loader\" style=\"display: none; padding: 15px; text-align: center;\">\n  ⏳ Espera unos segundos, cargando productos...\n</div>\n<style>\n#tienda-catalogo { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; font-family: Arial, sans-serif; }\n.producto-card { border: 1px solid #eaeaea; padding: 15px; border-radius: 10px; text-align: center; background: #fff; }\n.producto-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }\n.producto-title { font-size: 14px; margin: 10px 0; font-weight: 600; }\n.producto-precio { font-size: 16px; font-weight: bold; color: #111; margin: 8px 0; }\n.producto-link { display: block; background: #111; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: bold; }\n.producto-link:hover { background: #333; }\n</style>\n<script>\n(function(){\n// Capa 1: NAS insales_store.php (catalogo real de la tienda InSales: nombres traducidos al espanol,\n//         precio en rublos con su equivalente en euros, solo en stock; cache 3 h).\n// Capa 2: el Apps Script de siempre, solo si el NAS no da nada.\nvar TIENDA_URL = \"https://chernimcherno.com\";\nvar NAS_INSALES = \"https://carmenprofe.synology.me/generador_htmlrobots/insales_store.php\";\nvar APPS_SCRIPT = \"https://script.google.com/macros/s/AKfycbxa_UqeA9VYkB0ARWi12nfJTQR3RJ5JzsZwwZPUl5l7kY_sAdaqX79pg8wh093rNM_b2w/exec\";\nvar fuente = \"nas\";          // pasa a \"proxy\" si el NAS no devuelve nada\nvar paginaActual = 1, cargando = false, hayMas = true, cola = false, pintados = 0;\n\nwindow.ocultarTarjeta = function(img) {\n  // Primero se intenta la foto directa (sin referencia); si tampoco carga, se oculta la tarjeta\n  if (!img.getAttribute(\"data-directa\")) {\n    img.setAttribute(\"data-directa\", \"1\");\n    var orig = img.getAttribute(\"data-orig\");\n    if (orig) { img.referrerPolicy = \"no-referrer\"; img.src = orig; return; }\n  }\n  var card = img.closest(\".producto-card\");\n  if (card) card.style.display = \"none\";\n};\nwindow.registrarClic = window.registrarClic || function(titulo, url, tienda) {\n  try {\n    fetch(APPS_SCRIPT, { method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ tienda: tienda, titulo: titulo, url: url }), mode: \"no-cors\", keepalive: true });\n  } catch (e) {}\n};\n\nfunction esc(t){ return String(t || \"\").replace(/\"/g, \"&quot;\"); }\nfunction crearTarjeta(p) {\n  if (!p.imagen) return \"\";\n  var imgUrl = \"https://images.weserv.nl/?url=\" + encodeURIComponent(p.imagen) + \"&w=400&output=webp\";\n  var titulo = String(p.titulo || \"\");\n  var tJs = titulo.replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\").replace(/\"/g, \"&quot;\");\n  var h = '<div class=\"producto-card\">'\n    + '<img src=\"' + imgUrl + '\" data-orig=\"' + esc(p.imagen) + '\" loading=\"lazy\" alt=\"' + esc(titulo) + '\" onerror=\"ocultarTarjeta(this)\">'\n    + '<div class=\"producto-title\">' + titulo + '</div>';\n  if (p.precio) h += '<div class=\"producto-precio\">' + (p.precio_antes ? '<s style=\"color:#999;font-weight:normal;font-size:13px;margin-right:6px\">' + p.precio_antes + '</s>' : '') + p.precio + '</div>';\n  h += '<a class=\"producto-link\" href=\"' + esc(p.url) + '\" target=\"_blank\" rel=\"nofollow\"'\n    + ' onclick=\"registrarClic(\\'' + tJs + '\\',\\'' + esc(p.url) + '\\',\\'' + TIENDA_URL + '\\')\">Ver producto</a>'\n    + '</div>';\n  return h;\n}\n\nfunction fetchConTiempo(url, ms){\n  var ctrl = new AbortController();\n  var t = setTimeout(function(){ ctrl.abort(); }, ms);\n  return fetch(url, { signal: ctrl.signal }).then(function(r){ clearTimeout(t); if (!r.ok) throw new Error(r.status); return r.json(); });\n}\nfunction pedirPagina(n){\n  if (fuente === \"nas\") return fetchConTiempo(NAS_INSALES + \"?url=\" + encodeURIComponent(TIENDA_URL) + \"&pagina=\" + n, 30000);\n  return fetchConTiempo(APPS_SCRIPT + \"?tienda=\" + encodeURIComponent(TIENDA_URL) + \"&pagina=\" + n, 30000);\n}\n\n// Si el NAS no ha podido traducir algun nombre (sale en ruso), se traduce aqui en el navegador\n// y se guarda en este navegador para no repetirlo.\nvar CIRILICO = /[\\u0400-\\u04FF]/;\nfunction leerTrad(){ try { return JSON.parse(localStorage.getItem(\"chernim_trad\") || \"{}\"); } catch (e) { return {}; } }\nfunction guardarTrad(m){ try { localStorage.setItem(\"chernim_trad\", JSON.stringify(m)); } catch (e) {} }\nasync function traducirLista(lista) {\n  var mapa = leerTrad(), pend = [];\n  lista.forEach(function(p){ var t = String(p.titulo || \"\"); if (CIRILICO.test(t) && !mapa[t] && pend.indexOf(t) < 0) pend.push(t); });\n  for (var i = 0; i < pend.length; i += 20) {\n    var grupo = pend.slice(i, i + 20);\n    try {\n      var r = await fetch(\"https://translate.googleapis.com/translate_a/single?client=gtx&sl=ru&tl=es&dt=t\",\n        { method: \"POST\", body: new URLSearchParams({ q: grupo.map(function(t){ return t.replace(/\\n/g, \" \"); }).join(\"\\n\") }) });\n      var j = await r.json();\n      var lineas = (j[0] || []).map(function(sg){ return sg[0] || \"\"; }).join(\"\").split(\"\\n\");\n      if (lineas.length === grupo.length) grupo.forEach(function(t, k){ if (lineas[k].trim()) mapa[t] = lineas[k].trim(); });\n    } catch (e) { break; }\n  }\n  guardarTrad(mapa);\n  lista.forEach(function(p){ if (mapa[p.titulo]) p.titulo = mapa[p.titulo]; });\n}\n\nasync function cargarProductos() {\n  if (cargando || !hayMas) return;\n  cargando = true;\n  document.getElementById(\"loader\").style.display = \"block\";\n  try {\n    var data = await pedirPagina(paginaActual);\n    var lista = (data && data.productos) || [];\n    if (!lista.length && fuente === \"nas\" && paginaActual === 1) {\n      fuente = \"proxy\";                       // el NAS no dio nada: se prueba la via antigua\n      data = await pedirPagina(1);\n      lista = (data && data.productos) || [];\n    }\n    if (lista.some(function(p){ return CIRILICO.test(String(p.titulo || \"\")); })) await traducirLista(lista);\n    var cont = document.getElementById(\"tienda-catalogo\");\n    cont.insertAdjacentHTML(\"beforeend\", lista.map(crearTarjeta).join(\"\"));\n    pintados += lista.length;\n    hayMas = !!data.hayMas && lista.length > 0;\n    paginaActual++;\n  } catch (e) { console.log(e); hayMas = false; }\n  document.getElementById(\"loader\").style.display = \"none\";\n  cargando = false;\n  if (cola) { cola = false; cargarProductos(); }\n}\n\nfunction arrancar() {\n  cargarProductos();\n  var sentinel = document.getElementById(\"sentinel\");\n  if (\"IntersectionObserver\" in window) {\n    new IntersectionObserver(function(entries) {\n      if (entries[0].isIntersecting) { if (cargando) { cola = true; return; } cargarProductos(); }\n    }, { rootMargin: \"800px\" }).observe(sentinel);\n  }\n}\nif (document.readyState === \"loading\") document.addEventListener(\"DOMContentLoaded\", arrancar); else arrancar();\n})();\n</script>\n<div><br /></div>\n<a href=\"https://chernimcherno.com\" target=\"_blank\"><b>IR A LA WEB OFICIAL </b></a>\n<div><br /></div>\n<div><span style=\"font-size: medium;\">SI EL PRODUCTO ESTA AGOTADO O NO ENVIAN A TU DESTINO CONTACTANOS: <a href=\"mailto:comercialyventas@gmail.com\">comercialyventas@gmail.com</a></span></div>",
 "fecha_copia": "2026-09-30T19:10:23.710Z"
}