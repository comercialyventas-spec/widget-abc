   "contenido": "<div id=\"azz-widget\">\n  <div id=\"azz-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; font-family: 'Segoe UI', Roboto, Arial, sans-serif; max-width: 1000px; margin: auto; color: #333;\">\n    <p style=\"grid-column: 1/-1; text-align: center; color: #999;\">Cargando hoteles AZZ...</p>\n  </div>\n</div>\n\n<style>\n  #azz-widget .azz-card { border: 1px solid #eaeaea; border-radius: 10px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }\n  #azz-widget .azz-card img { width: 100%; height: 200px; object-fit: cover; }\n  #azz-widget .azz-card-body { padding: 18px; display: flex; flex-direction: column; flex: 1; }\n  #azz-widget .azz-card h3 { font-size: 17px; font-weight: 700; color: #111; margin-bottom: 8px; }\n  #azz-widget .azz-card p { font-size: 13px; color: #666; line-height: 1.5; margin-bottom: 10px; }\n  #azz-widget .azz-card .azz-btn { display: block; background: #a68a4e; color: #fff; padding: 10px; text-decoration: none; border-radius: 6px; font-size: 13px; font-weight: bold; text-align: center; margin-top: auto; }\n  #azz-widget .azz-card .azz-btn:hover { background: #8b7539; }\n</style>\n\n<script>\n(function() {\n  var proxy = \"https://script.google.com/macros/s/AKfycbzeMKVUzOXYNngx1d8OMhEF6ebsFmfXa8Iyd9ZOgpBoX4zqvs93rMJuortAtPxnu-2v/exec\";\n  var PAGE_URL = \"https://www.azzhoteles.com/es/azz-guadacorte/habitaciones/\";\n  var TRACKER_URL = \"https://script.google.com/macros/s/AKfycbxGZQXtlUkyzc4C2BIqq0DF-4UdPTOl57HM-0WhTzOFuHyWDDKBjmb0p2uUCugVy3Y8/exec\";\n\n  function cargarAZZ() {\n    fetch(proxy + \"?url=\" + encodeURIComponent(PAGE_URL))\n      .then(function(res) { return res.text(); })\n      .then(function(html) {\n        var jsonMatch = html.match(/const BANNERS = (\\[[\\s\\S]*?\\]);/);\n        if (!jsonMatch) {\n          document.getElementById(\"azz-grid\").innerHTML =\n            \"<p style='grid-column: 1/-1; text-align: center; color: #666;'>No se encontraron hoteles.</p>\";\n          return;\n        }\n\n        var banners = JSON.parse(jsonMatch[1]);\n        \n       var hoteles = banners.filter(function(b) {\n  return b.image && b.image.file && b.title &&\n         b.title.trim() !== \"\" &&\n         (b.title.includes(\"AZZ\") || b.title.includes(\"Hotel\") || b.title.includes(\"SPA\") || b.title.includes(\"PAQUETE\") || b.title.includes(\"BONO\"));\n}).slice(0, 9);\n\n        if (hoteles.length === 0) {\n          document.getElementById(\"azz-grid\").innerHTML =\n            \"<p style='grid-column: 1/-1; text-align: center; color: #666;'>No se encontraron hoteles.</p>\";\n          return;\n        }\n\n        var htmlOut = \"\";\n        hoteles.forEach(function(h) {\n          var img = \"https://www.azzhoteles.com/files-sbbasic/gr_azz_hoteles/\" + h.image.file;\n          var titulo = h.title.replace(/\\n/g, \"\").trim();\n          var desc = h.body ? h.body.replace(/\\n/g, \"\").trim() : \"\";\n          var link = h.link.startsWith(\"http\") ? h.link : \"https://www.azzhoteles.com\" + h.link;\n          \n          htmlOut +=\n            '<div class=\"azz-card\">' +\n            '<img src=\"' + img + '\" alt=\"' + titulo + '\" loading=\"lazy\">' +\n            '<div class=\"azz-card-body\">' +\n            '<h3>' + titulo + '</h3>' +\n            (desc ? '<p>' + desc + '</p>' : '') +\n            '<a class=\"azz-btn\" href=\"' + TRACKER_URL + '?hotel=' + encodeURIComponent(titulo) + '&url=' + encodeURIComponent(link) + '\" target=\"_blank\">🏨 RESERVAR EN LA WEB OFICIAL</a>' +\n            '</div>' +\n            '</div>';\n        });\n\n        htmlOut +=\n          '<div style=\"grid-column: 1/-1; text-align: center; padding: 20px;\">' +\n          '<a href=\"https://reservadehoteles.blogspot.com/\" target=\"_blank\" style=\"display: inline-block; background: #a68a4e; color: #fff; padding: 14px 35px; text-decoration: none; border-radius: 8px; font-size: 15px; font-weight: bold;\">🏨 MÁS RESEÑAS DE HOTELES</a>' +\n          '</div>';\n\n        document.getElementById(\"azz-grid\").innerHTML = htmlOut;\n      })\n      .catch(function() {\n        document.getElementById(\"azz-grid\").innerHTML =\n          \"<p style='grid-column: 1/-1; text-align: center; color: red;'>Error al cargar.</p>\";\n      });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", cargarAZZ);\n  } else {\n    cargarAZZ();\n  }\n})();\n</script>"
  }
