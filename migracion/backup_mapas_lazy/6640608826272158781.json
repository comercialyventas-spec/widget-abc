ant; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nRestaurante/ comedor</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420120005344333.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420120005344333.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nBar</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420120011203805.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420120011203805.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nHabitación doble</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420120016219585.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420120016219585.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nCuarto de baño</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420121541306692.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420121541306692.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nHabitación doble</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420121542128226.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420121542128226.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nHabitación estándar</div>\n</div>\n</div>\n<div style=\"float: left; height: 220px; margin: 5px 5px 0px 0px; padding: 0px; width: 195px;\">\n<div class=\"img\" style=\"border: 2px solid rgb(220, 220, 220); float: left; margin: 0px; padding: 10px; width: 160px;\">\n<a class=\"zoom-element\" href=\"http://static.laterooms.com/hotelphotos/laterooms/260529/gallery/hotel-alain-silla_240420121543108732.jpg\" style=\"color: #411485; font-weight: bold; margin: 0px; padding: 0px;\"><img src=\"http://static.laterooms.com/hotelphotos/laterooms/260529/detail/hotel-alain-silla_240420121543108732.jpg\" style=\"border: 0px; margin: 0px !important; padding: 0px;\" /></a><br />\n<div style=\"font-size: 12px; padding: 5px 5px 0px 0px; text-align: justify;\">\n<br /></div>\n<div class=\"tags\" style=\"font-size: 11px; margin: 0px; max-height: 55px; overflow: hidden; padding: 5px 0px 0px;\">\nHabitación familiar</div>\n</div>\n</div>\n<div class=\"sp cl\" style=\"clear: both; height: 0px; margin: 0px; overflow: hidden; padding: 0px;\">\n</div>\n</div>\n<div class=\"sp cl\" style=\"clear: both; height: 0px; margin: 0px; overflow: hidden; padding: 0px;\">\n</div>\n</div>\n<div class=\"divide\" style=\"background-color: white; border-top-color: rgb(204, 204, 204); border-top-style: dashed; border-top-width: 1px; color: #333333; font-family: Arial, sans-serif; font-size: 12px; height: 0px; margin: 9px 10px 10px; padding: 0px;\">\n<br /></div>\n<br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">Somos un hotel de 2 estrellas con ambiente familiar y agradable situado en la localidad de Silla, en Valencia.</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En Hotel Alain todas nuestras habitaciones disponen de cuarto de baño, televisión y aire acondicionado (frío-calor).</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">Nuestro Hotel Alain consta de 2 estrellas y posee un ambiente familiar. Está situado en Silla, a 12 km de Valencia y a 15 km del aeropuerto, con excelente comunicación (AP7,N-332,N-340, etc.) y rápido acceso desde cualquier punto del territorio nacional.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En la misma puerta del Hotel Alain dispone de parada de autobús y a 10 minutos la estación de RENFE con parada en la Estación del Norte (centro de Valencia) y otras direcciones como Xàtiva, Gandia, Cullera (salidas cada diez minutos).</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En la localidad de Silla podrá visitar distintos monumentos como la torre musulmana, la iglesia parroquial de Nuestra Señora de los Ángeles (del año 1764), el puerto de Silla con acceso a la ALBUFERA y pasear por el parque, disfrutando de su entorno.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">También podrán disfrutar los jueves y sábados del mercadillo, una actividad de lo más recomendable.</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">A 10 km podrán visitar la ciudad de Valencia y sus emblemáticos monumentos:Torres de Quart.,Torres de Serrano,La Ciudad de lar Artes y las Ciencias,El Biopark,El Oceanografic,La Albufera y un largo etcétera.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">A 300 metros disponen de piscina climatizada y gimnasio.</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En los alrededores encontrarán gran variedad de playas, a 15 km está la playa del Saler y a 25 km la playa de Cullera.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En la localidad de Silla se celebran las fiestas patronales a principios de agosto y duran hasta el día 15 del mismo mes.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">Dentro de las fiestas contamos con distintas celebraciones como son verbenas, toros, vaquillas, cine de verano, castillos de fuegos artificiales, actuaciones de artistas consagrados y la popular y afamada CARXOFA DE SILLA.</span><br />\n<br style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px; margin: 0px; padding: 0px;\" />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">En el mes de enero celebramos la fiesta a nuestro patrón San Sebastián y en el mes de marzo las populares FALLAS.</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">Todas estas celebraciones dotan a la zona de una multitud de actividades, que hacen que pasar unos días en nuestra localidad, le hagan volver otro año&nbsp;</span><br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\">A 2 km disponen de un centro comercial y de ocio en el cual podrá realizar diferentes actividades como ir de compras, al cine o jugar a la bolera, entre otras muchas.</span><br />\n<br />\n<div class=\"bloque01-contenido  salta\" style=\"background-color: white; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; border-top-left-radius: 3px; border-top-right-radius: 3px; color: #333333; font-family: arial, helvetica, sans-serif; font-size: 11px; margin-top: 15px; padding: 10px;\">\n<div class=\"txt_12_orange\" style=\"color: #e86b1b; font-size: 12px;\">\n<b>Servicios standard de habitación</b><br />\n<br />\n<ul style=\"margin: 0px; padding: 0px;\">\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Aire Acondicionado,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Calefacción,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Teléfono,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Televisión</li>\n</ul>\n</div>\n<div style=\"clear: left; color: black; font-size: 11px;\">\n</div>\n</div>\n<div class=\"bloque01-contenido salta\" style=\"background-color: white; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; border-top-left-radius: 3px; border-top-right-radius: 3px; color: #333333; font-family: arial, helvetica, sans-serif; font-size: 11px; margin-top: 15px; padding: 10px;\">\n<div class=\"txt_12_orange\" style=\"color: #e86b1b; font-size: 12px;\">\n<b>Instalaciones del Alojamiento&nbsp;</b><br />\n<br />\n<ul style=\"margin: 0px; padding: 0px;\">\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Ascensor,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Bar/Cafetería,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Garaje,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Acceso&nbsp;Minusválidos,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Parking,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Restaurante,&nbsp;</li>\n<li class=\"txt_12_grey fleft\" style=\"color: #333333; float: left; font-size: 12px; list-style: none; padding: 0px;\">Admite&nbsp;Tarjetas&nbsp;de&nbsp;Crédito</li>\n<div>\n<br /></div>\n</ul>\n</div>\n</div>\n<br />\n<span style=\"background-color: white; color: #333333; font-family: Arial, sans-serif; font-size: 12px; line-height: 16.78333282470703px;\"><br /></span>\nPUEDE VER LOS ALREDEDORES DEL ALOJAMIENTO MOVIENDOSE POR LA IMAGEN \n<br />\n<iframe loading=\"lazy\" frameborder=\"0\" height=\"350\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" src=\"https://maps.google.com/maps?f=q&amp;source=embed&amp;hl=es&amp;geocode=&amp;q=+SILLA+VALENCIA&amp;aq=&amp;sll=39.416403,-0.396452&amp;sspn=0.018533,0.042272&amp;ie=UTF8&amp;hq=&amp;hnear=Silla,+Valencia,+Comunidad+Valenciana,+Espa%C3%B1a&amp;ll=39.363992,-0.410162&amp;spn=0.008876,0.021136&amp;t=m&amp;z=14&amp;layer=c&amp;cbll=39.361972,-0.408128&amp;panoid=n_RBlEyQF5ZPnPXT4uPU0w&amp;cbp=12,241.49,,0,-22.5&amp;output=svembed\" width=\"425\"></iframe><br />\n<small><a href=\"https://maps.google.com/maps?f=q&amp;source=embed&amp;hl=es&amp;geocode=&amp;q=+SILLA+VALENCIA&amp;aq=&amp;sll=39.416403,-0.396452&amp;sspn=0.018533,0.042272&amp;ie=UTF8&amp;hq=&amp;hnear=Silla,+Valencia,+Comunidad+Valenciana,+Espa%C3%B1a&amp;ll=39.363992,-0.410162&amp;spn=0.008876,0.021136&amp;t=m&amp;z=14&amp;layer=c&amp;cbll=39.361972,-0.408128&amp;panoid=n_RBlEyQF5ZPnPXT4uPU0w&amp;cbp=12,241.49,,0,-22.5\" style=\"color: blue; text-align: left;\">Ver mapa más grande</a></small><br />\n(Para moverse por la imagen se necesita Adobe Flash Player, versión 10 o posterior o navegador Google Chrome)"
